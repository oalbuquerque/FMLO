@prefix : <http://www.usp.br/fmlo#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix fmo: <https://purl.org/twc/fmo#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix fmlo: <http://www.usp.br/fmlo#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix swrla: <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#> .
@prefix swrlb: <http://www.w3.org/2003/11/swrlb#> .
@prefix terms: <http://purl.org/dc/terms/> .
@base <http://www.usp.br/fmlo#> .

<http://www.usp.br/fmlo> rdf:type owl:Ontology ;
                          terms:abstract "An ontology for fairness in machine learning that organizes bias sources, sensitive attributes, sociotechnical solutions, fairness notions, fairness criteria, and fairness metrics across the ML lifecycle."@en ;
                          terms:contributor "Marcelo Fantinato" ,
                                            "Sarajane Marques Peres" ;
                          terms:creator "Otavio de Paula Albuquerque" ;
                          rdfs:label "Fairness in Machine Learning Ontology"@en ,
                                     "Ontologia de Fairness em Aprendizado de Máquina"@pt ;
                          owl:versionInfo "1.0.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/contributor
dc:contributor rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/identifier
dc:identifier rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/license
dc:license rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/abstract
terms:abstract rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/contributor
terms:contributor rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
terms:creator rdf:type owl:AnnotationProperty .


###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
swrla:isRuleEnabled rdf:type owl:AnnotationProperty .


###  http://www.usp.br/fmlo#mathematical_definition
fmlo:mathematical_definition rdf:type owl:AnnotationProperty ;
                             rdfs:label "mathematical definition"@en ;
                             skos:definition "Formal definition using an expanded mathematical equation"@en .


###  http://www.usp.br/fmlo#probabilistic_definition
fmlo:probabilistic_definition rdf:type owl:AnnotationProperty ;
                              rdfs:label "probabilistic definition"@en ;
                              skos:definition "Formal definition using a probabilistic or independence expression"@en .


###  http://www.w3.org/2004/02/skos/core#altLabel
skos:altLabel rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#broader
skos:broader rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#closeMatch
skos:closeMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#exactMatch
skos:exactMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#example
skos:example rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.usp.br/fmlo#addressesBiasType
fmlo:addressesBiasType rdf:type owl:ObjectProperty ;
                       owl:inverseOf fmlo:isAddressedByNotion ;
                       rdf:type owl:IrreflexiveProperty ;
                       rdfs:domain fmlo:FairnessNotion ;
                       rdfs:range fmlo:BiasSource ;
                       rdfs:label "addressesBiasType"@en ;
                       skos:altLabel "endereça tipo de viés"@pt ;
                       skos:definition "Which bias source type a fairness notion is designed to detect"@en .


###  http://www.usp.br/fmlo#addressesTask
fmlo:addressesTask rdf:type owl:ObjectProperty ;
                   owl:inverseOf fmlo:isAddressedBySolution ;
                   rdf:type owl:IrreflexiveProperty ;
                   rdfs:domain fmlo:SocioTechnicalSolution ;
                   rdfs:range fmlo:MLTask ;
                   rdfs:label "addressesTask"@en ;
                   skos:altLabel "endereça tarefa"@pt ;
                   skos:definition "Which ML task a solution targets"@en .


###  http://www.usp.br/fmlo#affectsAttribute
fmlo:affectsAttribute rdf:type owl:ObjectProperty ;
                      owl:inverseOf fmlo:isAffectedBy ;
                      rdfs:domain fmlo:BiasSource ;
                      rdfs:range fmlo:SensitiveAttribute ;
                      owl:propertyChainAxiom ( fmlo:hasDataType
                                               fmlo:isVulnerableTo
                                             ) ;
                      rdfs:label "affectsAttribute"@en ;
                      skos:altLabel "afeta atributo"@pt ;
                      skos:definition "Which sensitive attribute is affected by a bias source"@en .


###  http://www.usp.br/fmlo#amplifies
fmlo:amplifies rdf:type owl:ObjectProperty ;
               owl:inverseOf fmlo:isAmplifiedBy ;
               rdf:type owl:IrreflexiveProperty ;
               rdfs:domain fmlo:BiasSource ;
               rdfs:range fmlo:BiasSource ;
               rdfs:label "amplifies"@en ;
               skos:altLabel "amplifica"@pt ;
               skos:definition "When one bias source worsens another"@en .


###  http://www.usp.br/fmlo#appliedInDomain
fmlo:appliedInDomain rdf:type owl:ObjectProperty ;
                     owl:inverseOf fmlo:hasSolution ;
                     rdf:type owl:IrreflexiveProperty ;
                     rdfs:domain fmlo:SocioTechnicalSolution ;
                     rdfs:range fmlo:ApplicationDomain ;
                     rdfs:label "appliedInDomain"@en ;
                     skos:altLabel "aplicado no domínio"@pt ;
                     skos:definition "Which application domain a solution targets"@en .


###  http://www.usp.br/fmlo#appliesAtScope
fmlo:appliesAtScope rdf:type owl:ObjectProperty ;
                    owl:inverseOf fmlo:scopeSupports ;
                    rdf:type owl:IrreflexiveProperty ;
                    rdfs:domain fmlo:NormativeDimension ;
                    rdfs:range fmlo:SocioTechnicalScope ;
                    rdfs:label "appliesAtScope"@en ;
                    skos:altLabel "aplica-se ao escopo"@pt ;
                    skos:definition "Which sociotechnical scope a normative principle operates at"@en .


###  http://www.usp.br/fmlo#appliesInArea
fmlo:appliesInArea rdf:type owl:ObjectProperty ;
                   owl:inverseOf fmlo:hasApplicableSolution ;
                   rdfs:domain fmlo:SocioTechnicalSolution ;
                   rdfs:range fmlo:TechnicalArea ;
                   owl:propertyChainAxiom ( fmlo:addressesTask
                                            fmlo:belongsToArea
                                          ) ;
                   rdfs:label "appliesInArea"@en ;
                   skos:altLabel "Aplica na área"@pt ;
                   skos:definition "Relates a sociotechnical solution to the technical area in which it is applicable, inferred through the property chain addressesTask o belongsToArea."@en .


###  http://www.usp.br/fmlo#appliesToPhase
fmlo:appliesToPhase rdf:type owl:ObjectProperty ;
                    owl:inverseOf fmlo:isPhaseOf ;
                    rdf:type owl:FunctionalProperty ,
                             owl:IrreflexiveProperty ;
                    rdfs:domain fmlo:SocioTechnicalSolution ;
                    rdfs:range fmlo:ProcessingPhase ;
                    rdfs:label "appliesToPhase"@en ;
                    skos:altLabel "aplica-se à fase"@pt ;
                    skos:definition "In which processing phase the technique intervenes"@en .


###  http://www.usp.br/fmlo#appliesToStage
fmlo:appliesToStage rdf:type owl:ObjectProperty ;
                    owl:inverseOf fmlo:isStageOf ;
                    rdf:type owl:FunctionalProperty ,
                             owl:IrreflexiveProperty ;
                    rdfs:domain fmlo:SocioTechnicalSolution ;
                    rdfs:range fmlo:LifeCycleStage ;
                    rdfs:label "appliesToStage"@en ;
                    skos:altLabel "aplica-se ao estágio"@pt ;
                    skos:definition "Specifies in which lifecycle stage a solution operates"@en .


###  http://www.usp.br/fmlo#approachAppliesAtScope
fmlo:approachAppliesAtScope rdf:type owl:ObjectProperty ;
                            owl:inverseOf fmlo:scopeUses ;
                            rdf:type owl:IrreflexiveProperty ;
                            rdfs:domain fmlo:MethodologicalApproach ;
                            rdfs:range fmlo:SocioTechnicalScope ;
                            rdfs:label "approachAppliesAtScope"@en ;
                            skos:altLabel "abordagem aplica-se ao escopo"@pt ;
                            skos:definition "At which scope levels this approach operates"@en .


###  http://www.usp.br/fmlo#approachHasCriterion
fmlo:approachHasCriterion rdf:type owl:ObjectProperty ;
                          owl:inverseOf fmlo:criterionBelongsToApproach ;
                          rdf:type owl:IrreflexiveProperty ;
                          rdfs:domain fmlo:MethodologicalApproach ;
                          rdfs:range fmlo:FairnessCriterion ;
                          rdfs:label "approachHasCriterion"@en ;
                          skos:altLabel "abordagem tem critério"@pt ;
                          skos:definition "Which criteria belong to this approach"@en .


###  http://www.usp.br/fmlo#approachHasLocus
fmlo:approachHasLocus rdf:type owl:ObjectProperty ;
                      owl:inverseOf fmlo:isLocusOfApproach ;
                      rdf:type owl:IrreflexiveProperty ;
                      rdfs:domain fmlo:MethodologicalApproach ;
                      rdfs:range fmlo:EvaluationLocus ;
                      rdfs:label "approachHasLocus"@en ;
                      skos:altLabel "abordagem tem locus"@pt ;
                      skos:definition "Which evaluation loci a methodological approach supports"@en .


###  http://www.usp.br/fmlo#belongsToArea
fmlo:belongsToArea rdf:type owl:ObjectProperty ;
                   owl:inverseOf fmlo:hasTask ;
                   rdf:type owl:AsymmetricProperty ,
                            owl:IrreflexiveProperty ;
                   rdfs:domain fmlo:MLTask ;
                   rdfs:range fmlo:TechnicalArea ;
                   rdfs:label "belongsToArea"@en ;
                   skos:altLabel "pertence à área"@pt ;
                   skos:definition "Which technical area a ML task belongs to"@en .


###  http://www.usp.br/fmlo#belongsToFamily
fmlo:belongsToFamily rdf:type owl:ObjectProperty ;
                     owl:inverseOf fmlo:hasMember ;
                     rdf:type owl:FunctionalProperty ,
                              owl:IrreflexiveProperty ;
                     rdfs:domain fmlo:FairnessNotion ;
                     rdfs:range fmlo:StatisticalFamily ;
                     rdfs:label "belongsToFamily"@en ;
                     skos:altLabel "pertence à família"@pt ;
                     skos:definition "Which statistical family a notion belongs to"@en .


###  http://www.usp.br/fmlo#canAffectDataType
fmlo:canAffectDataType rdf:type owl:ObjectProperty ;
                       owl:inverseOf fmlo:isVulnerableTo ;
                       rdfs:domain fmlo:BiasSource ;
                       rdfs:range fmlo:AttributeDataType ;
                       rdfs:label "canAffectDataType"@en ;
                       skos:altLabel "pode afetar tipo de dado"@pt ;
                       skos:definition "Quais tipos de dados de atributos são suscetíveis aos efeitos de uma determinada fonte de viés"@pt ,
                                       "Which attribute data types are susceptible to the effects of a given bias source"@en .


###  http://www.usp.br/fmlo#classifies
fmlo:classifies rdf:type owl:ObjectProperty ;
                owl:inverseOf fmlo:isClassifiedAs ;
                rdf:type owl:IrreflexiveProperty ;
                rdfs:domain fmlo:Data ;
                rdfs:range fmlo:SensitiveAttribute ;
                rdfs:label "classifies"@en ;
                skos:altLabel "classifica"@pt ;
                skos:definition "Which sensitive attributes fall under this data category"@en .


###  http://www.usp.br/fmlo#containsAttribute
fmlo:containsAttribute rdf:type owl:ObjectProperty ;
                       owl:inverseOf fmlo:isAttributeOf ;
                       rdf:type owl:IrreflexiveProperty ;
                       rdfs:domain fmlo:Data ;
                       rdfs:range fmlo:SensitiveAttribute ;
                       rdfs:label "containsAttribute"@en ;
                       skos:altLabel "contém atributo"@pt ;
                       skos:definition "Which sensitive attributes are embedded in a data category"@en .


###  http://www.usp.br/fmlo#criterionBelongsToApproach
fmlo:criterionBelongsToApproach rdf:type owl:ObjectProperty ,
                                         owl:FunctionalProperty ,
                                         owl:IrreflexiveProperty ;
                                rdfs:domain fmlo:FairnessCriterion ;
                                rdfs:range fmlo:MethodologicalApproach ;
                                rdfs:label "criterionBelongsToApproach"@en ;
                                skos:altLabel "critério pertence à abordagem"@pt ;
                                skos:definition "Links a criterion to its methodological approach"@en .


###  http://www.usp.br/fmlo#discovers
fmlo:discovers rdf:type owl:ObjectProperty ;
               owl:inverseOf fmlo:isDiscoveredBy ;
               rdf:type owl:IrreflexiveProperty ;
               rdfs:domain fmlo:BiasDiscoveryTechnique ;
               rdfs:range fmlo:BiasSource ;
               rdfs:label "discovers"@en ;
               skos:altLabel "descobre"@pt ;
               skos:definition "Indicates which bias source a discovery technique detects"@en .


###  http://www.usp.br/fmlo#discoversInStage
fmlo:discoversInStage rdf:type owl:ObjectProperty ;
                      owl:inverseOf fmlo:hasDiscoveryIn ;
                      rdf:type owl:IrreflexiveProperty ;
                      rdfs:domain fmlo:BiasDiscoveryTechnique ;
                      rdfs:range fmlo:LifeCycleStage ;
                      rdfs:label "discoversInStage"@en ;
                      skos:altLabel "descobre no estágio"@pt ;
                      skos:definition "In which lifecycle stage a discovery technique operates"@en .


###  http://www.usp.br/fmlo#encompassPrinciple
fmlo:encompassPrinciple rdf:type owl:ObjectProperty ;
                        owl:inverseOf fmlo:isPrincipleOf ;
                        rdf:type owl:IrreflexiveProperty ;
                        rdfs:domain fmlo:EthicalDimension ;
                        rdfs:range fmlo:NormativeDimension ;
                        rdfs:label "encompassPrinciple"@en ;
                        skos:altLabel "abrange princípio"@pt ;
                        skos:definition "Which normative principles an ethical dimension encompasses"@en .


###  http://www.usp.br/fmlo#evaluatesWith
fmlo:evaluatesWith rdf:type owl:ObjectProperty ;
                   owl:inverseOf fmlo:isUsedToEvaluate ;
                   rdf:type owl:IrreflexiveProperty ;
                   rdfs:domain fmlo:SocioTechnicalSolution ;
                   rdfs:range fmlo:FairnessMetric ;
                   rdfs:label "evaluatesWith"@en ;
                   skos:altLabel "avalia com"@pt ;
                   skos:definition "Which metrics are used to evaluate a solution"@en .


###  http://www.usp.br/fmlo#formalizesCriterion
fmlo:formalizesCriterion rdf:type owl:ObjectProperty ;
                         owl:inverseOf fmlo:isFormalizedBy ;
                         rdf:type owl:IrreflexiveProperty ;
                         rdfs:domain fmlo:FairnessMetric ;
                         rdfs:range fmlo:FairnessCriterion ;
                         rdfs:label "formalizesCriterion"@en ;
                         skos:altLabel "formaliza critério"@pt ;
                         skos:definition "Indicates that a metric formalizes a criterion mathematically"@en .


###  http://www.usp.br/fmlo#hasApplicableSolution
fmlo:hasApplicableSolution rdf:type owl:ObjectProperty ;
                           rdfs:domain fmlo:TechnicalArea ;
                           rdfs:range fmlo:SocioTechnicalSolution ;
                           rdfs:label "hasApplicableSolution"@en ;
                           skos:altLabel "tem solução aplicável"@pt ;
                           skos:definition "Relaciona uma área técnica às soluções sociotécnicas aplicáveis dentro dela"@pt ,
                                           "Relates a technical area to the sociotechnical solutions applicable within it."@en .


###  http://www.usp.br/fmlo#hasCausalAnalogue
fmlo:hasCausalAnalogue rdf:type owl:ObjectProperty ;
                       owl:inverseOf fmlo:isCausalAnalogueOf ;
                       rdf:type owl:AsymmetricProperty ,
                                owl:IrreflexiveProperty ;
                       rdfs:domain fmlo:FairnessNotion ;
                       rdfs:range fmlo:FairnessNotion ;
                       rdfs:label "hasCausalAnalogue"@en ;
                       skos:altLabel "tem análogo causal"@pt ;
                       skos:definition "Relates a fairness notion to its counterpart defined under the causal methodological approach, capturing the correspondence between statistical and causal formulations of the same fairness concept."@en .


###  http://www.usp.br/fmlo#hasCriterion
fmlo:hasCriterion rdf:type owl:ObjectProperty ;
                  owl:inverseOf fmlo:isCriterionOf ;
                  rdf:type owl:IrreflexiveProperty ;
                  rdfs:domain fmlo:EvaluationLocus ;
                  rdfs:range fmlo:FairnessCriterion ;
                  rdfs:label "hasCriterion"@en ;
                  skos:altLabel "tem critério"@pt ;
                  skos:definition "Relaciona um locus de avaliação a um critério de fairness que ele abrange ou pelo qual é avaliado"@pt ,
                                  "Relates either an evaluation locus to a fairness criterion that it encompasses or is evaluated by"@en .


###  http://www.usp.br/fmlo#hasDataType
fmlo:hasDataType rdf:type owl:ObjectProperty ;
                 owl:inverseOf fmlo:isTypeOfData ;
                 rdf:type owl:AsymmetricProperty ,
                          owl:IrreflexiveProperty ;
                 rdfs:domain fmlo:SensitiveAttribute ;
                 rdfs:range fmlo:AttributeDataType ;
                 rdfs:label "hasDataType"@en ;
                 skos:altLabel "tem tipo de dado"@pt ;
                 skos:definition "Indica que uma entidade de dados é classificada sob um tipo específico de dado dentro da taxonomia de dados"@pt ,
                                 "Indicates that a data entity is classified under a specific data type within the data taxonomy"@en .


###  http://www.usp.br/fmlo#hasDiscoveryIn
fmlo:hasDiscoveryIn rdf:type owl:ObjectProperty ,
                             owl:IrreflexiveProperty ;
                    rdfs:domain fmlo:LifeCycleStage ;
                    rdfs:range fmlo:BiasDiscoveryTechnique ;
                    rdfs:label "hasDiscoveryIn"@en ;
                    skos:altLabel "tem descoberta em"@pt ;
                    skos:definition "Which discovery techniques operate in this stage"@en .


###  http://www.usp.br/fmlo#hasDocument
fmlo:hasDocument rdf:type owl:ObjectProperty ;
                 owl:inverseOf fmlo:isDocumentOf ;
                 rdf:type owl:IrreflexiveProperty ;
                 rdfs:domain fmlo:LegalFramework ;
                 rdfs:range fmlo:LegalFramework ;
                 rdfs:label "hasDocument"@en ;
                 skos:altLabel "tem documento"@pt ;
                 skos:definition "Relaciona um framework legal a outro documento ou framework legal que ele referencia, incorpora ou do qual é composto"@pt ,
                                 "Relates a legal framework to another legal document or framework that it references, incorporates, or is composed of"@en .


###  http://www.usp.br/fmlo#hasDualRole
fmlo:hasDualRole rdf:type owl:ObjectProperty ;
                 owl:inverseOf fmlo:isDualRoleOf ;
                 rdf:type owl:IrreflexiveProperty ;
                 rdfs:domain fmlo:FairnessNotion ;
                 rdfs:range fmlo:FairnessMetric ;
                 rdfs:label "hasDualRole"@en ;
                 skos:altLabel "tem papel dual"@pt ;
                 skos:definition "When a notion serves both as evaluation metric and optimization constraint"@en .


###  http://www.usp.br/fmlo#hasEthicalDimension
fmlo:hasEthicalDimension rdf:type owl:ObjectProperty ;
                         owl:inverseOf fmlo:isEthicalDimensionOf ;
                         rdfs:domain fmlo:FairnessNotion ;
                         rdfs:range fmlo:EthicalDimension ;
                         owl:propertyChainAxiom ( fmlo:hasNormativePrinciple
                                                  fmlo:isPrincipleOf
                                                ) ;
                         rdfs:label "hasEthicalDimension"@en ;
                         skos:altLabel "tem dimensão ética"@pt ;
                         skos:definition "Whether distributive or procedural justice"@en .


###  http://www.usp.br/fmlo#hasEvaluationLocus
fmlo:hasEvaluationLocus rdf:type owl:ObjectProperty ;
                        owl:inverseOf fmlo:isEvaluationLocusOf ;
                        rdfs:domain fmlo:FairnessNotion ;
                        rdfs:range fmlo:EvaluationLocus ;
                        owl:propertyChainAxiom ( fmlo:belongsToFamily
                                                 fmlo:isFamilyOf
                                               ) ;
                        rdfs:label "hasEvaluationLocus"@en ;
                        skos:altLabel "tem locus de avaliação"@pt ;
                        skos:definition "Whether the notion is extrinsic or intrinsic"@en .


###  http://www.usp.br/fmlo#hasFamily
fmlo:hasFamily rdf:type owl:ObjectProperty ;
               owl:inverseOf fmlo:isFamilyOf ;
               rdf:type owl:IrreflexiveProperty ;
               rdfs:domain fmlo:EvaluationLocus ;
               rdfs:range fmlo:StatisticalFamily ;
               rdfs:label "hasFamily"@en ;
               skos:altLabel "tem família"@pt ;
               skos:definition "Which statistical families an evaluation locus contains"@en .


###  http://www.usp.br/fmlo#hasMappedPhase
fmlo:hasMappedPhase rdf:type owl:ObjectProperty ;
                    owl:inverseOf fmlo:mapsToStage ;
                    rdf:type owl:IrreflexiveProperty ;
                    rdfs:domain fmlo:LifeCycleStage ;
                    rdfs:range fmlo:ProcessingPhase ;
                    rdfs:label "hasMappedPhase"@en ;
                    skos:altLabel "tem fase mapeada"@pt ;
                    skos:definition "Which processing phase corresponds to this stage"@en .


###  http://www.usp.br/fmlo#hasMember
fmlo:hasMember rdf:type owl:ObjectProperty ,
                        owl:IrreflexiveProperty ;
               rdfs:domain fmlo:StatisticalFamily ;
               rdfs:range fmlo:FairnessNotion ;
               rdfs:label "hasMember"@en ;
               skos:altLabel "tem membro"@pt ;
               skos:definition "Which notions belong to this family"@en .


###  http://www.usp.br/fmlo#hasMethodologicalApproach
fmlo:hasMethodologicalApproach rdf:type owl:ObjectProperty ;
                               owl:inverseOf fmlo:isMethodologicalApproachOf ;
                               rdfs:domain fmlo:FairnessNotion ;
                               rdfs:range fmlo:MethodologicalApproach ;
                               owl:propertyChainAxiom ( fmlo:satisfiesCriterion
                                                        fmlo:criterionBelongsToApproach
                                                      ) ;
                               rdfs:label "hasMethodologicalApproach"@en ;
                               skos:altLabel "tem abordagem metodológica"@pt ;
                               skos:definition "Whether the notion is statistical, causal, or geometric"@en .


###  http://www.usp.br/fmlo#hasNormativePrinciple
fmlo:hasNormativePrinciple rdf:type owl:ObjectProperty ;
                           owl:inverseOf fmlo:isNormativePrincipleOf ;
                           rdf:type owl:FunctionalProperty ,
                                    owl:IrreflexiveProperty ;
                           rdfs:domain fmlo:FairnessNotion ;
                           rdfs:range fmlo:NormativeDimension ;
                           rdfs:label "hasNormativePrinciple"@en ;
                           skos:altLabel "tem princípio normativo"@pt ;
                           skos:definition "Which normative principle a notion operationalizes"@en .


###  http://www.usp.br/fmlo#hasOperationalization
fmlo:hasOperationalization rdf:type owl:ObjectProperty ;
                           owl:inverseOf fmlo:isOperationalizationOf ;
                           rdf:type owl:FunctionalProperty ,
                                    owl:IrreflexiveProperty ;
                           rdfs:domain fmlo:FairnessMetric ;
                           rdfs:range fmlo:MetricOperationalization ;
                           rdfs:label "Operationalizes"@en ;
                           skos:altLabel "Operacionaliza"@pt ;
                           skos:definition "How the metric is computed"@en .


###  http://www.usp.br/fmlo#hasProxy
fmlo:hasProxy rdf:type owl:ObjectProperty ;
              owl:inverseOf fmlo:isProxyFor ;
              rdf:type owl:IrreflexiveProperty ;
              rdfs:domain fmlo:SensitiveAttribute ;
              rdfs:range fmlo:SensitiveAttribute ;
              rdfs:label "hasProxy"@en ;
              skos:altLabel "tem proxy"@pt ;
              skos:definition "A protected characteristic has an indirect proxy"@en .


###  http://www.usp.br/fmlo#hasSocioTechnicalScope
fmlo:hasSocioTechnicalScope rdf:type owl:ObjectProperty ;
                            owl:inverseOf fmlo:isSocioTechnicalScopeOf ;
                            rdf:type owl:FunctionalProperty ,
                                     owl:IrreflexiveProperty ;
                            rdfs:domain fmlo:FairnessNotion ;
                            rdfs:range fmlo:SocioTechnicalScope ;
                            rdfs:label "hasSocioTechnicalScope"@en ;
                            skos:altLabel "tem escopo sociotécnico"@pt ;
                            skos:definition "Individual, group, or intersectional scope"@en .


###  http://www.usp.br/fmlo#hasSolution
fmlo:hasSolution rdf:type owl:ObjectProperty ,
                          owl:IrreflexiveProperty ;
                 rdfs:domain fmlo:ApplicationDomain ;
                 rdfs:range fmlo:SocioTechnicalSolution ;
                 rdfs:label "hasSolution"@en ;
                 skos:altLabel "tem solução"@pt ;
                 skos:definition "Which solutions target this domain"@en .


###  http://www.usp.br/fmlo#hasSource
fmlo:hasSource rdf:type owl:ObjectProperty ;
               owl:inverseOf fmlo:isSourceOf ;
               rdf:type owl:IrreflexiveProperty ;
               rdfs:domain fmlo:BiasSource ;
               rdfs:range fmlo:Bias ;
               rdfs:label "hasSource"@en ;
               skos:altLabel "tem fonte"@pt ;
               skos:definition "Relates a bias type to its source"@en .


###  http://www.usp.br/fmlo#hasSpecialCase
fmlo:hasSpecialCase rdf:type owl:ObjectProperty ;
                    owl:inverseOf fmlo:isSpecialCaseOf ;
                    rdf:type owl:TransitiveProperty ;
                    rdfs:domain fmlo:FairnessNotion ;
                    rdfs:range fmlo:FairnessNotion ;
                    rdfs:label "hasSpecialCase"@en ;
                    skos:altLabel "tem caso especial"@pt ;
                    skos:definition "One notion has a more restricted variant"@en .


###  http://www.usp.br/fmlo#hasStatisticalCriterion
fmlo:hasStatisticalCriterion rdf:type owl:ObjectProperty ;
                             owl:inverseOf fmlo:isStatisticalCriterionOf ;
                             rdf:type owl:FunctionalProperty ,
                                      owl:IrreflexiveProperty ;
                             rdfs:domain fmlo:StatisticalFamily ;
                             rdfs:range fmlo:FairnessCriterion ;
                             rdfs:label "hasStatisticalCriterion"@en ;
                             skos:altLabel "tem critério estatístico"@pt ;
                             skos:definition "Which criterion is associated with a statistical family"@en .


###  http://www.usp.br/fmlo#hasTask
fmlo:hasTask rdf:type owl:ObjectProperty ,
                      owl:AsymmetricProperty ,
                      owl:IrreflexiveProperty ;
             rdfs:domain fmlo:TechnicalArea ;
             rdfs:range fmlo:MLTask ;
             rdfs:label "hasTask"@en ;
             skos:altLabel "tem tarefa" ;
             skos:definition "Which tasks belong to this technical area"@en .


###  http://www.usp.br/fmlo#hasTradeOffWith
fmlo:hasTradeOffWith rdf:type owl:ObjectProperty ,
                              owl:SymmetricProperty ,
                              owl:IrreflexiveProperty ;
                     rdfs:domain fmlo:FairnessNotion ;
                     rdfs:range fmlo:FairnessNotion ;
                     rdfs:label "hasTradeOffWith"@en ;
                     skos:altLabel "tem trade-off com"@pt ;
                     skos:definition "Tension between notions but not impossibility"@en .


###  http://www.usp.br/fmlo#isAddressedByNotion
fmlo:isAddressedByNotion rdf:type owl:ObjectProperty ,
                                  owl:IrreflexiveProperty ;
                         rdfs:domain fmlo:BiasSource ;
                         rdfs:range fmlo:FairnessNotion ;
                         rdfs:label "isAddressedByNotion"@en ;
                         skos:altLabel "é endereçado por noção"@pt ;
                         skos:definition "Which fairness notions address this bias type"@en .


###  http://www.usp.br/fmlo#isAddressedBySolution
fmlo:isAddressedBySolution rdf:type owl:ObjectProperty ,
                                    owl:IrreflexiveProperty ;
                           rdfs:domain fmlo:MLTask ;
                           rdfs:range fmlo:SocioTechnicalSolution ;
                           rdfs:label "isAddressedBySolution"@en ;
                           skos:altLabel "é endereçada por solução"@pt ;
                           skos:definition "Which solutions address this task"@en .


###  http://www.usp.br/fmlo#isAffectedBy
fmlo:isAffectedBy rdf:type owl:ObjectProperty ;
                  rdfs:domain fmlo:SensitiveAttribute ;
                  rdfs:range fmlo:BiasSource ;
                  owl:propertyChainAxiom ( fmlo:hasDataType
                                           fmlo:isVulnerableTo
                                         ) ;
                  rdfs:label "isAffectedBy"@en ;
                  skos:altLabel "é afetado por"@pt ;
                  skos:definition "Which bias sources affect this attribute"@en .


###  http://www.usp.br/fmlo#isAmplifiedBy
fmlo:isAmplifiedBy rdf:type owl:ObjectProperty ,
                            owl:IrreflexiveProperty ;
                   rdfs:domain fmlo:BiasSource ;
                   rdfs:range fmlo:BiasSource ;
                   rdfs:label "isAmplifiedBy"@en ;
                   skos:altLabel "é amplificado por"@pt ;
                   skos:definition "When a bias source is worsened by another"@en .


###  http://www.usp.br/fmlo#isAttributeOf
fmlo:isAttributeOf rdf:type owl:ObjectProperty ,
                            owl:IrreflexiveProperty ;
                   rdfs:domain fmlo:SensitiveAttribute ;
                   rdfs:range fmlo:Data ;
                   rdfs:label "isAttributeOf"@en ;
                   skos:altLabel "é atributo de"@pt ;
                   skos:definition "To which data category this attribute belongs"@en .


###  http://www.usp.br/fmlo#isCausalAnalogueOf
fmlo:isCausalAnalogueOf rdf:type owl:ObjectProperty ,
                                 owl:AsymmetricProperty ,
                                 owl:IrreflexiveProperty ;
                        rdfs:domain fmlo:FairnessNotion ;
                        rdfs:range fmlo:FairnessNotion ;
                        rdfs:label "isCausalAnalogueOf"@en ;
                        skos:altLabel "é análogo estatístico de"@pt ;
                        skos:definition "Relates a causal fairness notion to the statistical fairness notion from which it derives, indicating that it formalizes the same fairness concept under a causal framework."@en .


###  http://www.usp.br/fmlo#isClassifiedAs
fmlo:isClassifiedAs rdf:type owl:ObjectProperty ,
                             owl:IrreflexiveProperty ;
                    rdfs:domain fmlo:SensitiveAttribute ;
                    rdfs:range fmlo:Data ;
                    rdfs:label "isClassifiedAs"@en ;
                    skos:altLabel "é classificado como"@pt ;
                    skos:definition "How a sensitive attribute is categorized normatively"@en .


###  http://www.usp.br/fmlo#isCriterionOf
fmlo:isCriterionOf rdf:type owl:ObjectProperty ,
                            owl:IrreflexiveProperty ;
                   rdfs:domain fmlo:FairnessCriterion ;
                   rdfs:range fmlo:EvaluationLocus ;
                   rdfs:label "isCriterionOf"@en ;
                   skos:altLabel "é critério de"@pt ;
                   skos:definition "Indica que um critério de fairness pertence a ou avalia um locus de avaliação"@pt ,
                                   "Indicates that a fairness criterion belongs to or evaluates an evaluation locus"@en .


###  http://www.usp.br/fmlo#isDiscoveredBy
fmlo:isDiscoveredBy rdf:type owl:ObjectProperty ,
                             owl:IrreflexiveProperty ;
                    rdfs:domain fmlo:BiasSource ;
                    rdfs:range fmlo:BiasDiscoveryTechnique ;
                    rdfs:label "isDiscoveredBy"@en ;
                    skos:altLabel "é descoberto por"@pt ;
                    skos:definition "Indicates which technique discovers a bias source"@en .


###  http://www.usp.br/fmlo#isDocumentOf
fmlo:isDocumentOf rdf:type owl:ObjectProperty ,
                           owl:IrreflexiveProperty ;
                  rdfs:domain fmlo:LegalFramework ;
                  rdfs:range fmlo:LegalFramework ;
                  rdfs:label "isDocumentOf"@en ;
                  skos:altLabel "é documento de"@pt ;
                  skos:definition "Indica que um documento ou framework legal é referenciado por ou incorporado em outro framework legal"@pt ,
                                  "Indicates that a legal document or framework is referenced by or incorporated into another legal framework"@en .


###  http://www.usp.br/fmlo#isDualRoleOf
fmlo:isDualRoleOf rdf:type owl:ObjectProperty ,
                           owl:IrreflexiveProperty ;
                  rdfs:domain fmlo:FairnessMetric ;
                  rdfs:range fmlo:FairnessNotion ;
                  rdfs:label "isDualRoleOf"@en ;
                  skos:altLabel "é papel dual de"@pt ;
                  skos:definition "The metric that serves dual role for this notion"@en .


###  http://www.usp.br/fmlo#isEthicalDimensionOf
fmlo:isEthicalDimensionOf rdf:type owl:ObjectProperty ;
                          rdfs:domain fmlo:EthicalDimension ;
                          rdfs:range fmlo:FairnessNotion ;
                          rdfs:label "isEthicalDimensionOf"@en ;
                          skos:altLabel "é dimensão ética de"@pt ;
                          skos:definition "Which notions belong to this ethical dimension"@en .


###  http://www.usp.br/fmlo#isEvaluationLocusOf
fmlo:isEvaluationLocusOf rdf:type owl:ObjectProperty ;
                         rdfs:domain fmlo:EvaluationLocus ;
                         rdfs:range fmlo:FairnessNotion ;
                         rdfs:label "isEvaluationLocusOf"@en ;
                         skos:altLabel "é locus de avaliação de"@pt ;
                         skos:definition "Which notions use this evaluation locus"@en .


###  http://www.usp.br/fmlo#isFamilyOf
fmlo:isFamilyOf rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ,
                         owl:IrreflexiveProperty ;
                rdfs:domain fmlo:StatisticalFamily ;
                rdfs:range fmlo:EvaluationLocus ;
                rdfs:label "isFamilyOf"@en ;
                skos:altLabel "é família de"@pt ;
                skos:definition "To which evaluation locus this family belongs"@en .


###  http://www.usp.br/fmlo#isFormalizedBy
fmlo:isFormalizedBy rdf:type owl:ObjectProperty ,
                             owl:IrreflexiveProperty ;
                    rdfs:domain fmlo:FairnessCriterion ;
                    rdfs:range fmlo:FairnessMetric ;
                    rdfs:label "isFormalizedBy"@en ;
                    skos:altLabel "é formalizado por"@pt ;
                    skos:definition "Indicates which metrics formalize this criterion"@en .


###  http://www.usp.br/fmlo#isIncompatibleWith
fmlo:isIncompatibleWith rdf:type owl:ObjectProperty ,
                                 owl:SymmetricProperty ,
                                 owl:IrreflexiveProperty ;
                        rdfs:domain fmlo:FairnessNotion ;
                        rdfs:range fmlo:FairnessNotion ;
                        rdfs:label "isIncompatibleWith"@en ;
                        skos:altLabel "é incompatível com"@pt ;
                        skos:definition "Captures impossibility results between fairness notions"@en .


###  http://www.usp.br/fmlo#isLocusOfApproach
fmlo:isLocusOfApproach rdf:type owl:ObjectProperty ,
                                owl:IrreflexiveProperty ;
                       rdfs:domain fmlo:EvaluationLocus ;
                       rdfs:range fmlo:MethodologicalApproach ;
                       rdfs:label "isLocusOfApproach"@en ;
                       skos:altLabel "é locus de abordagem"@pt ;
                       skos:definition "To which methodological approach this locus belongs"@en .


###  http://www.usp.br/fmlo#isMethodologicalApproachOf
fmlo:isMethodologicalApproachOf rdf:type owl:ObjectProperty ;
                                rdfs:domain fmlo:MethodologicalApproach ;
                                rdfs:range fmlo:FairnessNotion ;
                                rdfs:label "isMethodologicalApproachOf"@en ;
                                skos:altLabel "é abordagem metodológica de"@pt ;
                                skos:definition "Which notions use this approach"@en .


###  http://www.usp.br/fmlo#isMitigatedBy
fmlo:isMitigatedBy rdf:type owl:ObjectProperty ;
                   owl:inverseOf fmlo:mitigates ;
                   rdf:type owl:IrreflexiveProperty ;
                   rdfs:domain fmlo:BiasSource ;
                   rdfs:range fmlo:BiasMitigationTechnique ;
                   rdfs:label "isMitigatedBy"@en ;
                   skos:altLabel "é mitigado por"@pt ;
                   skos:definition "Indicates which technique mitigates a bias source"@en .


###  http://www.usp.br/fmlo#isNormativePrincipleOf
fmlo:isNormativePrincipleOf rdf:type owl:ObjectProperty ,
                                     owl:IrreflexiveProperty ;
                            rdfs:domain fmlo:NormativeDimension ;
                            rdfs:range fmlo:FairnessNotion ;
                            rdfs:label "isNormativePrincipleOf"@en ;
                            skos:altLabel "é princípio normativo de"@pt ;
                            skos:definition "Which notions operationalize this principle"@en .


###  http://www.usp.br/fmlo#isOperationalizationOf
fmlo:isOperationalizationOf rdf:type owl:ObjectProperty ,
                                     owl:IrreflexiveProperty ;
                            rdfs:domain fmlo:MetricOperationalization ;
                            rdfs:range fmlo:FairnessMetric ;
                            rdfs:label "isOperationalizationOf"@en ;
                            skos:altLabel "é operacionalização de"@pt ;
                            skos:definition "Which metrics use this computation type"@en .


###  http://www.usp.br/fmlo#isOperationalizedBy
fmlo:isOperationalizedBy rdf:type owl:ObjectProperty ;
                         owl:inverseOf fmlo:operationalizes ;
                         rdf:type owl:IrreflexiveProperty ;
                         rdfs:domain fmlo:FairnessNotion ;
                         rdfs:range fmlo:FairnessMetric ;
                         rdfs:label "isMeasuredBy"@en ;
                         skos:altLabel "é medido por"@pt ;
                         skos:definition "Which metrics quantify this fairness notion"@en .


###  http://www.usp.br/fmlo#isOriginOf
fmlo:isOriginOf rdf:type owl:ObjectProperty ;
                owl:inverseOf fmlo:originatesIn ;
                rdfs:domain fmlo:LifeCycleStage ;
                rdfs:range fmlo:BiasSource ;
                rdfs:label "isOriginOf"@en ;
                skos:altLabel "é origem de"@pt ;
                skos:definition "Identifies which bias sources originate in a lifecycle stage"@en .


###  http://www.usp.br/fmlo#isPhaseOf
fmlo:isPhaseOf rdf:type owl:ObjectProperty ,
                        owl:IrreflexiveProperty ;
               rdfs:domain fmlo:ProcessingPhase ;
               rdfs:range fmlo:SocioTechnicalSolution ;
               rdfs:label "isPhaseOf"@en ;
               skos:altLabel "é fase de"@pt ;
               skos:definition "Which techniques intervene in this processing phase"@en .


###  http://www.usp.br/fmlo#isPhaseOriginOf
fmlo:isPhaseOriginOf rdf:type owl:ObjectProperty ;
                     owl:inverseOf fmlo:originatesInPhase ;
                     rdf:type owl:IrreflexiveProperty ;
                     rdfs:domain fmlo:ProcessingPhase ;
                     rdfs:range fmlo:BiasSource ;
                     rdfs:label "isPhaseOriginOf"@en ;
                     skos:altLabel "é fase de origem de"@pt ;
                     skos:definition "Identifies which bias sources originate in a processing phase"@en .


###  http://www.usp.br/fmlo#isPrincipleOf
fmlo:isPrincipleOf rdf:type owl:ObjectProperty ,
                            owl:FunctionalProperty ,
                            owl:IrreflexiveProperty ;
                   rdfs:domain fmlo:NormativeDimension ;
                   rdfs:range fmlo:EthicalDimension ;
                   rdfs:label "isPrincipleOf"@en ;
                   skos:altLabel "é princípio de"@pt ;
                   skos:definition "To which ethical dimension a normative principle belongs"@en .


###  http://www.usp.br/fmlo#isProxyFor
fmlo:isProxyFor rdf:type owl:ObjectProperty ,
                         owl:IrreflexiveProperty ;
                rdfs:domain fmlo:SensitiveAttribute ;
                rdfs:range fmlo:SensitiveAttribute ;
                rdfs:label "isProxyFor"@en ;
                skos:altLabel "é proxy de"@pt ;
                skos:definition "A sensitive attribute indirectly correlates with a protected characteristic"@en .


###  http://www.usp.br/fmlo#isRequiredBy
fmlo:isRequiredBy rdf:type owl:ObjectProperty ;
                  owl:inverseOf fmlo:requiresAccessTo ;
                  rdf:type owl:IrreflexiveProperty ;
                  rdfs:domain fmlo:SensitiveAttribute ;
                  rdfs:range fmlo:FairnessNotion ;
                  rdfs:label "isRequiredBy"@en ;
                  skos:altLabel "é requerido por"@pt ;
                  skos:definition "Which notions require access to this attribute"@en .


###  http://www.usp.br/fmlo#isRequiredByMetric
fmlo:isRequiredByMetric rdf:type owl:ObjectProperty ;
                        owl:inverseOf fmlo:requiresDataType ;
                        rdfs:domain fmlo:AttributeDataType ;
                        rdfs:range fmlo:FairnessMetric ;
                        rdfs:label "isRequiredByMetric"@en ;
                        skos:altLabel "é requerido por métrica" ;
                        skos:definition "Indicates which fairness metrics require or are compatible with this attribute data type"@en .


###  http://www.usp.br/fmlo#isSatisfiedBy
fmlo:isSatisfiedBy rdf:type owl:ObjectProperty ;
                   owl:inverseOf fmlo:satisfiesCriterion ;
                   rdf:type owl:IrreflexiveProperty ;
                   rdfs:domain fmlo:FairnessCriterion ;
                   rdfs:range fmlo:FairnessNotion ;
                   rdfs:label "isSatisfiedBy"@en ;
                   skos:altLabel "é satisfeito por"@pt ;
                   skos:definition "Which notions satisfy this criterion"@en .


###  http://www.usp.br/fmlo#isSocioTechnicalScopeOf
fmlo:isSocioTechnicalScopeOf rdf:type owl:ObjectProperty ,
                                      owl:IrreflexiveProperty ;
                             rdfs:domain fmlo:SocioTechnicalScope ;
                             rdfs:range fmlo:FairnessNotion ;
                             rdfs:label "isSocioTechnicalScopeOf"@en ;
                             skos:altLabel "é escopo sociotécnico de"@pt ;
                             skos:definition "Which notions operate at this scope"@en .


###  http://www.usp.br/fmlo#isSourceOf
fmlo:isSourceOf rdf:type owl:ObjectProperty ,
                         owl:IrreflexiveProperty ;
                rdfs:domain fmlo:Bias ;
                rdfs:range fmlo:BiasSource ;
                rdfs:label "isSourceOf"@en ;
                skos:altLabel "é uma fonte de"@pt ;
                skos:definition "Relates a source to its bias type"@en .


###  http://www.usp.br/fmlo#isSpecialCaseOf
fmlo:isSpecialCaseOf rdf:type owl:ObjectProperty ,
                              owl:TransitiveProperty ;
                     rdfs:domain fmlo:FairnessNotion ;
                     rdfs:range fmlo:FairnessNotion ;
                     rdfs:label "isSpecialCaseOf"@en ;
                     skos:altLabel "é caso especial de"@pt ;
                     skos:definition "One notion is a restricted version of another"@en .


###  http://www.usp.br/fmlo#isStageOf
fmlo:isStageOf rdf:type owl:ObjectProperty ,
                        owl:IrreflexiveProperty ;
               rdfs:domain fmlo:LifeCycleStage ;
               rdfs:range fmlo:SocioTechnicalSolution ;
               rdfs:label "isStageOf"@en ;
               skos:altLabel "é estágio de"@pt ;
               skos:definition "Identifies which solutions operate in this stage"@en .


###  http://www.usp.br/fmlo#isStatisticalCriterionOf
fmlo:isStatisticalCriterionOf rdf:type owl:ObjectProperty ,
                                       owl:IrreflexiveProperty ;
                              rdfs:domain fmlo:FairnessCriterion ;
                              rdfs:range fmlo:StatisticalFamily ;
                              rdfs:label "isStatisticalCriterionOf"@en ;
                              skos:altLabel "é critério de"@pt ;
                              skos:definition "Which statistical family this criterion belongs to"@en .


###  http://www.usp.br/fmlo#isSystematizedBy
fmlo:isSystematizedBy rdf:type owl:ObjectProperty ;
                      owl:inverseOf fmlo:systematizes ;
                      rdf:type owl:IrreflexiveProperty ;
                      rdfs:domain fmlo:BiasSource ;
                      rdfs:range fmlo:StructuralMethodologicalContributions ;
                      rdfs:label "isSystematizedBy"@en ;
                      skos:altLabel "é sistematizado por"@pt ;
                      skos:definition "Indica que uma fonte de viés é organizada ou estruturada por uma contribuição metodológica"@pt ,
                                      "Indicates that a bias source is organized or structured by a methodological contribution"@en .


###  http://www.usp.br/fmlo#isTypeOfData
fmlo:isTypeOfData rdf:type owl:ObjectProperty ,
                           owl:AsymmetricProperty ,
                           owl:IrreflexiveProperty ;
                  rdfs:domain fmlo:AttributeDataType ;
                  rdfs:range fmlo:SensitiveAttribute ;
                  rdfs:label "isTypeOfData"@en ;
                  skos:altLabel "é tipo de dado de"@pt ;
                  skos:definition "Indica que um tipo de dado classifica ou especializa outra entidade de dados dentro da taxonomia de dados"@pt ,
                                  "Indicates that a data type classifies or specializes another data entity within the data taxonomy"@en .


###  http://www.usp.br/fmlo#isUsedByDiscovery
fmlo:isUsedByDiscovery rdf:type owl:ObjectProperty ;
                       owl:inverseOf fmlo:usesMetric ;
                       rdf:type owl:IrreflexiveProperty ;
                       rdfs:domain fmlo:FairnessMetric ;
                       rdfs:range fmlo:BiasDiscoveryTechnique ;
                       rdfs:label "isUsedByDiscovery"@en ;
                       skos:altLabel "é usada por descoberta"@pt ;
                       skos:definition "Which discovery techniques use this metric"@en .


###  http://www.usp.br/fmlo#isUsedByTechnique
fmlo:isUsedByTechnique rdf:type owl:ObjectProperty ;
                       owl:inverseOf fmlo:usesNotion ;
                       rdf:type owl:IrreflexiveProperty ;
                       rdfs:domain fmlo:FairnessNotion ;
                       rdfs:range fmlo:SocioTechnicalSolution ;
                       rdfs:label "isUsedByTechnique"@en ;
                       skos:altLabel "é usada por técnica"@pt ;
                       skos:definition "Which techniques use this notion"@en .


###  http://www.usp.br/fmlo#isUsedToEvaluate
fmlo:isUsedToEvaluate rdf:type owl:ObjectProperty ,
                               owl:IrreflexiveProperty ;
                      rdfs:domain fmlo:FairnessMetric ;
                      rdfs:range fmlo:SocioTechnicalSolution ;
                      rdfs:label "isUsedToEvaluate"@en ;
                      skos:altLabel "é usada para avaliar"@pt ;
                      skos:definition "Which solutions this metric evaluates"@en .


###  http://www.usp.br/fmlo#isVulnerableTo
fmlo:isVulnerableTo rdf:type owl:ObjectProperty ;
                    rdfs:domain fmlo:AttributeDataType ;
                    rdfs:range fmlo:BiasSource ;
                    rdfs:label "isVulnerableTo"@en ;
                    skos:altLabel "é vulnerável à"@pt ;
                    skos:definition "Relates an attribute data type to the bias sources it is susceptible to, based on the statistical and representational characteristics of that type."@en .


###  http://www.usp.br/fmlo#mapsToStage
fmlo:mapsToStage rdf:type owl:ObjectProperty ,
                          owl:IrreflexiveProperty ;
                 rdfs:domain fmlo:ProcessingPhase ;
                 rdfs:range fmlo:LifeCycleStage ;
                 rdfs:label "mapsToStage"@en ;
                 skos:altLabel "mapeia para estágio"@pt ;
                 skos:definition "Which lifecycle stages a processing phase corresponds to"@en .


###  http://www.usp.br/fmlo#mitigates
fmlo:mitigates rdf:type owl:ObjectProperty ,
                        owl:IrreflexiveProperty ;
               rdfs:domain fmlo:BiasMitigationTechnique ;
               rdfs:range fmlo:BiasSource ;
               rdfs:label "mitigates"@en ;
               skos:altLabel "mitiga"@pt ;
               skos:definition "Indicates which bias source a mitigation technique addresses"@en .


###  http://www.usp.br/fmlo#operationalizes
fmlo:operationalizes rdf:type owl:ObjectProperty ,
                              owl:IrreflexiveProperty ;
                     rdfs:domain fmlo:FairnessMetric ;
                     rdfs:range fmlo:FairnessNotion ;
                     rdfs:label "measures"@en ;
                     skos:altLabel "mede"@pt ;
                     skos:definition "Which fairness notion a metric quantifies"@en .


###  http://www.usp.br/fmlo#originatesIn
fmlo:originatesIn rdf:type owl:ObjectProperty ;
                  rdfs:domain fmlo:BiasSource ;
                  rdfs:range fmlo:LifeCycleStage ;
                  owl:propertyChainAxiom ( fmlo:originatesInPhase
                                           fmlo:mapsToStage
                                         ) ;
                  rdfs:label "originatesIn"@en ;
                  skos:altLabel "origina-se em"@pt ;
                  skos:definition "Identifies in which ML lifecycle stage a bias source originates"@en .


###  http://www.usp.br/fmlo#originatesInPhase
fmlo:originatesInPhase rdf:type owl:ObjectProperty ,
                                owl:IrreflexiveProperty ;
                       rdfs:domain fmlo:BiasSource ;
                       rdfs:range fmlo:ProcessingPhase ;
                       rdfs:label "originatesInPhase"@en ;
                       skos:altLabel "origina-se na fase"@pt ;
                       skos:definition "Identifies in which processing phase a bias source originates"@en .


###  http://www.usp.br/fmlo#propagatesTo
fmlo:propagatesTo rdf:type owl:ObjectProperty ;
                  owl:inverseOf fmlo:receivesPropagationFrom ;
                  rdf:type owl:TransitiveProperty ;
                  rdfs:domain fmlo:LifeCycleStage ;
                  rdfs:range fmlo:LifeCycleStage ;
                  rdfs:label "propagatesTo"@en ;
                  skos:altLabel "propaga para"@pt ;
                  skos:definition "How bias propagates through pipeline stages"@en .


###  http://www.usp.br/fmlo#protectedBy
fmlo:protectedBy rdf:type owl:ObjectProperty ;
                 owl:inverseOf fmlo:protects ;
                 rdf:type owl:IrreflexiveProperty ;
                 rdfs:domain fmlo:Data ;
                 rdfs:range fmlo:LegalFramework ;
                 rdfs:label "protectedBy"@en ;
                 skos:altLabel "protegido por"@pt ;
                 skos:definition "Which legislation protects this attribute"@en .


###  http://www.usp.br/fmlo#protects
fmlo:protects rdf:type owl:ObjectProperty ,
                       owl:IrreflexiveProperty ;
              rdfs:domain fmlo:LegalFramework ;
              rdfs:range fmlo:Data ;
              rdfs:label "protects"@en ;
              skos:altLabel "protege"@pt ;
              skos:definition "Which attributes this legislation protects"@en .


###  http://www.usp.br/fmlo#receivesPropagationFrom
fmlo:receivesPropagationFrom rdf:type owl:ObjectProperty ,
                                      owl:TransitiveProperty ;
                             rdfs:domain fmlo:LifeCycleStage ;
                             rdfs:range fmlo:LifeCycleStage ;
                             rdfs:label "receivesPropagationFrom"@en ;
                             skos:altLabel "recebe propagação de"@pt ;
                             skos:definition "Which stage receives propagated bias"@en .


###  http://www.usp.br/fmlo#requiresAccessTo
fmlo:requiresAccessTo rdf:type owl:ObjectProperty ,
                               owl:IrreflexiveProperty ;
                      rdfs:domain fmlo:FairnessNotion ;
                      rdfs:range fmlo:SensitiveAttribute ;
                      rdfs:label "requiresAccessTo"@en ;
                      skos:altLabel "requer acesso a"@pt ;
                      skos:definition "Whether a notion requires access to protected attributes"@en .


###  http://www.usp.br/fmlo#requiresDataType
fmlo:requiresDataType rdf:type owl:ObjectProperty ,
                               owl:IrreflexiveProperty ;
                      rdfs:domain fmlo:FairnessMetric ;
                      rdfs:range fmlo:AttributeDataType ;
                      rdfs:label "requiresDataType"@en ;
                      skos:altLabel "requer tipo de dado"@pt ;
                      skos:definition "Specifies which attribute data type a fairness metric requires or is compatible with for its computation"@en .


###  http://www.usp.br/fmlo#satisfiesCriterion
fmlo:satisfiesCriterion rdf:type owl:ObjectProperty ,
                                 owl:IrreflexiveProperty ;
                        rdfs:domain fmlo:FairnessNotion ;
                        rdfs:range fmlo:FairnessCriterion ;
                        rdfs:label "satisfiesCriterion"@en ;
                        skos:altLabel "satisfaz critério"@pt ;
                        skos:definition "Which formal criterion a notion satisfies"@en .


###  http://www.usp.br/fmlo#scopeSupports
fmlo:scopeSupports rdf:type owl:ObjectProperty ,
                            owl:IrreflexiveProperty ;
                   rdfs:domain fmlo:SocioTechnicalScope ;
                   rdfs:range fmlo:NormativeDimension ;
                   rdfs:label "scopeSupports"@en ;
                   skos:altLabel "escopo suporta"@pt ;
                   skos:definition "Which normative principles operate at this scope"@en .


###  http://www.usp.br/fmlo#scopeUses
fmlo:scopeUses rdf:type owl:ObjectProperty ,
                        owl:IrreflexiveProperty ;
               rdfs:domain fmlo:SocioTechnicalScope ;
               rdfs:range fmlo:MethodologicalApproach ;
               rdfs:label "scopeUses"@en ;
               skos:altLabel "escopo usa"@pt ;
               skos:definition "Which methodological approaches are used at this scope level"@en .


###  http://www.usp.br/fmlo#systematizes
fmlo:systematizes rdf:type owl:ObjectProperty ,
                           owl:IrreflexiveProperty ;
                  rdfs:domain fmlo:StructuralMethodologicalContributions ;
                  rdfs:range fmlo:BiasSource ;
                  rdfs:label "systematizes"@en ;
                  skos:altLabel "sistematiza"@pt ;
                  skos:definition "Indica que uma contribuição estrutural ou metodológica organiza, estrutura ou formaliza o conhecimento sobre fontes de viés"@pt ,
                                  "Indicates that a structural or methodological contribution organizes, structures, or formalizes knowledge about bias sources"@en .


###  http://www.usp.br/fmlo#usesMetric
fmlo:usesMetric rdf:type owl:ObjectProperty ,
                         owl:IrreflexiveProperty ;
                rdfs:domain fmlo:BiasDiscoveryTechnique ;
                rdfs:range fmlo:FairnessMetric ;
                rdfs:label "usesMetric"@en ;
                skos:altLabel "usa métrica"@pt ;
                skos:definition "Which metric a discovery technique employs"@en .


###  http://www.usp.br/fmlo#usesNotion
fmlo:usesNotion rdf:type owl:ObjectProperty ,
                         owl:IrreflexiveProperty ;
                rdfs:domain fmlo:SocioTechnicalSolution ;
                rdfs:range fmlo:FairnessNotion ;
                rdfs:label "usesNotion"@en ;
                skos:altLabel "usa noção"@pt ;
                skos:definition "Which fairness notion a technique optimizes for"@en .


#################################################################
#    Data properties
#################################################################

###  http://www.usp.br/fmlo#hasAcronym
fmlo:hasAcronym rdf:type owl:DatatypeProperty ;
                rdfs:domain fmlo:FairnessMetric ;
                rdfs:range xsd:string ;
                rdfs:label "hasAcronym"@en ;
                skos:altLabel "tem acrônimo"@pt ;
                skos:definition "Acrônimo curto comumente usado para se referir à métrica (ex: SPD, EOD, DI)."@pt ,
                                "Short acronym commonly used to refer to the metric (e.g., SPD, EOD, DI)."@en .


###  http://www.usp.br/fmlo#hasCodeAvailable
fmlo:hasCodeAvailable rdf:type owl:DatatypeProperty ;
                      rdfs:domain fmlo:SocioTechnicalSolution ;
                      rdfs:range xsd:boolean ;
                      rdfs:label "hasCodeAvailable"@en ;
                      skos:altLabel "tem código disponível"@pt ;
                      skos:definition "Se o código fonte que implementa a solução está publicamente disponível."@pt ,
                                      "Whether source code implementing the solution is publicly available."@en .


###  http://www.usp.br/fmlo#hasDatasetUsed
fmlo:hasDatasetUsed rdf:type owl:DatatypeProperty ;
                    rdfs:domain fmlo:SocioTechnicalSolution ;
                    rdfs:range xsd:string ;
                    rdfs:label "hasDatasetUsed"@en ;
                    skos:altLabel "tem dataset utilizado"@pt ;
                    skos:definition "Name of the dataset used for evaluation of the solution."@en ,
                                    "Nome do dataset utilizado para avaliação da solução."@pt .


###  http://www.usp.br/fmlo#hasEnactmentYear
fmlo:hasEnactmentYear rdf:type owl:DatatypeProperty ;
                      rdfs:domain fmlo:LegalFramework ;
                      rdfs:range xsd:integer ;
                      rdfs:label "hasEnactmentYear"@en ;
                      skos:altLabel "tem ano de promulgação"@pt ;
                      skos:definition "Ano em que a legislação foi promulgada ou entrou em vigor."@pt ,
                                      "Year the legislation was enacted or came into force."@en .


###  http://www.usp.br/fmlo#hasFairnessThreshold
fmlo:hasFairnessThreshold rdf:type owl:DatatypeProperty ;
                          rdfs:domain fmlo:FairnessNotion ;
                          rdfs:range xsd:float ;
                          rdfs:label "hasFairnessThreshold"@en ;
                          skos:altLabel "tem limiar de fairness"@pt ;
                          skos:definition "Epsilon tolerance threshold for approximate satisfaction of the fairness notion."@en ,
                                          "Limiar de tolerância epsilon para satisfação aproximada da noção de fairness."@pt .


###  http://www.usp.br/fmlo#hasFormula
fmlo:hasFormula rdf:type owl:DatatypeProperty ;
                rdfs:domain fmlo:FairnessMetric ;
                rdfs:range xsd:string ;
                rdfs:label "hasFormula"@en ;
                skos:altLabel "tem fórmula"@pt ;
                skos:definition "Fórmula matemática usada para calcular a métrica."@pt ,
                                "Mathematical formula used to compute the metric."@en .


###  http://www.usp.br/fmlo#hasIdealValue
fmlo:hasIdealValue rdf:type owl:DatatypeProperty ;
                   rdfs:domain fmlo:FairnessMetric ;
                   rdfs:range xsd:float ;
                   rdfs:label "hasIdealValue"@en ;
                   skos:altLabel "tem valor ideal"@pt ;
                   skos:definition "Valor que indica fairness perfeita (ex: 0 para métricas baseadas em diferença, 1 para razão)."@pt ,
                                   "Value indicating perfect fairness (e.g., 0 for difference-based, 1 for ratio-based metrics)."@en .


###  http://www.usp.br/fmlo#hasImbalance
fmlo:hasImbalance rdf:type owl:DatatypeProperty ;
                  rdfs:domain fmlo:SensitiveAttribute ;
                  rdfs:range xsd:boolean ;
                  rdfs:label "hasImbalance"@en ;
                  skos:altLabel "tem desequilíbrio"@pt ;
                  skos:definition "Desequilíbrio entre grupos protegidos em um dataset para este atributo."@pt ,
                                  "Imbalance between protected groups in a dataset for this attribute."@en .


###  http://www.usp.br/fmlo#hasJurisdiction
fmlo:hasJurisdiction rdf:type owl:DatatypeProperty ;
                     rdfs:domain fmlo:LegalFramework ;
                     rdfs:range xsd:string ;
                     rdfs:label "hasJurisdiction"@en ;
                     skos:altLabel "tem jurisdição"@pt ;
                     skos:definition "Geographic jurisdiction where the legal document applies."@en ,
                                     "Jurisdição geográfica onde o documento legal se aplica."@pt .


###  http://www.usp.br/fmlo#hasMissingValues
fmlo:hasMissingValues rdf:type owl:DatatypeProperty ;
                      rdfs:domain fmlo:SensitiveAttribute ;
                      rdfs:range xsd:boolean ;
                      rdfs:label "hasMissingValues"@en ;
                      skos:altLabel "Tem dados faltantes"@pt ;
                      skos:definition "Indica se um conjunto de dados ou atributo contém valores faltantes que podem introduzir viés de medição ou representação"@pt ,
                                      "Indicates whether a dataset or attribute contains missing values that may introduce measurement or representation bias"@en .


###  http://www.usp.br/fmlo#hasNormalization
fmlo:hasNormalization rdf:type owl:DatatypeProperty ;
                      rdfs:domain fmlo:AttributeDataType ;
                      rdfs:range xsd:boolean ;
                      rdfs:label "hasNormalization"@en ;
                      skos:altLabel "Tem normalização"@pt ;
                      skos:definition "Indica se um procedimento de normalização foi aplicado aos dados, o que pode afetar a distribuição de valores entre grupos sensíveis"@pt ,
                                      "Indicates whether a normalization procedure has been applied to the data, which may affect the distribution of values across sensitive groups"@en .


###  http://www.usp.br/fmlo#hasNumberOfCategories
fmlo:hasNumberOfCategories rdf:type owl:DatatypeProperty ;
                           rdfs:domain fmlo:AttributeDataType ;
                           rdfs:range xsd:integer ;
                           rdfs:label "hasNumberOfCategories"@en ;
                           skos:altLabel "Tem número de categorias"@pt ;
                           skos:definition "Especifica o número de categorias ou níveis distintos que um atributo sensível pode assumir em um conjunto de dados."@pt ,
                                           "Specifies the number of distinct categories or levels that a sensitive attribute can assume in a dataset."@en .


###  http://www.usp.br/fmlo#hasOrder
fmlo:hasOrder rdf:type owl:DatatypeProperty ;
              rdfs:domain obo:BFO_0000015 ;
              rdfs:range xsd:integer ;
              rdfs:label "hasOrder"@en ;
              skos:altLabel "tem ordem"@pt ;
              skos:definition "Posição sequencial  no pipeline do ciclo de vida de ML"@pt ,
                              "Sequential position  in the ML lifecycle pipeline"@en .


###  http://www.usp.br/fmlo#hasPublicationYear
fmlo:hasPublicationYear rdf:type owl:DatatypeProperty ;
                        rdfs:domain fmlo:SocioTechnicalSolution ;
                        rdfs:range xsd:integer ;
                        rdfs:label "hasPublicationYear"@en ;
                        skos:altLabel "tem ano de publicação"@pt ;
                        skos:definition "Ano em que a solução foi publicada em um veículo revisado por pares."@pt ,
                                        "Year the solution was published in a peer-reviewed venue."@en .


###  http://www.usp.br/fmlo#hasRange
fmlo:hasRange rdf:type owl:DatatypeProperty ;
              rdfs:domain fmlo:FairnessMetric ;
              rdfs:range xsd:string ;
              rdfs:label "hasRange"@en ;
              skos:altLabel "tem intervalo"@pt ;
              skos:definition "Intervalo válido de saída da métrica (ex: \"[-1,1]\", \"[0,∞)\")."@pt ,
                              "Valid output range of the metric (e.g., \"[-1,1]\", \"[0,∞)\")."@en .


###  http://www.usp.br/fmlo#hasSampleSize
fmlo:hasSampleSize rdf:type owl:DatatypeProperty ;
                   rdfs:domain fmlo:SensitiveAttribute ;
                   rdfs:range xsd:nonNegativeInteger ;
                   rdfs:label "hasSampleSize"@en ;
                   skos:altLabel "Tem tamanho amostral"@pt ;
                   skos:definition "Records the number of instances in a dataset or subgroup, which is relevant for assessing representation bias and the statistical reliability of fairness evaluations"@en ,
                                   "Registra o número de instâncias em um conjunto de dados ou subgrupo, relevante para avaliar viés de representação e a confiabilidade estatística das avaliações de justiça"@pt .


#################################################################
#    Classes
#################################################################

###  http://purl.obolibrary.org/obo/BFO_0000001
obo:BFO_0000001 rdf:type owl:Class ;
                rdfs:subClassOf owl:Thing ;
                dc:identifier "BFO - 001" ;
                rdfs:isDefinedBy obo:bfo.owl ;
                rdfs:label "Entity"@en ;
                skos:altLabel "Entidade"@pt ;
                skos:definition "An entity is anything that exists or has existed or will exist. (axiom label in BFO2 Reference: [001-001])"@en ,
                                "Uma entidade é tudo o que existe ou existiu ou existirá. (Rótulo axioma na Referência da Referência da BFO2 : [001-001])"@pt ;
                skos:example "Julius Caesar; the Second World War; your body mass index; Verdi's Requiem"@en ,
                             "Júlio César; a Segunda Guerra Mundial; seu índice de massa corporal; o Réquiem de Verdi."@pt .


###  http://purl.obolibrary.org/obo/BFO_0000002
obo:BFO_0000002 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000001 ;
                owl:disjointWith obo:BFO_0000003 ;
                dc:identifier "BFO - 008" ;
                rdfs:isDefinedBy obo:bfo.owl ;
                rdfs:label "Continuant"@en ;
                skos:altLabel "Continuante"@pt ;
                skos:definition "A continuant is an entity that persists, endures, or continues to exist through time while maintaining its identity. (axiom label in BFO2 Reference: [008-002])"@en ,
                                "Um continuante é uma entidade que persiste, que se mantém, ou continua a existir ao longo do tempo, enquanto mantém sua identidade. (Rótulo axioma na Referência da BFO2 : [008-002])"@pt .


###  http://purl.obolibrary.org/obo/BFO_0000003
obo:BFO_0000003 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000001 ;
                dc:identifier "BFO 0 077" ;
                rdfs:isDefinedBy obo:bfo.owl ;
                rdfs:label "Occurent"@en ;
                skos:altLabel "Ocorrente"@pt ;
                skos:definition "An occurrent is an entity that unfolds itself in time or it is the instantaneous boundary of such an entity (for example a beginning or an ending) or it is a temporal or spatiotemporal region which such an entity occupies_temporal_region or occupies_spatiotemporal_region. (axiom label in BFO2 Reference: [077-002])"@en ,
                                "Um ocorrente é uma entidade que se desdobra no tempo ou é o limite instantâneo dessa entidade (por exemplo, um começar ou um finalizar) ou é uma região temporal ou espaço-temporal a qual tal entidade que ocupa uma região temporal (occupies_temporal_region) ou ocupa uma região espaço temporal (occupies_spatiotemporal_region). (Rótulo axioma em Referência da BFO2 : [077-002])"@pt .


###  http://purl.obolibrary.org/obo/BFO_0000004
obo:BFO_0000004 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000002 ;
                owl:disjointWith obo:BFO_0000020 ,
                                 obo:BFO_0000031 ;
                dc:identifier "BFO - 017" ;
                rdfs:isDefinedBy obo:bfo.owl ;
                rdfs:label "IndependentContinuant"@en ;
                skos:altLabel "Continuante independente"@pt ;
                skos:definition "b is an independent continuant = Def. b is a continuant which is such that there is no c and no t such that b s-depends_on c at t. (axiom label in BFO2 Reference: [017-002])"@en ,
                                "“b” é um continuante independente = Def. “b“ é um continuante tal que não existe nenhum “c“ e nenhum t de forma que b depende especificamente (s-depende) de “c“ em t. (Rótulo axioma em Referência da BFO2 : [017-002])"@pt ;
                skos:example "An atom; a molecule; an organism; a heart; a chair; the bottom right portion of a human torso; a leg; the interior of your mouth; a spatial region; an orchestra"@en ,
                             "Um átomo; uma molécula; um organismo; um coração; uma cadeira; a parte inferior direita do torso humano; uma perna; o interior da boca; uma região espacial; uma orquestra."@pt .


###  http://purl.obolibrary.org/obo/BFO_0000008
obo:BFO_0000008 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000003 ;
                owl:disjointWith obo:BFO_0000011 ,
                                 obo:BFO_0000015 ,
                                 obo:BFO_0000035 ;
                dc:identifier "BFO - 100" ;
                rdfs:isDefinedBy obo:bfo.owl ;
                rdfs:label "TemporalRegion"@en ;
                skos:altLabel "Região Temporal"@pt ;
                skos:definition "A temporal region is an occurrent entity that is part of time as defined relative to some reference frame. (axiom label in BFO2 Reference: [100-001])"@en ,
                                "Uma região temporal é uma entidade ocorrente que é parte do tempo, tal como definido em relação a algum quadro de referência. (Rótulo axioma em Referência da BFO2 : [100-001])"@pt .


###  http://purl.obolibrary.org/obo/BFO_0000011
obo:BFO_0000011 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000003 ;
                dc:identifier "BFO - 095" ;
                rdfs:isDefinedBy obo:bfo.owl ;
                rdfs:label "SpatiotemporalRegion"@en ;
                skos:altLabel "Região espaço-temporal"@pt ;
                skos:definition "A spatiotemporal region is an occurrent entity that is part of spacetime. (axiom label in BFO2 Reference: [095-001])"@en ,
                                "Uma região espaço-temporal é uma entidade ocorrente que faz parte do espaço-tempo. (Rótulo axioma em Referência da BFO2 : [095-001])"@pt ;
                skos:example "A região espaço-temporal ocupada pelo desenvolvimento de um tumor cancerígeno; a região espaço-temporal ocupada por um satélite em órbita."@pt ,
                             "The spatiotemporal region occupied by the development of a cancer tumour; the spatiotemporal region occupied by an orbiting satellite"@en .


###  http://purl.obolibrary.org/obo/BFO_0000015
obo:BFO_0000015 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000003 ;
                dc:identifier "BFO - 083" ;
                rdfs:isDefinedBy obo:bfo.owl ;
                rdfs:label "Process"@en ;
                skos:altLabel "Processo"@pt ;
                skos:definition "p is a process = Def. p is an occurrent that has temporal proper parts and for some time t, p s-depends_on some material entity at t. (axiom label in BFO2 Reference: [083-003])"@en ,
                                "p é um processo = Def. “p” é um ocorrente que tem partes próprias temporais e por algum tempo t, “p” depende especificamente (s-depends_on) de alguma entidade material em t. (Rótulo axioma em Referência da BFO2: [083-003])"@pt ;
                skos:example "An act of selling; the life of an organism; a process of sleeping; a process of cell-division; a beating of the heart; a process of meiosis; the taxiing of an aircraft; the programming of a computer"@en ,
                             "Um ato de venda; a vida de um organismo; o processo de dormir; o processo de divisão celular; uma batida do coração; o processo de meiose; o táxi de uma aeronave; a programação de um computador."@pt .


###  http://purl.obolibrary.org/obo/BFO_0000016
obo:BFO_0000016 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000017 ;
                dc:identifier "BFO - 062" ;
                rdfs:isDefinedBy obo:bfo.owl ;
                rdfs:label "Disposition"@en ;
                skos:altLabel "Disposição"@pt ;
                skos:definition "b is a disposition means: b is a realizable entity & b’s bearer is some material entity & b is such that if it ceases to exist, then its bearer is physically changed, & b’s realization occurs when and because this bearer is in some special physical circumstances, & this realization occurs in virtue of the bearer’s physical make-up. (axiom label in BFO2 Reference: [062-002])"@en ,
                                "“b” é uma disposição: “b” é uma entidade realizável & o portador de “b” é uma entidade material & “b” é tal que, se ele deixa de existir, então seu portador muda fisicamente & realização de “b” ocorre quando e porque este portador está em alguma circunstância física especial & esta realização ocorre em virtude da composição física do portador. (Rótulo do axioma na Referência da BFO2: [062-002])"@pt ;
                skos:example "An atom of element X has the disposition to decay to an atom of element Y; the cell wall is disposed to transport cellular material through endocytosis and exocytosis; certain people have a predisposition to colon cancer; children are innately disposed to categorize objects in certain ways"@en ,
                             "Um átomo do elemento X tem a tendência de se decompor em um átomo do elemento Y; a parede celular está disposta a transportar material celular por meio de endocitose e exocitose; certas pessoas têm predisposição ao câncer de cólon; crianças são inatamente predispostas a categorizar objetos de certas maneiras."@pt .


###  http://purl.obolibrary.org/obo/BFO_0000017
obo:BFO_0000017 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000020 ;
                owl:disjointWith obo:BFO_0000019 ;
                dc:identifier "BFO - 058" ;
                rdfs:isDefinedBy obo:bfo.owl ;
                rdfs:label "RealizableEntity"@en ;
                skos:altLabel "Entidade realizável"@pt ;
                skos:definition "Dizer que “b” é uma entidade realizável é dizer que “b” é um continuante especificamente dependente, o qual é inerente a algum continuante independente, e ainda: i) não é uma região espacial; ii) é um tipo de instância que é realizada em certos tipos de processos correlacionados. (Rótulo axioma em Referência da BFO2 : [058-002])"@pt ,
                                "To say that b is a realizable entity is to say that b is a specifically dependent continuant that inheres in some independent continuant which is not a spatial region and is of a type instances of which are realized in processes of a correlated type. (axiom label in BFO2 Reference: [058-002])"@en ;
                skos:example "O papel de um médico; o papel desta fronteira em delimitar o encontro entre Utah e Colorado; a função dos seus órgãos reprodutivos; a capacidade do seu sangue de coagular; a capacidade deste pedaço de metal de conduzir eletricidade."@pt ,
                             "The role of being a doctor; the role of this boundary to delineate where Utah and Colorado meet; the function of your reproductive organs; the disposition of your blood to coagulate; the disposition of this piece of metal to conduct electricity"@en .


###  http://purl.obolibrary.org/obo/BFO_0000019
obo:BFO_0000019 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000020 ;
                dc:identifier "BFO - 055" ;
                rdfs:isDefinedBy obo:bfo.owl ;
                rdfs:label "Quality"@en ;
                skos:altLabel "Qualidade"@pt ;
                skos:definition "Uma qualidade é um continuante especificamente dependente que, ao contrário de papéis e disposições, não necessita de qualquer processo adicional para ser realizado. (Rótulo axioma em Referência da BFO2 : [055-001])"@pt ,
                                "a quality is a specifically dependent continuant that, in contrast to roles and dispositions, does not require any further process in order to be realized. (axiom label in BFO2 Reference: [055-001])"@en ;
                skos:example "A cor de um tomate; a temperatura ambiente desta porção de ar; a circunferência da sua cintura; o formato do seu nariz; o formato da sua narina; a massa deste pedaço de ouro."@pt ,
                             "The colour of a tomato; the ambient temperature of this portion of air; the length of the circumference of your waist; the shape of your nose; the shape of your nostril; the mass of this piece of gold"@en .


###  http://purl.obolibrary.org/obo/BFO_0000020
obo:BFO_0000020 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000002 ;
                dc:identifier "BFO - 050" ;
                rdfs:isDefinedBy obo:bfo.owl ;
                rdfs:label "SpecificallyDependentContinuant"@en ;
                skos:altLabel "Continuante especificamente dependente"@pt ;
                skos:definition "b is a specifically dependent continuant = Def. b is a continuant & there is some independent continuant c which is not a spatial region and which is such that b s-depends_on c at every time t during the course of b’s existence. (axiom label in BFO2 Reference: [050-003])"@en ,
                                "“b” é um continuante especificamente dependente = Def. “b” é um continuante e existe um continuante independente “c” que não é uma região espacial, o qual é tal que b “depende especificamente de  c”  em cada momento t no curso da existência de “b”. (Rótulo axioma em Referência da BFO2 : [050-003])"@pt ;
                skos:example "a dependência mútua do papel  de predador e do papel de presa desempenhado por dois organismos em uma determinada interação"@pt ,
                             "the mutual dependence of the role predator and the role prey as played by two organisms in a given interaction"@en .


###  http://purl.obolibrary.org/obo/BFO_0000031
obo:BFO_0000031 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000002 ;
                dc:identifier "BFO - 074" ;
                rdfs:isDefinedBy obo:bfo.owl ;
                rdfs:label "GenericallyDependentContinuant"@en ;
                skos:altLabel "Continuante genericamente dependente"@pt ;
                skos:definition "b is a generically dependent continuant = Def. b is a continuant that g-depends_on one or more other entities. (axiom label in BFO2 Reference: [074-001])"@en ,
                                "“b” é um continuante genericamente dependente = Def. “b“ é um continuante que depende genericamente (g-depends) de uma ou mais outras entidades. (Rótulo axioma em Referência da BFO2 : [074-001])"@pt ;
                skos:example "o arquivo pdf em seu notebook, o arquivo pdf que é uma cópia do mesmo arquivo pdf mencionado no meu notebook"@pt ,
                             "the pdf file on your laptop, the pdf file that is a copy thereof on my laptop"@en .


###  http://purl.obolibrary.org/obo/BFO_0000035
obo:BFO_0000035 rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000003 ;
                dc:identifier "BFO - 084" ;
                rdfs:isDefinedBy obo:bfo.owl ;
                rdfs:label "ProcessBoundary"@en ;
                skos:altLabel "Limite de processo"@pt ;
                skos:definition "p is a process boundary =Def. p is a temporal part of a process & p has no proper temporal parts. (axiom label in BFO2 Reference: [084-001])"@en ,
                                "p é um limite de processo = Def. “p” é uma parte temporal do processo e “p” não tem partes próprias temporais. (Rótulo axioma em Referência da BFO2 : [084-001])"@pt ;
                skos:example "a fronteira entre o 2º e o 3º ano de sua vida."@pt ,
                             "the boundary between the 2nd and 3rd year of your life."@en .


###  http://www.usp.br/fmlo#AIRegulation
fmlo:AIRegulation rdf:type owl:Class ;
                  rdfs:subClassOf fmlo:LegalFramework ;
                  rdfs:isDefinedBy ""@en ;
                  rdfs:label "AIRegulation"@en ;
                  skos:altLabel "Regulação de IA"@pt ;
                  skos:definition "A type of legal document that establishes rules and mechanisms for governing AI systems."@en ,
                                  "Um tipo de documento legal que estabelece regras e mecanismos para governança de sistemas de IA."@pt .


###  http://www.usp.br/fmlo#AccuracyRate
fmlo:AccuracyRate rdf:type owl:Class ;
                  rdfs:subClassOf fmlo:StatisticalFamily ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty fmlo:hasCriterion ;
                                    owl:hasValue fmlo:Separation_i
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty fmlo:isFamilyOf ;
                                    owl:hasValue fmlo:Extrinsic_i
                                  ] ;
                  rdfs:isDefinedBy "M. Hardt, E. Price, and N. Srebro, ‘‘Equality of opportunity in supervised learning,’’ in 30th Conf. on Neural Inf. Processing Sys., pp. 1–9, 2016."@en ;
                  rdfs:label "AccuracyRate"@en ;
                  skos:altLabel "Taxa de Acurácia"@pt ;
                  skos:definition "Família estatística que avalia predições em relação à sua precisão através de taxas de acerto e erro."@pt ,
                                  "Statistical family that equalizes predictive performance or error rates across protected groups."@en .


###  http://www.usp.br/fmlo#Age
fmlo:Age rdf:type owl:Class ;
         rdfs:subClassOf fmlo:SensitiveAttribute ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty fmlo:isClassifiedAs ;
                           owl:hasValue fmlo:ProtectedCharacteristic_i
                         ] ;
         rdfs:isDefinedBy "Equality and Human Rights Commission (EHRC). \"Protected characteristics.\" Equality Act 2010. Disponível em: https://www.equalityhumanrights.com/equality/equality-act-2010/protected-characteristics"@en ;
         rdfs:label "Age"@en ;
         skos:altLabel "Idade"@pt ;
         skos:definition "An attribute representing the particular age or age range of an individual."@en ,
                         "Um atributo representando a idade ou faixa etária particular de um indivíduo."@pt .


###  http://www.usp.br/fmlo#AggregationBias
fmlo:AggregationBias rdf:type owl:Class ;
                     rdfs:subClassOf fmlo:BiasSource ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty fmlo:originatesIn ;
                                       owl:hasValue fmlo:ModelDevelopment_i
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty fmlo:originatesInPhase ;
                                       owl:hasValue fmlo:InProcessing_i
                                     ] ;
                     rdfs:isDefinedBy "Harini Suresh and John Guttag. 2021. A Framework for Understanding Sources of Harm throughout the Machine Learning Life Cycle. In Proceedings of the 1st ACM Conference on Equity and Access in Algorithms, Mechanisms, and Optimization (EAAMO '21). Association for Computing Machinery, New York, NY, USA, Article 17, 1–9. https://doi.org/10.1145/3465416.3483305."@en ;
                     rdfs:label "AggregationBias"@en ;
                     skos:altLabel "Viés de agregação"@pt ;
                     skos:definition "Occurs when a one-size-fits-all model is used for data in which there are underlying groups that should be considered differently."@en ,
                                     "Ocorre quando um modelo único é usado para dados nos quais existem grupos subjacentes que deveriam ser considerados de forma diferente."@pt .


###  http://www.usp.br/fmlo#AnonymousData
fmlo:AnonymousData rdf:type owl:Class ;
                   rdfs:subClassOf fmlo:Data ;
                   rdfs:isDefinedBy "General Data Protection Regulation (GDPR) - Recital 26. https://gdpr.eu/recital-26-not-applicable-to-anonymous-data/"@en ;
                   rdfs:label "AnonymousData"@en ;
                   skos:altLabel "Dado Anônimo"@pt ;
                   skos:definition "Dado que não pode ser conectado a uma pessoa natural identificada ou identificável."@pt ,
                                   "Data is termed to be anonymous if it cannot be connected to an identified or identifiable natural person."@en .


###  http://www.usp.br/fmlo#AntiDiscrimination
fmlo:AntiDiscrimination rdf:type owl:Class ;
                        rdfs:subClassOf fmlo:LegalFramework ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty fmlo:protects ;
                                          owl:hasValue fmlo:ProtectedCharacteristic_i
                                        ] ;
                        rdfs:isDefinedBy ""@en ;
                        rdfs:label "AntiDiscrimination"@en ;
                        skos:altLabel "Lei Antidiscriminação"@pt ;
                        skos:definition "A type of legal document that regulates the collection, processing, storage, and sharing of personal data, aiming to protect individual privacy and fundamental rights."@en ,
                                        "Um tipo de documento legal que regulamenta a coleta, o processamento, o armazenamento e o compartilhamento de dados pessoais, visando proteger a privacidade individual e os direitos fundamentais."@pt .


###  http://www.usp.br/fmlo#ApplicationDomain
fmlo:ApplicationDomain rdf:type owl:Class ;
                       rdfs:subClassOf obo:BFO_0000031 ;
                       rdfs:isDefinedBy "Fairness at Risk: Bias-Discovery and Mitigation Solutions"@en ;
                       rdfs:label "ApplicationDomain"@en ;
                       skos:altLabel "Domínio de Aplicação"@pt ;
                       skos:definition "A real-world sector or field in which ML-based fairness solutions are applied and evaluated."@en ,
                                       "Um setor ou campo do mundo real no qual soluções de fairness baseadas em ML são aplicadas e avaliadas."@pt .


###  http://www.usp.br/fmlo#AssociationBased
fmlo:AssociationBased rdf:type owl:Class ;
                      rdfs:subClassOf fmlo:StatisticalFamily ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty fmlo:hasCriterion ;
                                        owl:hasValue fmlo:Independence_i
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty fmlo:isFamilyOf ;
                                        owl:hasValue fmlo:Intrinsic_i
                                      ] ;
                      rdfs:isDefinedBy "I. Dominguez-Catena, D. Paternain, and M. Galar, ‘‘Metrics for dataset demographic bias: A case study on facial expression recognition,’’ IEEE Transactions on Pattern Analysis and Machine Int., vol. 46, no. 8, pp. 5209–5226, 2024."@en ;
                      rdfs:label "AssociationBased"@en ;
                      skos:altLabel "Baseado em Associação"@pt ;
                      skos:definition "Família estatística que avalia fairness através de medidas de associação entre atributos."@pt ,
                                      "Statistical family that quantifies systematic statistical dependencies between protected attributes and semantic categories or labels encoded in data or representations, capturing stereotypical co-occurrence patterns independently of downstream predictions."@en .


###  http://www.usp.br/fmlo#AttributeDataType
fmlo:AttributeDataType rdf:type owl:Class ;
                       rdfs:subClassOf obo:BFO_0000031 ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty fmlo:isTypeOfData ;
                                         owl:someValuesFrom fmlo:SensitiveAttribute
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty fmlo:isVulnerableTo ;
                                         owl:someValuesFrom fmlo:BiasSource
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty fmlo:hasNormalization ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:boolean
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty fmlo:hasNumberOfCategories ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onDataRange xsd:integer
                                       ] ;
                       rdfs:isDefinedBy "Statistics ontology (STATO)"@en ;
                       rdfs:label "AttributeDataType"@en ;
                       skos:altLabel "Tipo de Dado do Atributo"@pt ,
                                     "variableType"@en ;
                       skos:closeMatch obo:STATO_0000258 ;
                       skos:definition "A classification that defines the structure and nature of values an attribute can assume in data analysis and machine learning, determining how it can be processed and interpreted."@en ,
                                       "Uma classificação que define a estrutura e natureza dos valores que um atributo pode assumir em análise de dados e aprendizado de máquina, determinando como ele pode ser processado e interpretado."@pt .


###  http://www.usp.br/fmlo#BaseRate
fmlo:BaseRate rdf:type owl:Class ;
              rdfs:subClassOf fmlo:StatisticalFamily ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty fmlo:hasCriterion ;
                                owl:hasValue fmlo:Independence_i
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty fmlo:isFamilyOf ;
                                owl:hasValue fmlo:Extrinsic_i
                              ] ;
              rdfs:isDefinedBy "T. Calders and S. Verwer, ‘‘Three naive bayes approaches for discrimination-free classification,’’ Data Mining and Knowledge Discovery, vol. 21, pp. 277–292, 2010."@en ;
              rdfs:label "BaseRate"@en ;
              skos:altLabel "Taxa Base"@pt ;
              skos:definition "Família estatística que avalia fairness com base nas taxas base de diferentes grupos."@pt ,
                              "Statistical family that targets parity in decision distributions (e.g., selection rates) across protected groups"@en .


###  http://www.usp.br/fmlo#Bias
fmlo:Bias rdf:type owl:Class ;
          rdfs:subClassOf obo:BFO_0000031 ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty fmlo:hasSource ;
                            owl:someValuesFrom fmlo:BiasSource
                          ] ;
          rdfs:isDefinedBy "Fairness at Risk: Where Bias Emerges in Machine Learning"@en ;
          rdfs:label "Bias"@en ;
          skos:altLabel "Viés"@pt ;
          skos:definition "Discriminação sistemática e injusta contra certos indivíduos ou grupos em favor de outros."@pt ,
                          "Systematically and unfairly discriminate against certain individuals or groups of individuals in favor of others."@en .


###  http://www.usp.br/fmlo#BiasDiscoveryTechnique
fmlo:BiasDiscoveryTechnique rdf:type owl:Class ;
                            rdfs:subClassOf fmlo:SocioTechnicalSolution ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty fmlo:appliesToPhase ;
                                              owl:someValuesFrom fmlo:ProcessingPhase
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty fmlo:appliesToStage ;
                                              owl:someValuesFrom fmlo:LifeCycleStage
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty fmlo:evaluatesWith ;
                                              owl:someValuesFrom fmlo:FairnessMetric
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty fmlo:discovers ;
                                              owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass fmlo:BiasSource
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty fmlo:discoversInStage ;
                                              owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass fmlo:LifeCycleStage
                                            ] ;
                            rdfs:isDefinedBy "Fairness at Risk: Bias-Discovery and Mitigation Solutions"@en ;
                            rdfs:label "BiasDiscoveryTechnique"@en ;
                            skos:altLabel "Técnica de Descoberta de Viés"@pt ;
                            skos:definition "Techniques designed to analyze, diagnose, or measure bias in datasets or models without attempting mitigation. They are diagnostic: the contribution is the identification or quantification of bias."@en ,
                                            "Técnicas projetadas para analisar, diagnosticar ou medir viés em datasets ou modelos sem tentar mitigação."@pt .


###  http://www.usp.br/fmlo#BiasMitigationTechnique
fmlo:BiasMitigationTechnique rdf:type owl:Class ;
                             rdfs:subClassOf fmlo:SocioTechnicalSolution ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty fmlo:appliesToPhase ;
                                               owl:someValuesFrom fmlo:ProcessingPhase
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty fmlo:appliesToStage ;
                                               owl:someValuesFrom fmlo:LifeCycleStage
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty fmlo:evaluatesWith ;
                                               owl:someValuesFrom fmlo:FairnessMetric
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty fmlo:mitigates ;
                                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass fmlo:BiasSource
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty fmlo:usesNotion ;
                                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass fmlo:FairnessNotion
                                             ] ;
                             rdfs:isDefinedBy "Fairness at Risk: Bias-Discovery and Mitigation Solutions"@en ;
                             rdfs:label "BiasMitigationTechnique"@en ;
                             skos:altLabel "Técnica de Mitigação de Viés"@pt ;
                             skos:definition "Solutions that propose an active intervention to reduce or eliminate unfairness in ML systems. They are prescriptive: the contribution is the reduction of bias through intervention in the ML lifecycle."@en ,
                                             "Soluções que propõem uma intervenção ativa para reduzir ou eliminar injustiças em sistemas de ML."@pt .


###  http://www.usp.br/fmlo#BiasSource
fmlo:BiasSource rdf:type owl:Class ;
                rdfs:subClassOf obo:BFO_0000031 ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty fmlo:originatesIn ;
                                  owl:someValuesFrom fmlo:LifeCycleStage
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty fmlo:affectsAttribute ;
                                  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass fmlo:SensitiveAttribute
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty fmlo:originatesInPhase ;
                                  owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass fmlo:ProcessingPhase
                                ] ;
                rdfs:isDefinedBy "Harini Suresh and John Guttag. 2021. A Framework for Understanding Sources of Harm throughout the Machine Learning Life Cycle. In Proceedings of the 1st ACM Conference on Equity and Access in Algorithms, Mechanisms, and Optimization (EAAMO '21). Association for Computing Machinery, New York, NY, USA, Article 17, 1–9. https://doi.org/10.1145/3465416.3483305"@en ;
                rdfs:label "BiasSource"@en ;
                skos:altLabel "Fonte de viés"@pt ,
                              "SourceOfBias"@en ;
                skos:definition "A stage or mechanism in the ML pipeline at which bias originates or is introduced."@en ,
                                "Um estágio ou mecanismo no pipeline de ML no qual o viés se origina ou é introduzido."@pt .


###  http://www.usp.br/fmlo#Binary
fmlo:Binary rdf:type owl:Class ;
            rdfs:subClassOf fmlo:Categorical ;
            rdfs:isDefinedBy "Statistics ontology (STATO)"@en ;
            rdfs:label "Binary"@en ;
            skos:altLabel "Binário"@pt ,
                          "dichotomous"@en ;
            skos:closeMatch obo:STATO_0000090 ;
            skos:definition "A categorical data type restricted to exactly two mutually exclusive categories, often used to represent dichotomous attributes."@en ,
                            "Tipo de dado categórico restrito a exatamente duas categorias mutuamente exclusivas, frequentemente usado para representar atributos dicotômicos."@pt .


###  http://www.usp.br/fmlo#Calibration
fmlo:Calibration rdf:type owl:Class ;
                 rdfs:subClassOf fmlo:FairnessNotion ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty fmlo:belongsToFamily ;
                                   owl:hasValue fmlo:CalibrationRate_i
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty fmlo:hasEthicalDimension ;
                                   owl:hasValue fmlo:DistributiveJustice_i
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty fmlo:hasEvaluationLocus ;
                                   owl:hasValue fmlo:Extrinsic_i
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty fmlo:hasMethodologicalApproach ;
                                   owl:hasValue fmlo:Statistical_i
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty fmlo:hasNormativePrinciple ;
                                   owl:hasValue fmlo:DisparateImpact_i
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty fmlo:hasSocioTechnicalScope ;
                                   owl:hasValue fmlo:Group_i
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty fmlo:hasTradeOffWith ;
                                   owl:hasValue fmlo:PerformanceOriented_i
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty fmlo:isIncompatibleWith ;
                                   owl:hasValue fmlo:EqualizedOdds_i
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty fmlo:isIncompatibleWith ;
                                   owl:hasValue fmlo:StatisticalParity_i
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty fmlo:satisfiesCriterion ;
                                   owl:hasValue fmlo:Sufficiency_i
                                 ] ;
                 rdfs:isDefinedBy "Pleiss, G., Raghavan, M., Wu, F., Kleinberg, J., & Weinberger, K. Q. (2017). On fairness and calibration. Advances in neural information processing systems, 30."@en ;
                 rdfs:label "Calibration"@en ;
                 skos:altLabel "Calibração"@pt ;
                 skos:definition "Fairness notion enforcing the Sufficiency condition, requiring that for any given predicted score, the probability of the true outcome is independent of the protected attribute, ensuring predicted probabilities have the same meaning across groups."@en ,
                                 "Noção de fairness que requer a condição de suficiência, exigindo que para qualquer valor de pontuação previsto, a probabilidade do resultado real seja a mesma entre grupos."@pt .


###  http://www.usp.br/fmlo#CalibrationRate
fmlo:CalibrationRate rdf:type owl:Class ;
                     rdfs:subClassOf fmlo:StatisticalFamily ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty fmlo:hasCriterion ;
                                       owl:hasValue fmlo:Sufficiency_i
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty fmlo:isFamilyOf ;
                                       owl:hasValue fmlo:Extrinsic_i
                                     ] ;
                     rdfs:isDefinedBy "J. Kleinberg, S. Mullainathan, and M. Raghavan, ‘‘Inherent trade-offs in the fair determination of risk scores,’’ arXiv preprint arXiv:1609.05807, 2016."@en ;
                     rdfs:label "CalibrationRate"@en ;
                     skos:altLabel "Taxa de calibração"@pt ;
                     skos:definition "Família estatística que requer interpretações probabilísticas consistentes entre grupos."@pt ,
                                     "Statistical family that enforces consistent probabilistic interpretations across groups"@en .


###  http://www.usp.br/fmlo#Categorical
fmlo:Categorical rdf:type owl:Class ;
                 rdfs:subClassOf fmlo:AttributeDataType ;
                 owl:disjointWith fmlo:Continuous ;
                 rdfs:isDefinedBy "Statistics ontology (STATO) ."@en ;
                 rdfs:label "Categorical"@en ;
                 skos:altLabel "Categórico"@pt ,
                               "nominal"@en ;
                 skos:closeMatch obo:STATO_0000252 ;
                 skos:definition "A data type whose values are drawn from a finite set of distinct categories representing qualitative differences, without necessarily implying order."@en ,
                                 "Tipo de dado cujos valores são extraídos de um conjunto finito de categorias distintas representando diferenças qualitativas, sem necessariamente implicar ordem."@pt .


###  http://www.usp.br/fmlo#Causal
fmlo:Causal rdf:type owl:Class ;
            rdfs:subClassOf fmlo:MethodologicalApproach ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty fmlo:approachHasLocus ;
                              owl:hasValue fmlo:Extrinsic_i
                            ] ;
            rdfs:isDefinedBy "M. J. Kusner, J. Loftus, C. Russell, and R. Silva, ‘‘Counterfactual fairness,’’ in 31st Annual Conf. on Neural Inf. Processing Sys., 2017."@en ;
            rdfs:label "Causal"@en ;
            skos:altLabel "Causal"@pt ;
            skos:definition "Abordagem metodológica baseada em raciocínio causal e modelos de equações estruturais."@pt ,
                            "Methodological approach relying on structural causal models and counterfactual reasoning to assess whether decisions would remain invariant under hypothetical interventions on protected attributes, addressing forms of unfairness that may be obscured by purely observational criteria."@en .


###  http://www.usp.br/fmlo#CausalEffectBased
fmlo:CausalEffectBased rdf:type owl:Class ;
                       rdfs:subClassOf fmlo:MetricOperationalization ;
                       rdfs:isDefinedBy "M. J. Kusner, J. Loftus, C. Russell, and R. Silva, ‘‘Counterfactual fairness,’’ in 31st Annual Conf. on Neural Inf. Processing Sys., 2017."@en ;
                       rdfs:label "CausalEffectBased"@en ;
                       skos:altLabel "Baseado em Efeito Causal"@pt ;
                       skos:definition "Operacionalização que quantifica fairness medindo mudança de predição sob intervenções contrafactuais."@pt ,
                                       "Operationalization that quantifies fairness by measuring prediction change under counterfactual interventions."@en .


###  http://www.usp.br/fmlo#CognitiveBias
fmlo:CognitiveBias rdf:type owl:Class ;
                   rdfs:subClassOf fmlo:BiasSource ,
                                   [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                            owl:onProperty fmlo:originatesIn ;
                                                            owl:hasValue fmlo:DataCollection_i
                                                          ]
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty fmlo:originatesIn ;
                                                            owl:hasValue fmlo:DataPreparation_i
                                                          ]
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty fmlo:originatesIn ;
                                                            owl:hasValue fmlo:ModelDeployment_i
                                                          ]
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty fmlo:originatesIn ;
                                                            owl:hasValue fmlo:ModelDevelopment_i
                                                          ]
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty fmlo:originatesIn ;
                                                            owl:hasValue fmlo:ModelEvaluation_i
                                                          ]
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty fmlo:originatesIn ;
                                                            owl:hasValue fmlo:ModelPostProcessing_i
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ,
                                   [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                            owl:onProperty fmlo:originatesInPhase ;
                                                            owl:hasValue fmlo:InProcessing_i
                                                          ]
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty fmlo:originatesInPhase ;
                                                            owl:hasValue fmlo:PostProcessing_i
                                                          ]
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty fmlo:originatesInPhase ;
                                                            owl:hasValue fmlo:PreProcessing_i
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty fmlo:amplifies ;
                                     owl:someValuesFrom fmlo:BiasSource
                                   ] ;
                   rdfs:isDefinedBy "Tversky, A., & Kahneman, D. (1974). Judgment under Uncertainty: Heuristics and Biases: Biases in judgments reveal some heuristics of thinking under uncertainty. science, 185(4157), 1124-1131."@en ;
                   rdfs:label "CognitiveBias"@en ;
                   skos:altLabel "Viés cognitivo"@pt ;
                   skos:definition "Disposições ou inclinações cognitivas sistemáticas no pensamento e raciocínio humanos que influenciam a forma como as pessoas percebem, interpretam e agem com base nas informações, e que frequentemente não estão em conformidade com os princípios da lógica, do raciocínio probabilístico e da plausibilidade."@pt ,
                                   "Systematic cognitive dispositions or inclinations in human thinking and reasoning that influencing how people perceive, interpret, and act on information, and often do not comply with the tenets of logic, probability reasoning, and plausibility"@en .


###  http://www.usp.br/fmlo#ConceptualFramework
fmlo:ConceptualFramework rdf:type owl:Class ;
                         rdfs:subClassOf fmlo:StructuralMethodologicalContributions ;
                         rdfs:isDefinedBy "Fairness at Risk: Bias-Discovery and Mitigation Solutions"@en ;
                         rdfs:label "ConceptualFramework"@en ;
                         skos:altLabel "Framework Conceitual"@pt ;
                         skos:definition "Contribuições estruturais que formalizam questões de fairness em modelos coerentes ou procedimentos."@pt ,
                                         "Structural contributions that formalize fairness-related questions into coherent models, workflows, or procedures for reasoning about bias and integrating fairness into ML pipelines."@en .


###  http://www.usp.br/fmlo#Consistency
fmlo:Consistency rdf:type owl:Class ;
                 rdfs:subClassOf fmlo:NormativeDimension ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty fmlo:appliesAtScope ;
                                   owl:hasValue fmlo:Individual_i
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty fmlo:isPrincipleOf ;
                                   owl:hasValue fmlo:ProceduralJustice_i
                                 ] ;
                 rdfs:isDefinedBy "C. Dwork, M. Hardt, T. Pitassi, O. Reingold, and R. Zemel, ‘‘Fairness through awareness,’’ in 3rd Innovations in Theoretical Computer Sci. Conf., pp. 214–226, 2012."@en ;
                 rdfs:label "Consistency"@en ;
                 skos:altLabel "Consistência"@pt ;
                 skos:definition "Normative-philosophical principle requiring decision stability relative to individual similarity, operationalizing Aristotle's precept that \"likes should be treated alike.\" Grounded in the Lipschitz condition, it posits that individuals close in the metric space must map to similar probability distributions in the decision space."@en ,
                                 "Princípio normativo que requer tratamento consistente de indivíduos similares."@pt .


###  http://www.usp.br/fmlo#Continuous
fmlo:Continuous rdf:type owl:Class ;
                rdfs:subClassOf fmlo:AttributeDataType ;
                rdfs:isDefinedBy "Statistics ontology (STATO)."@en ;
                rdfs:label "Continuous"@en ;
                skos:altLabel "Contínuo"@pt ;
                skos:closeMatch obo:STATO_0000251 ;
                skos:definition "A data type whose values lie on a continuous numeric scale."@en ,
                                "Tipo de dado cujos valores estão em uma escala numérica contínua."@pt .


###  http://www.usp.br/fmlo#CounterfactualFairness
fmlo:CounterfactualFairness rdf:type owl:Class ;
                            rdfs:subClassOf fmlo:FairnessNotion ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty fmlo:hasEthicalDimension ;
                                              owl:hasValue fmlo:ProceduralJustice_i
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty fmlo:hasEvaluationLocus ;
                                              owl:hasValue fmlo:Extrinsic_i
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty fmlo:hasMethodologicalApproach ;
                                              owl:hasValue fmlo:Causal_i
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty fmlo:hasNormativePrinciple ;
                                              owl:hasValue fmlo:DisparateTreatment_i
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty fmlo:hasSocioTechnicalScope ;
                                              owl:hasValue fmlo:Individual_i
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty fmlo:satisfiesCriterion ;
                                              owl:hasValue fmlo:Invariance_i
                                            ] ;
                            rdfs:isDefinedBy "M. J. Kusner, J. Loftus, C. Russell, and R. Silva, ‘‘Counterfactual fairness,’’ in 31st Annual Conf. on Neural Inf. Processing Sys., 2017."@en ;
                            rdfs:label "CounterfactualFairness"@en ;
                            skos:altLabel "Justiça Contrafactual"@pt ;
                            skos:definition "Fairness notion requiring that the predicted outcome remains unchanged for the same individual under a counterfactual intervention on the protected attribute, capturing causal independence of the prediction from A."@en ,
                                            "Noção de fairness que requer que o resultado previsto permaneça inalterado para o mesmo indivíduo em um mundo contrafactual onde o atributo protegido fosse diferente."@pt .


###  http://www.usp.br/fmlo#CriticalAnalysis
fmlo:CriticalAnalysis rdf:type owl:Class ;
                      rdfs:subClassOf fmlo:StructuralMethodologicalContributions ;
                      rdfs:isDefinedBy "Fairness at Risk: Bias-Discovery and Mitigation Solutions"@en ;
                      rdfs:label "CriticalAnalysis"@en ;
                      skos:altLabel "Análise Crítica"@pt ;
                      skos:definition "Contribuições estruturais que investigam os pressupostos fundamentais do campo."@pt ,
                                      "Structural contributions that investigate the fields foundational assumptions, bridging technical metrics and ethical principles by questioning how systemic inequities are embedded in AI systems."@en .


###  http://www.usp.br/fmlo#Data
fmlo:Data rdf:type owl:Class ;
          rdfs:subClassOf obo:BFO_0000031 ;
          rdfs:isDefinedBy "Organization for Economic Cooperation and Development (OECD). Recommendation of the Council on Enhancing Access to and Sharing of Data. Paris: OCDE, 2021. Available at: https://legalinstruments.oecd.org/en/instruments/OECD-LEGAL-0463."@en ;
          rdfs:label "Data"@en ;
          skos:altLabel "Dados"@pt ;
          skos:definition "Refere-se a informações registradas em formato estruturado ou não estruturado usadas em sistemas de ML."@pt ,
                          "Refers to recorded information in structured or unstructured format used in ML systems."@en .


###  http://www.usp.br/fmlo#DataCentricTechnique
fmlo:DataCentricTechnique rdf:type owl:Class ;
                          rdfs:subClassOf fmlo:ExploratoryTechnique ;
                          rdfs:isDefinedBy "Fairness at Risk: Bias-Discovery and Mitigation Solutions"@en ;
                          rdfs:label "DataCentricTechnique"@en ;
                          skos:altLabel "Técnica Centrada em Dados"@pt ;
                          skos:definition "Exploratory methods that quantify biases prior to model training by directly analyzing dataset properties such as distributions, labels, and feature correlations with protected attributes."@en ,
                                          "Métodos exploratórios que quantificam vieses antes do treino do modelo analisando diretamente propriedades do dataset."@pt .


###  http://www.usp.br/fmlo#DataCollection
fmlo:DataCollection rdf:type owl:Class ;
                    rdfs:subClassOf fmlo:LifeCycleStage ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty fmlo:hasMappedPhase ;
                                      owl:hasValue fmlo:PreProcessing_i
                                    ] ;
                    rdfs:isDefinedBy "Harini Suresh and John Guttag. 2021. A Framework for Understanding Sources of Harm throughout the Machine Learning Life Cycle. In Proceedings of the 1st ACM Conference on Equity and Access in Algorithms, Mechanisms, and Optimization (EAAMO '21). Association for Computing Machinery, New York, NY, USA, Article 17, 1–9. https://doi.org/10.1145/3465416.3483305"@en ;
                    rdfs:label "DataCollection"@en ;
                    skos:altLabel "Coleta de Dados"@pt ;
                    skos:definition "Estágio envolvendo a identificação de uma população-alvo, definição e mensuração de features e labels."@pt ,
                                    "Stage involving the identification of a target population, the definition and measurement of features and labels, and sampling."@en .


###  http://www.usp.br/fmlo#DataPreparation
fmlo:DataPreparation rdf:type owl:Class ;
                     rdfs:subClassOf fmlo:LifeCycleStage ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty fmlo:hasMappedPhase ;
                                       owl:hasValue fmlo:PreProcessing_i
                                     ] ;
                     rdfs:isDefinedBy "Harini Suresh and John Guttag. 2021. A Framework for Understanding Sources of Harm throughout the Machine Learning Life Cycle. In Proceedings of the 1st ACM Conference on Equity and Access in Algorithms, Mechanisms, and Optimization (EAAMO '21). Association for Computing Machinery, New York, NY, USA, Article 17, 1–9. https://doi.org/10.1145/3465416.3483305"@en ;
                     rdfs:label "DataPreparation"@en ;
                     skos:altLabel "Preparação de Dados"@pt ;
                     skos:definition "Etapa que envolve o pré-processamento aplicado ao conjunto de dados antes do uso do modelo, incluindo o tratamento de dados faltantes, transformação de atributos, normalização e divisão em conjuntos de treinamento, validação e teste."@pt ,
                                     "Stage involving preprocessing applied to the dataset before model use, including handling missing data, feature transformation, normalization, and splitting into training, validation, and test sets."@en .


###  http://www.usp.br/fmlo#DataProtectionLaw
fmlo:DataProtectionLaw rdf:type owl:Class ;
                       rdfs:subClassOf fmlo:LegalFramework ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty fmlo:protects ;
                                         owl:hasValue fmlo:SensitivePersonalData_i
                                       ] ;
                       rdfs:isDefinedBy ""@en ;
                       rdfs:label "DataProtectionLaw"@en ;
                       skos:altLabel "Lei de Proteção de Dados"@pt ;
                       skos:definition "A type of legal document that prohibits discrimination based on protected characteristics, ensuring equal treatment and protection under the law."@en ,
                                       "Um tipo de documento legal que proíbe a discriminação com base em características protegidas, garantindo igualdade de tratamento e proteção perante a lei."@pt .


###  http://www.usp.br/fmlo#DeploymentBias
fmlo:DeploymentBias rdf:type owl:Class ;
                    rdfs:subClassOf fmlo:BiasSource ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty fmlo:originatesIn ;
                                      owl:hasValue fmlo:ModelDeployment_i
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty fmlo:originatesInPhase ;
                                      owl:hasValue fmlo:PostProcessing_i
                                    ] ;
                    rdfs:isDefinedBy "Harini Suresh and John Guttag. 2021. A Framework for Understanding Sources of Harm throughout the Machine Learning Life Cycle. In Proceedings of the 1st ACM Conference on Equity and Access in Algorithms, Mechanisms, and Optimization (EAAMO '21). Association for Computing Machinery, New York, NY, USA, Article 17, 1–9. https://doi.org/10.1145/3465416.3483305"@en ;
                    rdfs:label "DeploymentBias"@en ;
                    skos:altLabel "Viés de implantação"@pt ;
                    skos:definition "Occurs when there is a mismatch between the problem a model is intended to solve and the way in which it is actually used."@en ,
                                    "Ocorre quando há uma incompatibilidade entre o problema que o modelo pretende resolver e a forma como é realmente usado."@pt .


###  http://www.usp.br/fmlo#DifferenceBased
fmlo:DifferenceBased rdf:type owl:Class ;
                     rdfs:subClassOf fmlo:MetricOperationalization ;
                     rdfs:isDefinedBy "Statistics ontology (STATO) ."@en ;
                     rdfs:label "DifferenceBased"@en ;
                     skos:altLabel "Baseado em Diferença"@pt ;
                     skos:closeMatch obo:STATO_0000184 ;
                     skos:definition "Operacionalização que quantifica violações de fairness como diferenças absolutas entre estatísticas condicionais de grupo."@pt ,
                                     "Operationalization that quantifies fairness violations as absolute differences between group-conditional statistics."@en .


###  http://www.usp.br/fmlo#Disability
fmlo:Disability rdf:type owl:Class ;
                rdfs:subClassOf fmlo:SensitiveAttribute ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty fmlo:isClassifiedAs ;
                                  owl:hasValue fmlo:ProtectedCharacteristic_i
                                ] ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty fmlo:isClassifiedAs ;
                                  owl:hasValue fmlo:SensitivePersonalData_i
                                ] ;
                rdfs:isDefinedBy "Equality and Human Rights Commission (EHRC). \"Protected characteristics.\" Equality Act 2010. Disponível em: https://www.equalityhumanrights.com/equality/equality-act-2010/protected-characteristics"@en ;
                rdfs:label "Disability"@en ;
                skos:altLabel "Deficiência"@pt ;
                skos:definition "An attribute indicating a physical, mental, intellectual or sensory impairment."@en ,
                                "Um atributo indicando uma deficiência física, mental, intelectual ou sensorial."@pt .


###  http://www.usp.br/fmlo#DisparateImpact
fmlo:DisparateImpact rdf:type owl:Class ;
                     rdfs:subClassOf fmlo:NormativeDimension ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty fmlo:appliesAtScope ;
                                       owl:hasValue fmlo:Group_i
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty fmlo:isPrincipleOf ;
                                       owl:hasValue fmlo:DistributiveJustice_i
                                     ] ;
                     rdfs:isDefinedBy "S. Barocas and A. D. Selbst, ‘‘Big data’s disparate impact,’’ California Law Review, pp. 671–732, 2016"@en ;
                     rdfs:label "DisparateImpact"@en ;
                     skos:altLabel "Impacto Dispar"@pt ;
                     skos:definition "Normative principle concerned with unequal aggregate outcomes across protected groups, prohibiting decisions that produce disproportionately adverse effects on a group regardless of intent. Aligned with substantive (material) equality in legal theory."@en ,
                                     "Princípio normativo que proíbe políticas neutras que produzem efeitos desproporcionais em grupos protegidos."@pt .


###  http://www.usp.br/fmlo#DisparateMistreatment
fmlo:DisparateMistreatment rdf:type owl:Class ;
                           rdfs:subClassOf fmlo:NormativeDimension ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty fmlo:appliesAtScope ;
                                             owl:hasValue fmlo:Group_i
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty fmlo:isPrincipleOf ;
                                             owl:hasValue fmlo:DistributiveJustice_i
                                           ] ;
                           rdfs:isDefinedBy "M. B. Zafar, I. Valera, M. Gomez Rodriguez, and K. P. Gummadi, ‘‘Fairness beyond disparate treatment & disparate impact: Learning classification without disparate mistreatment,’’ in 26th Int’l Conf. on World Wide Web, pp. 1171–1180, 2017."@en ;
                           rdfs:label "DisparateMistreatment"@en ;
                           skos:altLabel "Tratamento Dispar"@pt ;
                           skos:definition "Normative principle concerned with disparities in predictive error rates across groups, requiring that no protected group systematically bears higher rates of prediction errors (false positives or false negatives)."@en ,
                                           "Princípio normativo que proíbe erros de classificação desproporcionais entre grupos."@pt .


###  http://www.usp.br/fmlo#DisparateTreatment
fmlo:DisparateTreatment rdf:type owl:Class ;
                        rdfs:subClassOf fmlo:NormativeDimension ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty fmlo:appliesAtScope ;
                                          owl:hasValue fmlo:Individual_i
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty fmlo:isPrincipleOf ;
                                          owl:hasValue fmlo:ProceduralJustice_i
                                        ] ;
                        rdfs:isDefinedBy "J. Kleinberg, J. Ludwig, S. Mullainathan, and C. R. Sunstein, ‘‘Discrimination in the age of algorithms,’’ J. of Legal Analysis, vol. 10, pp. 113–174, 2018."@en ;
                        rdfs:label "DisparateTreatment"@en ;
                        skos:altLabel "Tratamento Diferenciado"@pt ;
                        skos:definition "Normative principle that prohibits direct causal dependence of the decision on the protected attribute, requiring that a change in group status does not alter the outcome for the same individual. Aligned with formal equality in legal theory."@en ,
                                        "Princípio normativo que proíbe dependência causal direta da decisão em relação ao atributo protegido."@pt .


###  http://www.usp.br/fmlo#Distributional
fmlo:Distributional rdf:type owl:Class ;
                    rdfs:subClassOf fmlo:FairnessCriterion ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty fmlo:criterionBelongsToApproach ;
                                      owl:hasValue fmlo:Statistical_i
                                    ] ;
                    fmlo:probabilistic_definition "H(C | A=a) ≈ H(C | A=b)" ;
                    rdfs:isDefinedBy "I. Dominguez-Catena, D. Paternain, and M. Galar, ‘‘Metrics for dataset demographic bias: A case study on facial expression recognition,’’ IEEE Transactions on Pattern Analysis and Machine Int., vol. 46, no. 8, pp. 5209–5226, 2024."@en ;
                    rdfs:label "Distributional"@en ;
                    skos:altLabel "Distribucional"@pt ;
                    skos:definition "Criterion inspired by ecological diversity analysis that measures semantic concentration or dispersion within group-conditional representations, requiring comparable semantic diversity across groups"@en ,
                                    "Critério de fairness que requer equidade na distribuição de resultados entre grupos."@pt .


###  http://www.usp.br/fmlo#DistributionalDiversity
fmlo:DistributionalDiversity rdf:type owl:Class ;
                             rdfs:subClassOf fmlo:RepresentationEquality ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty fmlo:isSpecialCaseOf ;
                                               owl:hasValue fmlo:RepresentationEquality_i
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty fmlo:satisfiesCriterion ;
                                               owl:hasValue fmlo:Distributional_i
                                             ] ;
                             rdfs:isDefinedBy "I. Dominguez-Catena, D. Paternain, and M. Galar, ‘‘Metrics for dataset demographic bias: A case study on facial expression recognition,’’ IEEE Transactions on Pattern Analysis and Machine Int., vol. 46, no. 8, pp. 5209–5226, 2024."@en ;
                             rdfs:label "DistributionalDiversity"@en ;
                             skos:altLabel "Diversidade Distribucional"@pt ;
                             skos:definition "A igualdade de representação, inspirada na análise da diversidade ecológica, avalia se os grupos protegidos exibem cobertura e equilíbrio semânticos comparáveis ​​dentro do espaço de representação. Operacionalizada por meio de índices baseados em entropia e dominância, que medem a dispersão ou concentração sobre as distribuições semânticas condicionais ao grupo."@pt ,
                                             "Representation equality inspired by ecological diversity analysis that assesses whether protected groups exhibit comparable semantic coverage and balance within the representation space. Operationalized through entropy- and dominance-based indices measuring dispersion or concentration over group-conditional semantic distributions."@en .


###  http://www.usp.br/fmlo#DistributiveEquity
fmlo:DistributiveEquity rdf:type owl:Class ;
                        rdfs:subClassOf fmlo:FairnessNotion ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty fmlo:belongsToFamily ;
                                          owl:hasValue fmlo:InequalityBased_i
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty fmlo:hasEthicalDimension ;
                                          owl:hasValue fmlo:DistributiveJustice_i
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty fmlo:hasEvaluationLocus ;
                                          owl:hasValue fmlo:Extrinsic_i
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty fmlo:hasMethodologicalApproach ;
                                          owl:hasValue fmlo:Statistical_i
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty fmlo:hasSocioTechnicalScope ;
                                          owl:hasValue fmlo:Group_i
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty fmlo:satisfiesCriterion ;
                                          owl:hasValue fmlo:InequalityMinimization_i
                                        ] ;
                        rdfs:isDefinedBy "Y. Deldjoo, V. W. Anelli, H. Zamani, A. Bellogin, and T. Di Noia, ‘‘A flexible framework for evaluating user and item fairness in recommender systems,’’ User Modeling and User-Adapted Interaction, vol. 31, no. 3, pp. 457–511, 2021."@en ;
                        rdfs:label "DistributiveEquity"@en ;
                        skos:altLabel "Igualdade Distributiva"@pt ;
                        skos:definition "A noção de justiça, fundamentada na teoria do bem-estar social e em medidas de desigualdade baseadas na teoria da informação, concebe a justiça como uma questão de grau, avaliando como o erro, a informação ou o benefício são distribuídos de forma desigual na população, em vez de impor paridade estrita ou independência condicional."@pt ,
                                        "Fairness notion grounded in social welfare theory and information-theoretic measures of inequality, conceptualizing fairness as a matter of degree by assessing how error, information, or benefit is unevenly distributed within the population, rather than enforcing strict parity or conditional independence."@en .


###  http://www.usp.br/fmlo#DistributiveJustice
fmlo:DistributiveJustice rdf:type owl:Class ;
                         rdfs:subClassOf fmlo:EthicalDimension ;
                         owl:disjointWith fmlo:ProceduralJustice ;
                         rdfs:isDefinedBy "G. S. Leventhal, ‘‘The distribution of rewards and resources in groups and organizations,’’ in Advances in experimental social psychology, vol. 9, pp. 91–131, Elsevier, 1976."@en ;
                         rdfs:label "DistributiveJustice"@en ;
                         skos:altLabel "Justiça Distributiva"@pt ;
                         skos:definition "Dimensão ética que se preocupa com a distribuição justa de benefícios e ônus na sociedade."@pt ,
                                         "Ethical orientation where fairness is conceptualized as the equitable allocation of benefits, opportunities, or predictive outcomes across individuals and groups, focusing on who receives favorable predictions and who bears disproportionate error burdens."@en .


###  http://www.usp.br/fmlo#EconomicalStatus
fmlo:EconomicalStatus rdf:type owl:Class ;
                      rdfs:subClassOf fmlo:SensitiveAttribute ,
                                      [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                               owl:onProperty fmlo:isProxyFor ;
                                                               owl:hasValue fmlo:Ethnicity_i
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty fmlo:isProxyFor ;
                                                               owl:hasValue fmlo:Race_i
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] ;
                      rdfs:isDefinedBy "Fairness at Risk: Where Bias Emerges in Machine Learning"@en ;
                      rdfs:label "EconomicalStatus"@en ;
                      skos:altLabel "Condição Econômica"@pt ,
                                    "Income"@en ;
                      skos:definition "A sensitive attribute referring to the economic condition of an individual or household, typically determined by financial indicators such as income level, wealth, or access to economic resources."@en ,
                                      "Um atributo sensível que se refere à condição econômica de um indivíduo ou família, geralmente determinado por indicadores financeiros como nível de renda, patrimônio ou acesso a recursos econômicos."@pt .


###  http://www.usp.br/fmlo#EducationalLevel
fmlo:EducationalLevel rdf:type owl:Class ;
                      rdfs:subClassOf fmlo:SensitiveAttribute ,
                                      [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                               owl:onProperty fmlo:isProxyFor ;
                                                               owl:hasValue fmlo:EconomicalStatus_i
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty fmlo:isProxyFor ;
                                                               owl:hasValue fmlo:Race_i
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] ;
                      rdfs:isDefinedBy "Unesco. (2012). International standard classification of education (ISCED) 2011. UNESCO."@en ;
                      rdfs:label "EducationalLevel"@en ;
                      skos:altLabel "Nível de Escolaridade"@pt ;
                      skos:definition "An attribute that indicates the highest level of education completed by an individual."@en ,
                                      "Um atributo que indica o mais alto nível de educação completado por um indivíduo."@pt .


###  http://www.usp.br/fmlo#EqualityOfOpportunity
fmlo:EqualityOfOpportunity rdf:type owl:Class ;
                           rdfs:subClassOf fmlo:FairnessNotion ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty fmlo:hasEthicalDimension ;
                                             owl:hasValue fmlo:DistributiveJustice_i
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty fmlo:hasEvaluationLocus ;
                                             owl:hasValue fmlo:Extrinsic_i
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty fmlo:hasMethodologicalApproach ;
                                             owl:hasValue fmlo:Statistical_i
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty fmlo:hasNormativePrinciple ;
                                             owl:hasValue fmlo:DisparateMistreatment_i
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty fmlo:hasSocioTechnicalScope ;
                                             owl:hasValue fmlo:Group_i
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty fmlo:isSpecialCaseOf ;
                                             owl:hasValue fmlo:EqualizedOdds_i
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty fmlo:satisfiesCriterion ;
                                             owl:hasValue fmlo:Separation_i
                                           ] ;
                           rdfs:comment """Causal formulation by \"S. Corbett-Davies, J. D. Gaebler, H. Nilforoshan, R. Shroff, and S. Goel,‘‘The measure and mismeasure of fairness,’’ Journal of Machine Learning
Research, vol. 24, no. 312, pp. 1–117, 2023.\""""@en ;
                           rdfs:isDefinedBy "M. Hardt, E. Price, and N. Srebro, ‘‘Equality of opportunity in supervised learning,’’ in 30th Conf. on Neural Inf. Processing Sys., pp. 1–9, 2016."@en ;
                           rdfs:label "EqualityOfOpportunity"@en ;
                           skos:altLabel "Equal Sensitivity"@en ,
                                         "High-Risk Sensitivity"@en ,
                                         "Igualdade de Oportunidade"@pt ;
                           skos:definition "Caso especial de Equalized Odds que requer paridade apenas para a classe de resultado desejável."@pt ,
                                           "Special case of Equalized Odds requiring parity only for the desirable outcome class (Y=1), demanding equal TPR across groups, operationalizing the one-sided Separation criterion."@en .


###  http://www.usp.br/fmlo#EqualizedOdds
fmlo:EqualizedOdds rdf:type owl:Class ;
                   rdfs:subClassOf fmlo:FairnessNotion ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty fmlo:hasCausalAnalogue ;
                                     owl:hasValue fmlo:CounterfactualFairness_i
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty fmlo:hasEthicalDimension ;
                                     owl:hasValue fmlo:DistributiveJustice_i
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty fmlo:hasEvaluationLocus ;
                                     owl:hasValue fmlo:Extrinsic_i
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty fmlo:hasMethodologicalApproach ;
                                     owl:hasValue fmlo:Causal_i
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty fmlo:hasMethodologicalApproach ;
                                     owl:hasValue fmlo:Statistical_i
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty fmlo:hasNormativePrinciple ;
                                     owl:hasValue fmlo:DisparateMistreatment_i
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty fmlo:hasSocioTechnicalScope ;
                                     owl:hasValue fmlo:Group_i
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty fmlo:hasTradeOffWith ;
                                     owl:hasValue fmlo:PerformanceOriented_i
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty fmlo:isIncompatibleWith ;
                                     owl:hasValue fmlo:Calibration_i
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty fmlo:isIncompatibleWith ;
                                     owl:hasValue fmlo:StatisticalParity_i
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty fmlo:satisfiesCriterion ;
                                     owl:hasValue fmlo:Separation_i
                                   ] ;
                   rdfs:comment """Causal formulation by \"S. Corbett-Davies, J. D. Gaebler, H. Nilforoshan, R. Shroff, and S. Goel,‘‘The measure and mismeasure of fairness,’’ Journal of Machine Learning
Research, vol. 24, no. 312, pp. 1–117, 2023.\""""@en ;
                   rdfs:isDefinedBy "M. Hardt, E. Price, and N. Srebro, ‘‘Equality of opportunity in supervised learning,’’ in 30th Conf. on Neural Inf. Processing Sys., pp. 1–9, 2016."@en ;
                   rdfs:label "EqualizedOdds"@en ;
                   skos:altLabel "Chances equalizadas"@pt ;
                   skos:definition "Fairness notion requiring parity of prediction behavior across groups conditional on the true label for both outcome classes"@en ,
                                   "Noção de fairness que requer taxas iguais de verdadeiros positivos e falsos positivos entre grupos."@pt .


###  http://www.usp.br/fmlo#ErrorCostParity
fmlo:ErrorCostParity rdf:type owl:Class ;
                     rdfs:subClassOf fmlo:LossBased ;
                     fmlo:probabilistic_definition "FNR/FPR ⊥ A"@en ;
                     rdfs:isDefinedBy "Fairness at Risk: Bias-Discovery and Mitigation Solutions"@en ;
                     rdfs:label "ErrorCostParity"@en ;
                     skos:altLabel "Paridade de Custo de Erro"@pt ;
                     skos:definition "Critério baseado em perda que foca em equalizar a razão de custos de erro entre falsos negativos e falsos positivos."@pt ,
                                     "Loss-based criteria that focuses on equalizing the ratio of error costs between false negatives and false positives."@en .


###  http://www.usp.br/fmlo#EthicalDimension
fmlo:EthicalDimension rdf:type owl:Class ;
                      rdfs:subClassOf obo:BFO_0000031 ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty fmlo:encompassPrinciple ;
                                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass fmlo:NormativeDimension
                                      ] ;
                      rdfs:isDefinedBy "Fairness at Risk: Bias-Discovery and Mitigation Solutions"@en ;
                      rdfs:label "EthicalDimension"@en ;
                      skos:altLabel "Dimensão Ética"@pt ;
                      skos:definition "A high-level layer that defines the ethical and philosophical foundation situating fairness in machine learning in classical theories of justice."@en ,
                                      "Uma camada de alto nível que define a base ética e filosófica que situa a equidade na aprendizagem de máquina dentro das teorias clássicas da justiça."@pt .


###  http://www.usp.br/fmlo#Ethnicity
fmlo:Ethnicity rdf:type owl:Class ;
               rdfs:subClassOf fmlo:SensitiveAttribute ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty fmlo:isClassifiedAs ;
                                 owl:hasValue fmlo:ProtectedCharacteristic_i
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty fmlo:isClassifiedAs ;
                                 owl:hasValue fmlo:SensitivePersonalData_i
                               ] ;
               rdfs:isDefinedBy "Edwards, C. L., Fillingim, R. B., & Keefe, F. (2001). Race, ethnicity and pain. Pain, 94(2), 133-137."@en ;
               rdfs:label "Ethnicity"@en ;
               skos:altLabel "Etnia"@pt ;
               skos:definition "An attribute that refers to an individual's cultural identity and affiliation with a particular group, typically defined through shared traditions, ancestry, religion, beliefs, values, language, and practices"@en ,
                               "Um atributo que se refere à identidade cultural de um indivíduo e à sua afiliação a um determinado grupo, geralmente definida por meio de tradições, ancestralidade, religião, crenças, valores, idioma e práticas compartilhadas."@pt .


###  http://www.usp.br/fmlo#EvaluationBias
fmlo:EvaluationBias rdf:type owl:Class ;
                    rdfs:subClassOf fmlo:BiasSource ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty fmlo:originatesIn ;
                                      owl:hasValue fmlo:ModelEvaluation_i
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty fmlo:originatesInPhase ;
                                      owl:hasValue fmlo:PostProcessing_i
                                    ] ;
                    rdfs:isDefinedBy "Harini Suresh and John Guttag. 2021. A Framework for Understanding Sources of Harm throughout the Machine Learning Life Cycle. In Proceedings of the 1st ACM Conference on Equity and Access in Algorithms, Mechanisms, and Optimization (EAAMO '21). Association for Computing Machinery, New York, NY, USA, Article 17, 1–9. https://doi.org/10.1145/3465416.3483305"@en ;
                    rdfs:label "EvaluationBias"@en ;
                    skos:altLabel "Viés de avaliação"@pt ;
                    skos:definition "Occurs when the benchmark data used for a particular task does not represent the use population."@en ,
                                    "Ocorre quando os dados de benchmark usados para uma tarefa particular não representam a população de uso."@pt .


###  http://www.usp.br/fmlo#EvaluationLocus
fmlo:EvaluationLocus rdf:type owl:Class ;
                     rdfs:subClassOf obo:BFO_0000031 ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty fmlo:hasFamily ;
                                       owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onClass fmlo:StatisticalFamily
                                     ] ;
                     rdfs:isDefinedBy "Y. Li, M. Du, R. Song, X. Wang, and Y. Wang, ‘‘A survey on fairness in large language models,’’ arXiv preprint arXiv:2308.10149, 2023."@en ;
                     rdfs:label "EvaluationLocus"@en ;
                     skos:altLabel "Locus de Avaliação"@pt ;
                     skos:definition "Categorizes fairness notions based on the specific site of evaluation, distinguishing whether fairness is assessed through the external effects of a model or through structural disparities encoded in its internal representations."@en ,
                                     "Classifica as noções de justiça com base no local específico de avaliação, distinguindo se a justiça é avaliada por meio dos efeitos externos de um modelo ou por meio de disparidades estruturais codificadas em suas representações internas."@pt .


###  http://www.usp.br/fmlo#ExploratoryTechnique
fmlo:ExploratoryTechnique rdf:type owl:Class ;
                          rdfs:subClassOf fmlo:BiasDiscoveryTechnique ;
                          owl:disjointWith fmlo:MeasurementTechnique ;
                          rdfs:isDefinedBy "Fairness at Risk: Bias-Discovery and Mitigation Solutions"@en ;
                          rdfs:label "ExploratoryTechnique"@en ;
                          skos:altLabel "Técnica Exploratória"@pt ;
                          skos:definition "Discovery methods focused on detecting and quantifying bias through empirical experiments or theoretical frameworks applied to datasets or trained models."@en ,
                                          "Métodos de descoberta focados em detectar e quantificar viés através de experimentos empíricos ou frameworks teóricos."@pt .


###  http://www.usp.br/fmlo#Extrinsic
fmlo:Extrinsic rdf:type owl:Class ;
               rdfs:subClassOf fmlo:EvaluationLocus ;
               owl:disjointWith fmlo:Intrinsic ;
               rdfs:isDefinedBy "Y. Li, M. Du, R. Song, X. Wang, and Y. Wang, ‘‘A survey on fairness in large language models,’’ arXiv preprint arXiv:2308.10149, 2023."@en ;
               rdfs:label "Extrinsic"@en ;
               skos:altLabel "Extrínseco"@pt ;
               skos:definition "Evaluation locus that assesses fairness through disparities in observable quantities external to the representation itself, such as predictions, outcomes, errors, losses, or utilities. Requires variables associated with a decision-making process."@en ,
                               "Locus de avaliação que avalia fairness através de referência a rótulos de ground-truth externos."@pt .


###  http://www.usp.br/fmlo#FairnessCriterion
fmlo:FairnessCriterion rdf:type owl:Class ;
                       rdfs:subClassOf obo:BFO_0000031 ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty fmlo:criterionBelongsToApproach ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass fmlo:MethodologicalApproach
                                       ] ;
                       rdfs:isDefinedBy "Fairness at Risk: Bias-Discovery and Mitigation Solutions"@en ;
                       rdfs:label "FairnessCriterion"@en ;
                       skos:altLabel "Critério de Justiça"@pt ;
                       skos:definition "Estabelece o padrão formal usado para operacionalizar fairness."@pt ,
                                       "Establishes the formal standard used to operationalize fairness notions."@en .


###  http://www.usp.br/fmlo#FairnessMetric
fmlo:FairnessMetric rdf:type owl:Class ;
                    rdfs:subClassOf obo:BFO_0000031 ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty fmlo:requiresDataType ;
                                      owl:someValuesFrom fmlo:AttributeDataType
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty fmlo:operationalizes ;
                                      owl:allValuesFrom fmlo:FairnessNotion
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty fmlo:formalizesCriterion ;
                                      owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass fmlo:FairnessCriterion
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty fmlo:hasOperationalization ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass fmlo:MetricOperationalization
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty fmlo:hasAcronym ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:string
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty fmlo:hasFormula ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:string
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty fmlo:hasIdealValue ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:float
                                    ] ;
                    rdfs:isDefinedBy "Fairness at Risk: Bias-Discovery and Mitigation Solutions"@en ;
                    rdfs:label "FairnessMetric"@en ;
                    skos:altLabel "Métrica de Justiça"@pt ;
                    skos:definition "Medida escalar que quantifica o grau em que um modelo ou dataset desvia de uma noção de fairness."@pt ,
                                    "Scalar measure that quantifies the degree to which a model or dataset deviates from a given fairness notion."@en .


###  http://www.usp.br/fmlo#FairnessNotion
fmlo:FairnessNotion rdf:type owl:Class ;
                    rdfs:subClassOf obo:BFO_0000031 ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty fmlo:requiresAccessTo ;
                                      owl:someValuesFrom fmlo:SensitiveAttribute
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty fmlo:hasDualRole ;
                                      owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onClass fmlo:FairnessMetric
                                    ] ;
                    rdfs:isDefinedBy "Fairness at Risk: Bias-Discovery and Mitigation Solutions"@en ;
                    rdfs:label "FairnessNotion"@en ;
                    skos:altLabel "Noção de Justiça"@pt ;
                    skos:definition "Conceptual definition of fairness grounded in probabilistic, statistical, causal, or geometric criteria, applicable to models, predictions, or data distributions."@en ,
                                    "Definição conceitual de fairness fundamentada em critérios probabilísticos, estatísticos, causais ou geométricos."@pt .


###  http://www.usp.br/fmlo#FairnessThroughAwareness
fmlo:FairnessThroughAwareness rdf:type owl:Class ;
                              rdfs:subClassOf fmlo:FairnessNotion ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty fmlo:hasEthicalDimension ;
                                                owl:hasValue fmlo:ProceduralJustice_i
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty fmlo:hasEvaluationLocus ;
                                                owl:hasValue fmlo:Extrinsic_i
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty fmlo:hasMethodologicalApproach ;
                                                owl:hasValue fmlo:Geometric_i
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty fmlo:hasNormativePrinciple ;
                                                owl:hasValue fmlo:Consistency_i
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty fmlo:hasSocioTechnicalScope ;
                                                owl:hasValue fmlo:Individual_i
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty fmlo:satisfiesCriterion ;
                                                owl:hasValue fmlo:Similarity_i
                                              ] ;
                              rdfs:isDefinedBy """C. Dwork, M. Hardt, T. Pitassi, O. Reingold, and R. Zemel, ‘‘Fairness through awareness,’’ in 3rd Innovations in Theoretical Computer Sci.
Conf., pp. 214–226, 2012."""@en ;
                              rdfs:label "FairnessThroughAwareness"@en ;
                              skos:altLabel "Justiça por Consciência"@pt ;
                              skos:definition "Fairness notion requiring that individuals similar with respect to task-relevant characteristics be treated similarly."@en ,
                                              "Noção de fairness que requer que indivíduos similares sejam tratados de forma similar."@pt .


###  http://www.usp.br/fmlo#Gender
fmlo:Gender rdf:type owl:Class ;
            rdfs:subClassOf fmlo:SensitiveAttribute ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty fmlo:isClassifiedAs ;
                              owl:hasValue fmlo:ProtectedCharacteristic_i
                            ] ;
            rdfs:isDefinedBy "Canadian Institutes of Health Research (CIHR). https://cihr-irsc.gc.ca/e/47830.html"@en ;
            rdfs:label "Gender"@en ;
            skos:altLabel "Gênero"@pt ;
            skos:definition "An attribute that refers to the socially constructed roles, behaviours, expressions and identities of girls, women, boys, men, and gender diverse people."@en ,
                            "Um atributo que se refere aos papéis, comportamentos, expressões e identidades socialmente construídos de meninas, mulheres, meninos, homens e pessoas com diversidade de gênero."@pt .


###  http://www.usp.br/fmlo#GeneticCharacteristic
fmlo:GeneticCharacteristic rdf:type owl:Class ;
                           rdfs:subClassOf fmlo:SensitiveAttribute ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty fmlo:isClassifiedAs ;
                                             owl:hasValue fmlo:SensitivePersonalData_i
                                           ] ;
                           rdfs:isDefinedBy "General Data Protection Regulation (GDPR), Recital 34. Available: https://gdpr.eu/Recital-34-Genetic-data/"@en ;
                           rdfs:label "GeneticCharacteristic"@en ;
                           skos:altLabel "Características Genéticas"@pt ;
                           skos:definition "A personal data relating to the inherited or acquired genetic characteristics of a natural person which give unique information about the physiology or the health of that natural person and which result, in particular, from an analysis of a biological sample from the natural person in question"@en ,
                                           "Dados pessoais relativos às características genéticas herdadas ou adquiridas de uma pessoa singular, que fornecem informações únicas sobre a fisiologia ou a saúde dessa pessoa singular e que resultam, em particular, da análise de uma amostra biológica da referida pessoa."@pt .


###  http://www.usp.br/fmlo#GeographyLocation
fmlo:GeographyLocation rdf:type owl:Class ;
                       rdfs:subClassOf fmlo:SensitiveAttribute ,
                                       [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                owl:onProperty fmlo:isProxyFor ;
                                                                owl:hasValue fmlo:EconomicalStatus_i
                                                              ]
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty fmlo:isProxyFor ;
                                                                owl:hasValue fmlo:Ethnicity_i
                                                              ]
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty fmlo:isProxyFor ;
                                                                owl:hasValue fmlo:Race_i
                                                              ]
                                                            ) ;
                                         rdf:type owl:Class
                                       ] ;
                       rdfs:isDefinedBy "Fairness at Risk: Where Bias Emerges in Machine Learning"@en ;
                       rdfs:label "GeographyLocation"@en ;
                       skos:altLabel "Localização Geográfica"@pt ;
                       skos:definition "An attribute of the geographical location of an individual or population."@en ,
                                       "Um atributo da localização geográfica de um indivíduo ou população."@pt .


###  http://www.usp.br/fmlo#Geometric
fmlo:Geometric rdf:type owl:Class ;
               rdfs:subClassOf fmlo:MethodologicalApproach ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty fmlo:approachHasLocus ;
                                 owl:hasValue fmlo:Extrinsic_i
                               ] ;
               rdfs:isDefinedBy "C. Dwork, M. Hardt, T. Pitassi, O. Reingold, and R. Zemel, ‘‘Fairness through awareness,’’ in 3rd Innovations in Theoretical Computer Sci. Conf., pp. 214–226, 2012."@en ;
               rdfs:label "Geometric"@en ;
               skos:altLabel "Geométrico"@pt ;
               skos:definition "Abordagem metodológica baseada em conceitos geométricos de distância e similaridade."@pt ,
                               "Methodological approach in which fairness is formalized through the geometric or topological structure of the individual or representation space, imposing locality-preserving constraints requiring that proximity in the input or latent space be reflected by proximity in the decision space."@en .


###  http://www.usp.br/fmlo#Group
fmlo:Group rdf:type owl:Class ;
           rdfs:subClassOf fmlo:SocioTechnicalScope ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty fmlo:requiresAccessTo ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass fmlo:SensitiveAttribute
                           ] ;
           rdfs:isDefinedBy "T. Calders and S. Verwer, ‘‘Three naive bayes approaches for discrimination-free classification,’’ Data Mining and Knowledge Discovery, vol. 21, pp. 277–292, 2010."@en ;
           rdfs:label "Group"@en ;
           skos:altLabel "Grupo"@pt ;
           skos:definition "Escopo sociotécnico que avalia fairness no nível de grupos definidos por atributos protegidos."@pt ,
                           "Scope level that evaluates equity through parity constraints on predictions, allocations, or error rates across protected groups, focusing on aggregate disparities rather than pairwise similarity."@en .


###  http://www.usp.br/fmlo#Guidelines
fmlo:Guidelines rdf:type owl:Class ;
                rdfs:subClassOf fmlo:StructuralMethodologicalContributions ;
                rdfs:isDefinedBy "Fairness at Risk: Bias-Discovery and Mitigation Solutions"@en ;
                rdfs:label "Guidelines"@en ;
                skos:altLabel "Diretrizes"@pt ;
                skos:definition "Contribuições estruturais que fornecem boas práticas acionáveis e aconselhamento de políticas."@pt ,
                                "Structural contributions providing actionable best practices and policy advice derived from empirical, legal, or ethical considerations to guide AI development."@en .


###  http://www.usp.br/fmlo#HealthInsurance
fmlo:HealthInsurance rdf:type owl:Class ;
                     rdfs:subClassOf fmlo:SensitiveAttribute ,
                                     [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                              owl:onProperty fmlo:isProxyFor ;
                                                              owl:hasValue fmlo:EconomicalStatus_i
                                                            ]
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty fmlo:isProxyFor ;
                                                              owl:hasValue fmlo:Race_i
                                                            ]
                                                          ) ;
                                       rdf:type owl:Class
                                     ] ;
                     rdfs:isDefinedBy """Adapted from: Organisation for Economic Co-operation and Development (OECD). (2017). Health at a Glance 2017: OECD Indicators.
https://doi.org/10.1787/health_glance-2017-en"""@en ;
                     rdfs:label "HealthInsurance"@en ;
                     skos:altLabel "Seguro de Saúde"@pt ;
                     skos:definition "A sensitive attribute referring to the type or presence of health insurance coverage."@en ,
                                     "Um atributo sensível referente ao tipo ou presença de cobertura de seguro de saúde."@pt .


###  http://www.usp.br/fmlo#HistoricalBias
fmlo:HistoricalBias rdf:type owl:Class ;
                    rdfs:subClassOf fmlo:BiasSource ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty fmlo:originatesIn ;
                                      owl:hasValue fmlo:DataCollection_i
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty fmlo:originatesInPhase ;
                                      owl:hasValue fmlo:PreProcessing_i
                                    ] ;
                    rdfs:isDefinedBy "Harini Suresh and John Guttag. 2021. A Framework for Understanding Sources of Harm throughout the Machine Learning Life Cycle. In Proceedings of the 1st ACM Conference on Equity and Access in Algorithms, Mechanisms, and Optimization (EAAMO '21). Association for Computing Machinery, New York, NY, USA, Article 17, 1–9. https://doi.org/10.1145/3465416.3483305"@en ;
                    rdfs:label "HistoricalBias"@en ;
                    skos:altLabel "Viés histórico"@pt ;
                    skos:definition "Occurs when training data contains biased patterns reflecting historical inequities in the real world."@en ,
                                    "Ocorre quando os dados de treino contêm padrões enviesados refletindo iniquidades históricas no mundo real."@pt .


###  http://www.usp.br/fmlo#HospitalLocation
fmlo:HospitalLocation rdf:type owl:Class ;
                      rdfs:subClassOf fmlo:SensitiveAttribute ,
                                      [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                               owl:onProperty fmlo:isProxyFor ;
                                                               owl:hasValue fmlo:EconomicalStatus_i
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty fmlo:isProxyFor ;
                                                               owl:hasValue fmlo:GeographyLocation_i
                                                             ]
                                                             [ rdf:type owl:Restriction ;
                                                               owl:onProperty fmlo:isProxyFor ;
                                                               owl:hasValue fmlo:Race_i
                                                             ]
                                                           ) ;
                                        rdf:type owl:Class
                                      ] ;
                      rdfs:isDefinedBy "Fairness at Risk: Where Bias Emerges in Machine Learning"@en ;
                      rdfs:label "HospitalLocation"@en ;
                      skos:altLabel "Localização do Hospital"@pt ;
                      skos:definition "An attribute that refers to the hospital location or site where healthcare is provided."@en ,
                                      "Um atributo que se refere à localização do hospital ou site onde os cuidados de saúde são prestados."@pt .


###  http://www.usp.br/fmlo#HybridTechnique
fmlo:HybridTechnique rdf:type owl:Class ;
                     rdfs:subClassOf fmlo:ExploratoryTechnique ;
                     rdfs:isDefinedBy "Fairness at Risk: Bias-Discovery and Mitigation Solutions"@en ;
                     rdfs:label "HybridTechnique"@en ;
                     skos:altLabel "Técnica Híbrida"@pt ;
                     skos:definition "Exploratory methods that combine data-centric and model-centric auditing to trace how dataset biases propagate and amplify in model predictions."@en ,
                                     "Métodos exploratórios que combinam auditoria centrada em dados e centrada em modelos."@pt .


###  http://www.usp.br/fmlo#ImmigrationStatus
fmlo:ImmigrationStatus rdf:type owl:Class ;
                       rdfs:subClassOf fmlo:SensitiveAttribute ,
                                       [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                owl:onProperty fmlo:isProxyFor ;
                                                                owl:hasValue fmlo:Ethnicity_i
                                                              ]
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty fmlo:isProxyFor ;
                                                                owl:hasValue fmlo:Nationality_i
                                                              ]
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty fmlo:isProxyFor ;
                                                                owl:hasValue fmlo:Race_i
                                                              ]
                                                            ) ;
                                         rdf:type owl:Class
                                       ] ;
                       rdfs:isDefinedBy "Fairness at Risk: Where Bias Emerges in Machine Learning"@en ;
                       rdfs:label "ImmigrationStatus"@en ;
                       skos:altLabel "Status Migratório"@pt ;
                       skos:definition "An attribute that refers to the legal status of an individual within a country."@en ,
                                       "Um atributo que se refere ao status legal de um indivíduo dentro de um país."@pt .


###  http://www.usp.br/fmlo#InProcessing
fmlo:InProcessing rdf:type owl:Class ;
                  rdfs:subClassOf fmlo:ProcessingPhase ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty fmlo:mapsToStage ;
                                    owl:hasValue fmlo:ModelDevelopment_i
                                  ] ;
                  rdfs:isDefinedBy "Fairness at Risk: Where Bias Emerges in Machine Learning"@en ;
                  rdfs:label "InProcessing"@en ;
                  skos:altLabel "em processamento"@pt ;
                  skos:definition "Fase de processamento do ciclo de vida do aprendizado de máquina que ocorre antes do treinamento do modelo, abrangendo todas as atividades relacionadas à coleta, preparação e transformação de dados."@pt ,
                                  "Processing phase of the ML lifecycle occurring during model training, encompassing algorithm selection, objective function definition, and learning procedures."@en .


###  http://www.usp.br/fmlo#Independence
fmlo:Independence rdf:type owl:Class ;
                  rdfs:subClassOf fmlo:FairnessCriterion ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty fmlo:criterionBelongsToApproach ;
                                    owl:hasValue fmlo:Statistical_i
                                  ] ;
                  fmlo:probabilistic_definition "R ⊥ A" ;
                  rdfs:isDefinedBy "Barocas, S., Hardt, M., & Narayanan, A. (2019). Fairness and machine learning: Limitations and opportunities. fairmlbook. org."@en ;
                  rdfs:label "Independence"@en ;
                  skos:altLabel "Independência"@pt ;
                  skos:definition "Criterion requiring predictions to be statistically independent of group membership (R ⊥ A), ensuring that the probability of receiving a favorable outcome is invariant across protected groups."@en ,
                                  "Critério de fairness que requer independência estatística entre a decisão e o atributo protegido."@pt .


###  http://www.usp.br/fmlo#Individual
fmlo:Individual rdf:type owl:Class ;
                rdfs:subClassOf fmlo:SocioTechnicalScope ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty fmlo:requiresAccessTo ;
                                  owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                  owl:onClass fmlo:SensitiveAttribute
                                ] ;
                rdfs:isDefinedBy "C. Dwork, M. Hardt, T. Pitassi, O. Reingold, and R. Zemel, ‘‘Fairness through awareness,’’ in 3rd Innovations in Theoretical Computer Sci. Conf., pp. 214–226, 2012."@en ;
                rdfs:label "Individual"@en ;
                skos:altLabel "Indivíduo"@pt ;
                skos:definition "Escopo sociotécnico que avalia fairness no nível de indivíduos similares."@pt ,
                                "Scope level requiring that similar individuals receive similar outcomes, emphasizing consistency of treatment within local neighborhoods of the feature or representation space, regardless of group membership"@en .


###  http://www.usp.br/fmlo#InequalityBased
fmlo:InequalityBased rdf:type owl:Class ;
                     rdfs:subClassOf fmlo:StatisticalFamily ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty fmlo:hasCriterion ;
                                       owl:hasValue fmlo:InequalityMinimization_i
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty fmlo:isFamilyOf ;
                                       owl:hasValue fmlo:Extrinsic_i
                                     ] ;
                     rdfs:isDefinedBy "Y. Deldjoo, V. W. Anelli, H. Zamani, A. Bellogin, and T. Di Noia, ‘‘A flexible framework for evaluating user and item fairness in recommender systems,’’ User Modeling and User-Adapted Interaction, vol. 31, no. 3, pp. 457–511, 2021."@en ;
                     rdfs:label "InequalityBased"@en ;
                     skos:altLabel "Baseado em Desigualdade"@pt ;
                     skos:definition "Família estatística que avalia fairness através de medidas de desigualdade."@pt ,
                                     "Statistical family that departs from conditional independence constraints to operationalize fairness as the minimization of benefit or loss dispersion,"@en .


###  http://www.usp.br/fmlo#InequalityMinimization
fmlo:InequalityMinimization rdf:type owl:Class ;
                            rdfs:subClassOf fmlo:FairnessCriterion ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty fmlo:criterionBelongsToApproach ;
                                              owl:hasValue fmlo:Statistical_i
                                            ] ;
                            fmlo:probabilistic_definition "Φ(u | A=a) ≈ Φ(u | A=b), ∀a,b" ;
                            rdfs:isDefinedBy "Y. Deldjoo, V. W. Anelli, H. Zamani, A. Bellogin, and T. Di Noia, ‘‘A flexible framework for evaluating user and item fairness in recommender systems,’’ User Modeling and User-Adapted Interaction, vol. 31, no. 3, pp. 457–511, 2021."@en ;
                            rdfs:label "InequalityMinimization"@en ;
                            skos:altLabel "Minimização de Desigualdade"@pt ;
                            skos:definition "Criterion requiring that the dispersion of harm or benefit, measured by an inequality functional, remains comparable across protected groups or bounded for the worst-off group. Grounded in welfare economics and information theory."@en ,
                                            "Critério de fairness que busca minimizar métricas de desigualdade entre grupos."@pt .


###  http://www.usp.br/fmlo#Intersectional
fmlo:Intersectional rdf:type owl:Class ;
                    rdfs:subClassOf fmlo:SocioTechnicalScope ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty fmlo:requiresAccessTo ;
                                      owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
                                      owl:onClass fmlo:SensitiveAttribute
                                    ] ;
                    rdfs:isDefinedBy "M. Kearns, S. Neel, A. Roth, and Z. S. Wu, ‘‘Preventing fairness gerrymandering: Auditing and learning for subgroup fairness,’’ in 35th Int’l Conf. on Machine Learning, pp. 2564–2572, PMLR, 2018."@en ;
                    rdfs:label "Intersectional"@en ;
                    skos:altLabel "Interseccional"@pt ;
                    skos:definition "Nível de escopo que estende critérios baseados em grupo exigindo garantias em interseções de múltiplos atributos."@pt ,
                                    "Scope level that extends group-based criteria by requiring fairness guarantees to hold across intersections of multiple protected attributes."@en .


###  http://www.usp.br/fmlo#Intrinsic
fmlo:Intrinsic rdf:type owl:Class ;
               rdfs:subClassOf fmlo:EvaluationLocus ;
               rdfs:isDefinedBy "Y. Li, M. Du, R. Song, X. Wang, and Y. Wang, ‘‘A survey on fairness in large language models,’’ arXiv preprint arXiv:2308.10149, 2023."@en ;
               rdfs:label "Intrinsic"@en ;
               skos:altLabel "Intrínseco"@pt ;
               skos:definition "Evaluation locus that evaluates fairness directly within the learned representation, by comparing distributional properties of internal scores, distances, similarities, or associations, without reference to explicit decisions, labels, or downstream outcomes."@en ,
                               "Local de avaliação que avalia a equidade diretamente dentro da representação aprendida, comparando propriedades distribucionais de pontuações internas, distâncias, similaridades ou associações, sem referência a decisões explícitas, rótulos ou resultados subsequentes."@pt .


###  http://www.usp.br/fmlo#Invariance
fmlo:Invariance rdf:type owl:Class ;
                rdfs:subClassOf fmlo:FairnessCriterion ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty fmlo:criterionBelongsToApproach ;
                                  owl:hasValue fmlo:Causal_i
                                ] ;
                fmlo:probabilistic_definition "Ŷ(A←a)(x) = Ŷ(A←a')(x), ∀a,a'" ;
                rdfs:isDefinedBy "C. Agarwal, H. Lakkaraju, and M. Zitnik, ‘‘Towards a unified framework for fair and stable graph representation learning,’’ in Uncertainty in artificial intelligence, pp. 2114–2124, PMLR, 2021."@en ;
                rdfs:label "Invariance"@en ;
                skos:altLabel "Invariancia"@pt ;
                skos:definition "Causal criterion imposing a strict equality condition requiring that the model's decision remains mathematically identical for the same individual under any intervention on the protected attribute"@en ,
                                "Critério de fairness baseado em invariância causal das predições."@pt .


###  http://www.usp.br/fmlo#Language
fmlo:Language rdf:type owl:Class ;
              rdfs:subClassOf fmlo:SensitiveAttribute ,
                              [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                       owl:onProperty fmlo:isProxyFor ;
                                                       owl:hasValue fmlo:Ethnicity_i
                                                     ]
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty fmlo:isProxyFor ;
                                                       owl:hasValue fmlo:ImmigrationStatus_i
                                                     ]
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty fmlo:isProxyFor ;
                                                       owl:hasValue fmlo:Nationality_i
                                                     ]
                                                   ) ;
                                rdf:type owl:Class
                              ] ;
              rdfs:isDefinedBy "Fairness at Risk: Where Bias Emerges in Machine Learning"@en ;
              rdfs:label "Language"@en ;
              skos:altLabel "Idioma"@pt ;
              skos:definition "An attribute that refers to the way individuals communicate, encompassing both spoken and written forms."@en ,
                              "Um atributo que se refere à forma como os indivíduos se comunicam, abrangendo formas faladas e escritas."@pt .


###  http://www.usp.br/fmlo#LearningBias
fmlo:LearningBias rdf:type owl:Class ;
                  rdfs:subClassOf fmlo:BiasSource ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty fmlo:originatesIn ;
                                    owl:hasValue fmlo:ModelDevelopment_i
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty fmlo:originatesInPhase ;
                                    owl:hasValue fmlo:InProcessing_i
                                  ] ;
                  rdfs:isDefinedBy "Harini Suresh and John Guttag. 2021. A Framework for Understanding Sources of Harm throughout the Machine Learning Life Cycle. In Proceedings of the 1st ACM Conference on Equity and Access in Algorithms, Mechanisms, and Optimization (EAAMO '21). Association for Computing Machinery, New York, NY, USA, Article 17, 1–9. https://doi.org/10.1145/3465416.3483305"@en ;
                  rdfs:label "LearningBias"@en ;
                  skos:altLabel "Viés de aprendizado"@pt ;
                  skos:definition "Refere-se ao dano que surge durante a fase de treinamento de um modelo de aprendizado de máquina quando as escolhas de modelagem amplificam as disparidades entre grupos, mesmo quando os dados são representativos."@pt ,
                                  "Refers to the harm that arises during the training phase of a machine learning model when modeling choices amplify disparities between groups, even when the data is representative."@en .


###  http://www.usp.br/fmlo#LegalFramework
fmlo:LegalFramework rdf:type owl:Class ;
                    rdfs:subClassOf obo:BFO_0000031 ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty fmlo:protects ;
                                      owl:someValuesFrom fmlo:Data
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty fmlo:hasEnactmentYear ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:integer
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty fmlo:hasJurisdiction ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:string
                                    ] ;
                    rdfs:isDefinedBy "Data Privacy Vocabulary (DPV)"@en ;
                    rdfs:label "LegalFramework"@en ;
                    skos:altLabel "Documento Legal"@pt ;
                    skos:closeMatch <https://w3c.github.io/dpv/2.3/dpv/#Law> ;
                    skos:definition "A formal document issued by a governmental or regulatory authority establishing legal requirements."@en ,
                                    "Um documento formal emitido por autoridade governamental ou reguladora estabelecendo requisitos legais."@pt .


###  http://www.usp.br/fmlo#LifeCycleStage
fmlo:LifeCycleStage rdf:type owl:Class ;
                    rdfs:subClassOf obo:BFO_0000015 ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty fmlo:hasOrder ;
                                      owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                      owl:onDataRange xsd:integer
                                    ] ;
                    rdfs:isDefinedBy "Harini Suresh and John Guttag. 2021. A Framework for Understanding Sources of Harm throughout the Machine Learning Life Cycle. In Proceedings of the 1st ACM Conference on Equity and Access in Algorithms, Mechanisms, and Optimization (EAAMO '21). Association for Computing Machinery, New York, NY, USA, Article 17, 1–9. https://doi.org/10.1145/3465416.3483305"@en ;
                    rdfs:label "LifeCycleStage"@en ;
                    skos:altLabel "Estágio do Ciclo de Vida"@pt ;
                    skos:definition "Broader stage within the machine learning development lifecycle, from problem formulation through deployment and monitoring."@en ,
                                    "Estágio mais amplo dentro do ciclo de vida de desenvolvimento de ML."@pt .


###  http://www.usp.br/fmlo#LossBased
fmlo:LossBased rdf:type owl:Class ;
               rdfs:subClassOf fmlo:FairnessCriterion ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty fmlo:criterionBelongsToApproach ;
                                 owl:hasValue fmlo:Statistical_i
                               ] ;
               rdfs:isDefinedBy "Fairness at Risk: Bias-Discovery and Mitigation Solutions"@en ;
               rdfs:label "LossBased"@en ;
               skos:altLabel "Baseado em Perda"@pt ;
               skos:definition "Criteria that emerges when standard performance measures are directly repurposed as fairness objectives."@en ,
                               "Critério de fairness baseado em funções de perda equalizadas entre grupos."@pt .


###  http://www.usp.br/fmlo#MLTask
fmlo:MLTask rdf:type owl:Class ;
            rdfs:subClassOf obo:BFO_0000015 ;
            rdfs:isDefinedBy "Fairness at Risk: Bias-Discovery and Mitigation Solutions"@en ;
            rdfs:label "MLTask"@en ;
            skos:altLabel "tarefa de ML"@pt ;
            skos:closeMatch <https://purl.org/twc/fmo#MLProblem%20> ;
            skos:definition "A specific computational problem or learning objective addressed by a machine learning system."@en ,
                            "Um problema computacional específico ou objetivo de aprendizado endereçado por um sistema de aprendizado de máquina."@pt .


###  http://www.usp.br/fmlo#MaritalStatus
fmlo:MaritalStatus rdf:type owl:Class ;
                   rdfs:subClassOf fmlo:SensitiveAttribute ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty fmlo:isClassifiedAs ;
                                     owl:hasValue fmlo:ProtectedCharacteristic_i
                                   ] ;
                   rdfs:isDefinedBy "UNSTAT: Principles and Recommendations for Population and Housing Censuses; Series M No. 67/Rev.2. https://www.unescwa.org/sd-glossary/marital-status"@en ;
                   rdfs:label "MaritalStatus"@en ;
                   skos:altLabel "CivilPartnerships"@en ,
                                 "Estado Civil"@pt ;
                   skos:definition "An attribute that refers to the personal status of each individual in relation to marriage or civil partnership."@en ,
                                   "Um atributo que se refere ao status pessoal de cada indivíduo em relação ao casamento ou parceria civil."@pt .


###  http://www.usp.br/fmlo#MeasurementBias
fmlo:MeasurementBias rdf:type owl:Class ;
                     rdfs:subClassOf fmlo:BiasSource ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty fmlo:originatesIn ;
                                       owl:hasValue fmlo:DataCollection_i
                                     ] ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty fmlo:originatesInPhase ;
                                       owl:hasValue fmlo:PreProcessing_i
                                     ] ;
                     rdfs:isDefinedBy "Harini Suresh and John Guttag. 2021. A Framework for Understanding Sources of Harm throughout the Machine Learning Life Cycle. In Proceedings of the 1st ACM Conference on Equity and Access in Algorithms, Mechanisms, and Optimization (EAAMO '21). Association for Computing Machinery, New York, NY, USA, Article 17, 1–9. https://doi.org/10.1145/3465416.3483305"@en ;
                     rdfs:label "MeasurementBias"@en ;
                     skos:altLabel "Viés de mensuração"@pt ;
                     skos:definition "Occurs when there are errors or inconsistencies in choosing, collecting, or computing features and labels."@en ,
                                     "Ocorre quando há erros ou inconsistências na escolha, coleta ou computação de features e labels."@pt .


###  http://www.usp.br/fmlo#MeasurementTechnique
fmlo:MeasurementTechnique rdf:type owl:Class ;
                          rdfs:subClassOf fmlo:BiasDiscoveryTechnique ;
                          rdfs:isDefinedBy "Fairness at Risk: Bias-Discovery and Mitigation Solutions"@en ;
                          rdfs:label "MeasurementTechnique"@en ;
                          skos:altLabel "Técnica de Medição"@pt ;
                          skos:definition "Discovery methods whose primary contribution is proposing a novel fairness notion or quantification framework, rather than using existing metrics as validation tools."@en ,
                                          "Métodos de descoberta cuja contribuição principal é propor uma nova noção de fairness ou framework de quantificação."@pt .


###  http://www.usp.br/fmlo#MethodologicalApproach
fmlo:MethodologicalApproach rdf:type owl:Class ;
                            rdfs:subClassOf obo:BFO_0000031 ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty fmlo:approachHasCriterion ;
                                              owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onClass fmlo:FairnessCriterion
                                            ] ;
                            rdfs:isDefinedBy "Fairness at Risk: Bias-Discovery and Mitigation Solutions"@en ;
                            rdfs:label "MethodologicalApproach"@en ;
                            skos:altLabel "Abordagem Metodológica"@pt ;
                            skos:definition "Especifica o aparato formal pelo qual fairness é expressa e avaliada em sistemas de ML."@pt ,
                                            "Specifies the formal apparatus through which fairness is expressed and evaluated in ML systems."@en .


###  http://www.usp.br/fmlo#MetricOperationalization
fmlo:MetricOperationalization rdf:type owl:Class ;
                              rdfs:subClassOf obo:BFO_0000031 ;
                              rdfs:isDefinedBy "Fairness at Risk: Bias-Discovery and Mitigation Solutions"@en ;
                              rdfs:label "MetricOperationalization"@en ;
                              skos:altLabel "Operacionalização de Métrica"@pt ;
                              skos:definition "Classifica métricas de fairness pelo seu método de computação matemático."@pt ,
                                              "Classifies fairness metrics by their mathematical computation method."@en .


###  http://www.usp.br/fmlo#ModelCentricTechnique
fmlo:ModelCentricTechnique rdf:type owl:Class ;
                           rdfs:subClassOf fmlo:ExploratoryTechnique ;
                           rdfs:isDefinedBy "Fairness at Risk: Bias-Discovery and Mitigation Solutions"@en ;
                           rdfs:label "ModelCentricTechnique"@en ;
                           skos:altLabel "Técnica Centrada no Modelo"@pt ;
                           skos:definition "Exploratory methods that empirically analyze a trained models outputs, applying fairness metrics or qualitative inspections to identify performance disparities across demographic subgroups."@en ,
                                           "Métodos exploratórios que analisam empiricamente as saídas de um modelo treinado."@pt .


###  http://www.usp.br/fmlo#ModelDeployment
fmlo:ModelDeployment rdf:type owl:Class ;
                     rdfs:subClassOf fmlo:LifeCycleStage ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty fmlo:hasMappedPhase ;
                                       owl:hasValue fmlo:PostProcessing_i
                                     ] ;
                     rdfs:isDefinedBy "Harini Suresh and John Guttag. 2021. A Framework for Understanding Sources of Harm throughout the Machine Learning Life Cycle. In Proceedings of the 1st ACM Conference on Equity and Access in Algorithms, Mechanisms, and Optimization (EAAMO '21). Association for Computing Machinery, New York, NY, USA, Article 17, 1–9. https://doi.org/10.1145/3465416.3483305"@en ;
                     rdfs:label "ModelDeployment"@en ;
                     skos:altLabel "Implantação do Modelo"@pt ;
                     skos:definition "Etapa em que um modelo treinado é integrado a um contexto do mundo real, envolvendo o design da interface do usuário, requisitos de explicabilidade, mecanismos de feedback e interação com tomadores de decisão humanos."@pt ,
                                     "Stage in which a trained model is integrated into a real-world context, involving user interface design, explainability requirements, feedback mechanisms, and interaction with human decision-makers."@en .


###  http://www.usp.br/fmlo#ModelDevelopment
fmlo:ModelDevelopment rdf:type owl:Class ;
                      rdfs:subClassOf fmlo:LifeCycleStage ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty fmlo:hasMappedPhase ;
                                        owl:hasValue fmlo:InProcessing_i
                                      ] ;
                      rdfs:isDefinedBy "Harini Suresh and John Guttag. 2021. A Framework for Understanding Sources of Harm throughout the Machine Learning Life Cycle. In Proceedings of the 1st ACM Conference on Equity and Access in Algorithms, Mechanisms, and Optimization (EAAMO '21). Association for Computing Machinery, New York, NY, USA, Article 17, 1–9. https://doi.org/10.1145/3465416.3483305"@en ;
                      rdfs:label "ModelDevelopment"@en ;
                      skos:altLabel "Desenvolvimento do Modelo"@pt ;
                      skos:definition "Estágio no qual modelos são construídos usando dados de treino."@pt ,
                                      "Stage in which models are built using training data, involving architecture instantiation and optimization."@en .


###  http://www.usp.br/fmlo#ModelEvaluation
fmlo:ModelEvaluation rdf:type owl:Class ;
                     rdfs:subClassOf fmlo:LifeCycleStage ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty fmlo:hasMappedPhase ;
                                       owl:hasValue fmlo:PostProcessing_i
                                     ] ;
                     rdfs:isDefinedBy "Harini Suresh and John Guttag. 2021. A Framework for Understanding Sources of Harm throughout the Machine Learning Life Cycle. In Proceedings of the 1st ACM Conference on Equity and Access in Algorithms, Mechanisms, and Optimization (EAAMO '21). Association for Computing Machinery, New York, NY, USA, Article 17, 1–9. https://doi.org/10.1145/3465416.3483305"@en ;
                     rdfs:label "ModelEvaluation"@en ;
                     skos:altLabel "Avaliação do Modelo"@pt ;
                     skos:definition "Etapa em que o desempenho do modelo final é avaliado em dados de teste reservados e conjuntos de dados de referência externos, usando métricas específicas da tarefa para medir a qualidade e a generalização."@pt ,
                                     "Stage in which the final model's performance is assessed on held-out test data and external benchmark datasets, using task-specific metrics to measure quality and generalization."@en .


###  http://www.usp.br/fmlo#ModelPostProcessing
fmlo:ModelPostProcessing rdf:type owl:Class ;
                         rdfs:subClassOf fmlo:LifeCycleStage ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty fmlo:hasMappedPhase ;
                                           owl:hasValue fmlo:PostProcessing_i
                                         ] ;
                         rdfs:isDefinedBy "Harini Suresh and John Guttag. 2021. A Framework for Understanding Sources of Harm throughout the Machine Learning Life Cycle. In Proceedings of the 1st ACM Conference on Equity and Access in Algorithms, Mechanisms, and Optimization (EAAMO '21). Association for Computing Machinery, New York, NY, USA, Article 17, 1–9. https://doi.org/10.1145/3465416.3483305"@en ;
                         rdfs:label "ModelPostProcessing"@en ;
                         skos:altLabel "Pós-processamento do Modelo"@pt ;
                         skos:definition "Estágio envolvendo transformações aplicadas às saídas do modelo após o treino."@pt ,
                                         "Stage involving transformations applied to model outputs after training, such as threshold selection."@en .


###  http://www.usp.br/fmlo#MotionStatus
fmlo:MotionStatus rdf:type owl:Class ;
                  rdfs:subClassOf fmlo:SensitiveAttribute ;
                  rdfs:isDefinedBy "Sun, Y., Haghighat, F., & Fung, B. C. (2022). Trade-off between accuracy and fairness of data-driven building and indoor environment models: A comparative study of pre-processing methods. Energy, 239, 122273."@en ;
                  rdfs:label "MotionStatus"@en ;
                  skos:altLabel "Estado de movimento"@pt ;
                  skos:definition "An attribute that refers to the operational state of devices, sensors or systems, commonly used in smart environments."@en ,
                                  "Um atributo que se refere ao estado operacional de dispositivos, sensores ou sistemas, comumente usado em ambientes inteligentes."@pt .


###  http://www.usp.br/fmlo#Nationality
fmlo:Nationality rdf:type owl:Class ;
                 rdfs:subClassOf fmlo:SensitiveAttribute ,
                                 [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                          owl:onProperty fmlo:isClassifiedAs ;
                                                          owl:hasValue fmlo:ProtectedCharacteristic_i
                                                        ]
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty fmlo:isClassifiedAs ;
                                                          owl:hasValue fmlo:SensitivePersonalData_i
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] ;
                 rdfs:isDefinedBy "International Organization for Migration. International Migration Law. Glossary on Migration (2019)"@en ;
                 rdfs:label "Nationality"@en ;
                 skos:altLabel "Nacionalidade"@pt ;
                 skos:definition "An attribute that refers to the country of origin or citizenship of an individual."@en ,
                                 "Um atributo que se refere ao país de origem ou cidadania de um indivíduo."@pt .


###  http://www.usp.br/fmlo#NormativeDimension
fmlo:NormativeDimension rdf:type owl:Class ;
                        rdfs:subClassOf obo:BFO_0000031 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty fmlo:isPrincipleOf ;
                                          owl:someValuesFrom fmlo:EthicalDimension
                                        ] ;
                        rdfs:isDefinedBy "Fairness at Risk: Bias-Discovery and Mitigation Solutions"@en ;
                        rdfs:label "NormativePrinciples"@en ;
                        skos:altLabel "Dimensão Normativa"@pt ;
                        skos:definition "Acts as the translation layer between abstract ethical values and technical implementation, specifying the prescriptive criteria that define a fair state. Incorporates established legal doctrines and normative principles that capture how discrimination is manifested in algorithmic decision-making."@en ,
                                        "Atua como camada de tradução entre valores éticos abstratos e implementação técnica, especificando os critérios prescritivos que definem um Estado justo. Incorpora doutrinas jurídicas estabelecidas e princípios normativos que capturam como a discriminação se manifesta na tomada de decisões algorítmicas."@pt .


###  http://www.usp.br/fmlo#Occupation
fmlo:Occupation rdf:type owl:Class ;
                rdfs:subClassOf fmlo:SensitiveAttribute ,
                                [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                         owl:onProperty fmlo:isProxyFor ;
                                                         owl:hasValue fmlo:EconomicalStatus_i
                                                       ]
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty fmlo:isProxyFor ;
                                                         owl:hasValue fmlo:EducationalLevel_i
                                                       ]
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty fmlo:isProxyFor ;
                                                         owl:hasValue fmlo:Gender_i
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] ;
                rdfs:isDefinedBy "International Labour Organization (ILO), International Standard Classification of Occupations (ISCO-08), 2008. https://ilostat.ilo.org/methods/concepts-and-definitions/classification-occupation/"@en ;
                rdfs:label "Occupation"@en ;
                skos:altLabel "Ocupação"@pt ;
                skos:definition "An attribute that refers to the kind of work performed by an individual."@en ,
                                "Um atributo que se refere ao tipo de trabalho realizado por um indivíduo."@pt .


###  http://www.usp.br/fmlo#Ordinal
fmlo:Ordinal rdf:type owl:Class ;
             rdfs:subClassOf fmlo:Categorical ;
             rdfs:isDefinedBy "Statistics ontology (STATO)"@en ;
             rdfs:label "Ordinal"@en ;
             skos:altLabel "Ordinal"@pt ;
             skos:closeMatch obo:STATO_0000228 ;
             skos:definition "A categorical data type whose values are ordered or ranked, but where the differences between categories are not necessarily measurable or equal."@en ,
                             "Tipo de dado categórico cujos valores são ordenados ou classificados, mas onde as diferenças entre categorias não são necessariamente mensuráveis ou iguais."@pt .


###  http://www.usp.br/fmlo#PathSpecificCounterfactualFairness
fmlo:PathSpecificCounterfactualFairness rdf:type owl:Class ;
                                        rdfs:subClassOf fmlo:FairnessNotion ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty fmlo:hasEthicalDimension ;
                                                          owl:hasValue fmlo:ProceduralJustice_i
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty fmlo:hasEvaluationLocus ;
                                                          owl:hasValue fmlo:Extrinsic_i
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty fmlo:hasMethodologicalApproach ;
                                                          owl:hasValue fmlo:Causal_i
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty fmlo:hasNormativePrinciple ;
                                                          owl:hasValue fmlo:DisparateTreatment_i
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty fmlo:hasSocioTechnicalScope ;
                                                          owl:hasValue fmlo:Individual_i
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty fmlo:isSpecialCaseOf ;
                                                          owl:hasValue fmlo:CounterfactualFairness_i
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty fmlo:satisfiesCriterion ;
                                                          owl:hasValue fmlo:Invariance_i
                                                        ] ;
                                        rdfs:isDefinedBy "S. Chiappa, ‘‘Path-specific counterfactual fairness,’’ in AAAI Conf. on Art. Int., vol. 33, pp. 7801–7808, 2019."@en ;
                                        rdfs:label "PathSpecificCounterfactualFairness"@en ;
                                        skos:altLabel "Contrafactual Específico de Caminho"@pt ,
                                                      "Path-specific CF"@en ;
                                        skos:definition "Refinamento de Counterfactual Fairness permitindo influência apenas por caminhos causais admissíveis."@pt ,
                                                        "Refinement of Counterfactual Fairness allowing the protected attribute to influence predictions only through predefined admissible causal paths, requiring invariance under interventions along all disallowed paths while permitting effects through justified paths."@en .


###  http://www.usp.br/fmlo#PerformanceBound
fmlo:PerformanceBound rdf:type owl:Class ;
                      rdfs:subClassOf fmlo:LossBased ;
                      fmlo:probabilistic_definition "E[L | A=a] ≤ ζ, ∀a"@en ;
                      rdfs:isDefinedBy "Fairness at Risk: Bias-Discovery and Mitigation Solutions"@en ;
                      rdfs:label "PerformanceBound"@en ;
                      skos:altLabel "Limite de Desempenho"@pt ;
                      skos:definition "Critério baseado em perda que relaxa paridade estrita em uma garantia mínima de serviço."@pt ,
                                      "Loss-based criteria that relaxes strict parity into a minimum-service guarantee."@en .


###  http://www.usp.br/fmlo#PerformanceOriented
fmlo:PerformanceOriented rdf:type owl:Class ;
                         rdfs:subClassOf fmlo:FairnessNotion ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty fmlo:hasEthicalDimension ;
                                           owl:hasValue fmlo:DistributiveJustice_i
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty fmlo:hasEvaluationLocus ;
                                           owl:hasValue fmlo:Extrinsic_i
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty fmlo:hasMethodologicalApproach ;
                                           owl:hasValue fmlo:Statistical_i
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty fmlo:hasNormativePrinciple ;
                                           owl:hasValue fmlo:DisparateMistreatment_i
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty fmlo:hasSocioTechnicalScope ;
                                           owl:hasValue fmlo:Group_i
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty fmlo:satisfiesCriterion ;
                                           owl:hasValue fmlo:LossBased_i
                                         ] ;
                         rdfs:isDefinedBy "Fairness at Risk: Bias-Discovery and Mitigation Solutions"@en ;
                         rdfs:label "PerformanceOriented"@en ;
                         skos:altLabel "Orientado ao Desempenho"@pt ;
                         skos:definition "Fairness notions requiring predictive performance to be equitable across protected groups."@en ,
                                         "Noções de fairness que requerem desempenho preditivo equitativo entre grupos protegidos."@pt .


###  http://www.usp.br/fmlo#PerformanceParity
fmlo:PerformanceParity rdf:type owl:Class ;
                       rdfs:subClassOf fmlo:LossBased ;
                       fmlo:probabilistic_definition "⊮(R=Y) ⊥ A"@en ;
                       rdfs:isDefinedBy "Fairness at Risk: Bias-Discovery and Mitigation Solutions"@en ;
                       rdfs:label "PerformanceParity"@en ;
                       skos:altLabel "Paridade de Desempenho"@pt ;
                       skos:definition "Critério baseado em perda que requer sucesso preditivo geral invariante entre grupos."@pt ,
                                       "Loss-based criteria that requires overall predictive success to be invariant across groups."@en .


###  http://www.usp.br/fmlo#PersonalData
fmlo:PersonalData rdf:type owl:Class ;
                  rdfs:subClassOf fmlo:Data ;
                  rdfs:isDefinedBy "Gereral data protection regulation (GDPR) - Art. 4. https://gdpr.eu/article-4-definitions/"@en ;
                  rdfs:label "PersonalData"@en ;
                  skos:altLabel "Dado Pessoal"@pt ;
                  skos:definition "Any information relating to an identified or identifiable natural person."@en ,
                                  "Qualquer informação relativa a uma pessoa natural identificada ou identificável."@pt .


###  http://www.usp.br/fmlo#PoliticalAffiliation
fmlo:PoliticalAffiliation rdf:type owl:Class ;
                          rdfs:subClassOf fmlo:SensitiveAttribute ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty fmlo:isClassifiedAs ;
                                            owl:hasValue fmlo:SensitivePersonalData_i
                                          ] ;
                          rdfs:isDefinedBy "adapted from: General Data Protection Regulation, recital 56. Avaliable: https://gdpr.eu/recital-56-processing-personal-data-on-peoples-political-opinions-by-parties/"@en ;
                          rdfs:label "PoliticalAffiliation"@en ;
                          skos:altLabel "Filiação Política"@pt ;
                          skos:definition "A sensitive attribute referring to an individual's identification with, or support for, a particular political party, ideology, or movement"@en ,
                                          "Um atributo sensível que se refere à identificação de um indivíduo com, ou ao apoio a, um determinado partido político, ideologia ou movimento."@pt .


###  http://www.usp.br/fmlo#PostProcessing
fmlo:PostProcessing rdf:type owl:Class ;
                    rdfs:subClassOf fmlo:ProcessingPhase ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty fmlo:mapsToStage ;
                                      owl:hasValue fmlo:ModelDeployment_i
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty fmlo:mapsToStage ;
                                      owl:hasValue fmlo:ModelEvaluation_i
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty fmlo:mapsToStage ;
                                      owl:hasValue fmlo:ModelPostProcessing_i
                                    ] ;
                    rdfs:isDefinedBy "Fairness at Risk: Where Bias Emerges in Machine Learning"@en ;
                    rdfs:label "PostProcessing"@en ;
                    skos:altLabel "Pós-processamento"@pt ;
                    skos:definition "Fase de processamento do ciclo de vida do aprendizado de máquina que ocorre após o treinamento do modelo, abrangendo a geração de previsões, o ajuste de saída e as decisões de implantação."@pt ,
                                    "Processing phase of the ML lifecycle occurring after model training, encompassing prediction generation, output adjustment, and deployment decisions."@en .


###  http://www.usp.br/fmlo#PostProcessingBias
fmlo:PostProcessingBias rdf:type owl:Class ;
                        rdfs:subClassOf fmlo:BiasSource ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty fmlo:originatesIn ;
                                          owl:hasValue fmlo:ModelPostProcessing_i
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty fmlo:originatesInPhase ;
                                          owl:hasValue fmlo:PostProcessing_i
                                        ] ;
                        rdfs:isDefinedBy "Fairness at Risk: Where Bias Emerges in Machine Learning"@en ;
                        rdfs:label "PostProcessingBias"@en ;
                        skos:altLabel "Viés de pós-processamento"@pt ;
                        skos:definition "Occurs when steps taken to prepare the model output for deployment, such as setting decision thresholds, introduce bias."@en ,
                                        "Ocorre quando etapas tomadas para preparar a saída do modelo para implantação, como definir limiares de decisão, introduzem viés."@pt .


###  http://www.usp.br/fmlo#PreProcessing
fmlo:PreProcessing rdf:type owl:Class ;
                   rdfs:subClassOf fmlo:ProcessingPhase ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty fmlo:mapsToStage ;
                                     owl:hasValue fmlo:DataCollection_i
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty fmlo:mapsToStage ;
                                     owl:hasValue fmlo:DataPreparation_i
                                   ] ;
                   rdfs:isDefinedBy "Fairness at Risk: Where Bias Emerges in Machine Learning"@en ;
                   rdfs:label "PreProcessing"@en ;
                   skos:altLabel "Pré-processamento"@pt ;
                   skos:definition "Fase de processamento do ciclo de vida do aprendizado de máquina que ocorre antes do treinamento do modelo, abrangendo todas as atividades relacionadas à coleta, preparação e transformação de dados."@pt ,
                                   "Processing phase of the ML lifecycle occurring before model training, encompassing all activities related to data collection, preparation, and transformation."@en .


###  http://www.usp.br/fmlo#PreProcessingBias
fmlo:PreProcessingBias rdf:type owl:Class ;
                       rdfs:subClassOf fmlo:BiasSource ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty fmlo:originatesIn ;
                                         owl:hasValue fmlo:DataPreparation_i
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty fmlo:originatesInPhase ;
                                         owl:hasValue fmlo:PreProcessing_i
                                       ] ;
                       rdfs:isDefinedBy "Sorelle A. Friedler, Carlos Scheidegger, Suresh Venkatasubramanian, Sonam Choudhary, Evan P. Hamilton, and Derek Roth. 2019. A comparative study of fairness-enhancing interventions in machine learning. In Proceedings of the Conference on Fairness, Accountability, and Transparency (FAT* '19). Association for Computing Machinery, New York, NY, USA, 329–338. https://doi.org/10.1145/3287560.3287589"@en ;
                       rdfs:label "PreProcessingBias"@en ;
                       skos:altLabel "Viés de pré-processamento"@pt ;
                       skos:definition "Occurs when decisions related to data cleaning, transformation, handling missing values or splitting introduce or amplify bias."@en ,
                                       "Ocorre quando decisões relacionadas à limpeza, transformação, tratamento de valores ausentes ou divisão de dados introduzem ou amplificam o viés."@pt .


###  http://www.usp.br/fmlo#PredictiveEquality
fmlo:PredictiveEquality rdf:type owl:Class ;
                        rdfs:subClassOf fmlo:FairnessNotion ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty fmlo:hasEthicalDimension ;
                                          owl:hasValue fmlo:DistributiveJustice_i
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty fmlo:hasEvaluationLocus ;
                                          owl:hasValue fmlo:Extrinsic_i
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty fmlo:hasMethodologicalApproach ;
                                          owl:hasValue fmlo:Statistical_i
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty fmlo:hasNormativePrinciple ;
                                          owl:hasValue fmlo:DisparateMistreatment_i
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty fmlo:hasSocioTechnicalScope ;
                                          owl:hasValue fmlo:Group_i
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty fmlo:isSpecialCaseOf ;
                                          owl:hasValue fmlo:EqualizedOdds_i
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty fmlo:satisfiesCriterion ;
                                          owl:hasValue fmlo:Separation_i
                                        ] ;
                        rdfs:isDefinedBy "A. Castelnovo, R. Crupi, G. Greco, D. Regoli, I. G. Penco, and A. C. Cosentini, ‘‘A clarification of the nuances in the fairness metrics landscape,’’ Scientific Reports, vol. 12, no. 1, p. 4209, 2022."@en ;
                        rdfs:label "PredictiveEquality"@en ;
                        skos:altLabel "Balance on Negative Class"@en ,
                                      "Igualdade Preditiva"@pt ;
                        skos:definition "Noção de Separação unilateral aplicada à classe negativa requerendo paridade de FPR entre grupos."@pt ,
                                        "One-sided Separation notion applied to the negative class requiring FPR parity across groups."@en .


###  http://www.usp.br/fmlo#PredictiveParity
fmlo:PredictiveParity rdf:type owl:Class ;
                      rdfs:subClassOf fmlo:FairnessNotion ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty fmlo:belongsToFamily ;
                                        owl:hasValue fmlo:CalibrationRate_i
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty fmlo:hasCausalAnalogue ;
                                        owl:hasValue fmlo:CounterfactualFairness_i
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty fmlo:hasEthicalDimension ;
                                        owl:hasValue fmlo:DistributiveJustice_i
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty fmlo:hasEvaluationLocus ;
                                        owl:hasValue fmlo:Extrinsic_i
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty fmlo:hasMethodologicalApproach ;
                                        owl:hasValue fmlo:Causal_i
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty fmlo:hasMethodologicalApproach ;
                                        owl:hasValue fmlo:Statistical_i
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty fmlo:hasNormativePrinciple ;
                                        owl:hasValue fmlo:DisparateImpact_i
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty fmlo:hasSocioTechnicalScope ;
                                        owl:hasValue fmlo:Group_i
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty fmlo:isSpecialCaseOf ;
                                        owl:hasValue fmlo:Calibration_i
                                      ] ;
                      rdfs:comment """Causal formulation by \"S. Corbett-Davies, J. D. Gaebler, H. Nilforoshan, R. Shroff, and S. Goel,‘‘The measure and mismeasure of fairness,’’ Journal of Machine Learning
Research, vol. 24, no. 312, pp. 1–117, 2023.\""""@en ;
                      rdfs:isDefinedBy "A. Castelnovo, R. Crupi, G. Greco, D. Regoli, I. G. Penco, and A. C. Cosentini, ‘‘A clarification of the nuances in the fairness metrics landscape,’’ Scientific Reports, vol. 12, no. 1, p. 4209, 2022."@en ;
                      rdfs:label "PredictiveParity"@en ;
                      skos:altLabel "Equal PPV"@en ,
                                    "Paridade Preditiva"@pt ;
                      skos:definition "Instanciação unilateral baseada em rótulos de Suficiência requerendo PPV igual entre grupos."@pt ,
                                      "One-sided, label-based instantiation of Sufficiency requiring equal Positive Predictive Value (PPV) across groups."@en .


###  http://www.usp.br/fmlo#PregnancyAndMaternity
fmlo:PregnancyAndMaternity rdf:type owl:Class ;
                           rdfs:subClassOf fmlo:SensitiveAttribute ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty fmlo:isClassifiedAs ;
                                             owl:hasValue fmlo:ProtectedCharacteristic_i
                                           ] ;
                           rdfs:isDefinedBy "Equality and Human Rights Commission (EHRC). \"Protected characteristics.\" Equality Act 2010. Avaliable: https://www.equalityhumanrights.com/equality/equality-act-2010/protected-characteristics#pregnancy-and-maternity"@en ;
                           rdfs:label "PregnancyAndMaternity"@en ;
                           skos:altLabel "Gravidez e Maternidade"@pt ;
                           skos:definition "An attribute representing the condition of being pregnant or having recently given birth."@en ,
                                           "Um atributo representando a condição de estar grávida ou ter dado à luz recentemente."@pt .


###  http://www.usp.br/fmlo#ProceduralJustice
fmlo:ProceduralJustice rdf:type owl:Class ;
                       rdfs:subClassOf fmlo:EthicalDimension ;
                       rdfs:isDefinedBy "J. Thibaut, ‘‘Procedural justice: A psychological analysis,’’ Lawrance Erlbaum Associates, 1975."@en ;
                       rdfs:label "ProceduralJustice"@en ;
                       skos:altLabel "Justiça Procedimental"@pt ;
                       skos:definition "Dimensão ética que se preocupa com a justiça dos processos e procedimentos de tomada de decisão."@pt ,
                                       "Ethical orientation where fairness is conceptualized as the equity of the decision-making process itself, focusing on whether decisions are generated through consistent treatment of similar individuals, without unjustified use of sensitive attributes or structural biases in the modeling pipeline."@en .


###  http://www.usp.br/fmlo#ProcessingPhase
fmlo:ProcessingPhase rdf:type owl:Class ;
                     rdfs:subClassOf obo:BFO_0000015 ,
                                     [ rdf:type owl:Restriction ;
                                       owl:onProperty fmlo:hasOrder ;
                                       owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                       owl:onDataRange xsd:integer
                                     ] ;
                     rdfs:isDefinedBy "Fairness at Risk: Where Bias Emerges in Machine Learning"@en ;
                     rdfs:label "ProcessingPhase"@en ;
                     skos:altLabel "Fase de Processamento"@pt ;
                     skos:definition "Estágios do ciclo de vida do ML que caracterizam quando uma intervenção ou análise ocorre em relação ao treino."@pt ,
                                     "Phases of the machine learning lifecycle that characterize when an intervention or analysis occurs relative to model training."@en .


###  http://www.usp.br/fmlo#ProtectedCharacteristic
fmlo:ProtectedCharacteristic rdf:type owl:Class ;
                             rdfs:subClassOf fmlo:Data ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty fmlo:classifies ;
                                               owl:someValuesFrom fmlo:SensitiveAttribute
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty fmlo:protectedBy ;
                                               owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass fmlo:LegalFramework
                                             ] ;
                             rdfs:isDefinedBy "Equality Act 2010 (UK). https://www.legislation.gov.uk/ukpga/2010/15/part/2"@en ;
                             rdfs:label "ProtectedCharacteristic"@en ;
                             skos:altLabel "Característica Protegida"@pt ;
                             skos:definition "Características de indivíduos legalmente reconhecidas como base para proteção contra discriminação."@pt ,
                                             "Characteristics of individuals that are legally recognized as grounds for protection against discrimination."@en .


###  http://www.usp.br/fmlo#PseudoAnonymousData
fmlo:PseudoAnonymousData rdf:type owl:Class ;
                         rdfs:subClassOf fmlo:PersonalData ;
                         rdfs:isDefinedBy "Gereral data protection regulation (GDPR) - Art. 4. https://gdpr.eu/article-4-definitions/"@en ;
                         rdfs:label "PseudoAnonymousData"@en ;
                         skos:altLabel "Dado Pseudo-anônimo"@pt ;
                         skos:definition "Dado pessoal que não pode mais ser atribuído a um titular de dados específico sem o uso de informações adicionais."@pt ,
                                         "Personal data that can no longer be attributed to a specific data subject without the use of additional information."@en .


###  http://www.usp.br/fmlo#Race
fmlo:Race rdf:type owl:Class ;
          rdfs:subClassOf fmlo:SensitiveAttribute ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty fmlo:isClassifiedAs ;
                            owl:hasValue fmlo:ProtectedCharacteristic_i
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty fmlo:isClassifiedAs ;
                            owl:hasValue fmlo:SensitivePersonalData_i
                          ] ;
          rdfs:isDefinedBy "Edwards, C. L., Fillingim, R. B., & Keefe, F. (2001). Race, ethnicity and pain. Pain, 94(2), 133-137."@en ;
          rdfs:label "Race"@en ;
          skos:altLabel "Raça"@pt ;
          skos:definition "An attribute that classifies individuals primarily on the basis of physical characteristics."@en ,
                          "Um atributo que classifica indivíduos principalmente com base em características físicas."@pt .


###  http://www.usp.br/fmlo#RatioBased
fmlo:RatioBased rdf:type owl:Class ;
                rdfs:subClassOf fmlo:MetricOperationalization ;
                rdfs:isDefinedBy "Statistics ontology (STATO) ."@en ;
                rdfs:label "RatioBased"@en ;
                skos:altLabel "Baseado em Razão"@pt ;
                skos:closeMatch obo:STATO_0000613 ;
                skos:definition "Operacionalização que quantifica fairness como a razão entre estatísticas condicionais de grupo."@pt ,
                                "Operationalization that quantifies fairness as the ratio between group-conditional statistics."@en .


###  http://www.usp.br/fmlo#Relational
fmlo:Relational rdf:type owl:Class ;
                rdfs:subClassOf fmlo:FairnessCriterion ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty fmlo:criterionBelongsToApproach ;
                                  owl:hasValue fmlo:Statistical_i
                                ] ;
                fmlo:probabilistic_definition "E[S(Z,C) | A=a] ≈ E[S(Z,C) | A=b]" ;
                rdfs:isDefinedBy "A. Caliskan, J. J. Bryson, and A. Narayanan, ‘‘Semantics derived automatically from language corpora contain human-like biases,’’ Sci., vol. 356, no. 6334, pp. 183–186, 2017."@en ;
                rdfs:label "Relational"@en ;
                skos:altLabel "Relacional"@pt ;
                skos:definition "Criterion that captures whether embeddings encode group-dependent stereotypical structure through systematic differences in semantic proximity patterns, requiring invariant expected association strength across groups"@en ,
                                "Critério de fairness baseado em relações entre indivíduos."@pt .


###  http://www.usp.br/fmlo#Religion
fmlo:Religion rdf:type owl:Class ;
              rdfs:subClassOf fmlo:SensitiveAttribute ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty fmlo:isClassifiedAs ;
                                owl:hasValue fmlo:ProtectedCharacteristic_i
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty fmlo:isClassifiedAs ;
                                owl:hasValue fmlo:SensitivePersonalData_i
                              ] ,
                              [ rdf:type owl:Restriction ;
                                owl:onProperty fmlo:isProxyFor ;
                                owl:hasValue fmlo:Ethnicity_i
                              ] ;
              rdfs:isDefinedBy "Equality and Human Rights Commission (EHRC). \"Protected characteristics.\" Equality Act 2010. Avaliable: https://www.equalityhumanrights.com/equality/equality-act-2010/protected-characteristics#religion"@en ;
              rdfs:label "Religion"@en ;
              skos:altLabel "Religião"@pt ;
              skos:definition "A sensitive attribute referring to an individuals religious beliefs or affiliation."@en ,
                              "Um atributo sensível referente às crenças religiosas ou afiliação de um indivíduo."@pt .


###  http://www.usp.br/fmlo#RepresentationBased
fmlo:RepresentationBased rdf:type owl:Class ;
                         rdfs:subClassOf fmlo:StatisticalFamily ,
                                         [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                  owl:onProperty fmlo:hasCriterion ;
                                                                  owl:hasValue fmlo:Distributional_i
                                                                ]
                                                                [ rdf:type owl:Restriction ;
                                                                  owl:onProperty fmlo:hasCriterion ;
                                                                  owl:hasValue fmlo:Relational_i
                                                                ]
                                                              ) ;
                                           rdf:type owl:Class
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty fmlo:isFamilyOf ;
                                           owl:hasValue fmlo:Intrinsic_i
                                         ] ;
                         rdfs:isDefinedBy "I. Dominguez-Catena, D. Paternain, and M. Galar, ‘‘Metrics for dataset demographic bias: A case study on facial expression recognition,’’ IEEE Transactions on Pattern Analysis and Machine Int., vol. 46, no. 8, pp. 5209–5226, 2024."@en ;
                         rdfs:label "RepresentationBased"@en ;
                         skos:altLabel "Baseado em Representação"@pt ;
                         skos:definition "Família estatística que avalia fairness diretamente nas representações aprendidas."@pt ,
                                         "Statistical family that assesses fairness directly within learned representations by evaluating distributional disparities in internal properties of the representation space, such as similarities or distances, aggregated across groups defined by sensitive attributes."@en .


###  http://www.usp.br/fmlo#RepresentationBias
fmlo:RepresentationBias rdf:type owl:Class ;
                        rdfs:subClassOf fmlo:BiasSource ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty fmlo:originatesIn ;
                                          owl:hasValue fmlo:DataCollection_i
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty fmlo:originatesInPhase ;
                                          owl:hasValue fmlo:PreProcessing_i
                                        ] ;
                        rdfs:isDefinedBy "Harini Suresh and John Guttag. 2021. A Framework for Understanding Sources of Harm throughout the Machine Learning Life Cycle. In Proceedings of the 1st ACM Conference on Equity and Access in Algorithms, Mechanisms, and Optimization (EAAMO '21). Association for Computing Machinery, New York, NY, USA, Article 17, 1–9. https://doi.org/10.1145/3465416.3483305"@en ;
                        rdfs:label "RepresentationBias"@en ;
                        skos:altLabel "Viés de representação"@pt ;
                        skos:definition "Occurs when the development sample under-represents some part of the population."@en ,
                                        "Ocorre quando a amostra de desenvolvimento sub-representa alguma parte da população."@pt .


###  http://www.usp.br/fmlo#RepresentationEquality
fmlo:RepresentationEquality rdf:type owl:Class ;
                            rdfs:subClassOf fmlo:FairnessNotion ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty fmlo:belongsToFamily ;
                                              owl:hasValue fmlo:RepresentationBased_i
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty fmlo:hasEthicalDimension ;
                                              owl:hasValue fmlo:DistributiveJustice_i
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty fmlo:hasEvaluationLocus ;
                                              owl:hasValue fmlo:Intrinsic_i
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty fmlo:hasMethodologicalApproach ;
                                              owl:hasValue fmlo:Statistical_i
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty fmlo:hasSocioTechnicalScope ;
                                              owl:hasValue fmlo:Group_i
                                            ] ;
                            rdfs:isDefinedBy "I. Dominguez-Catena, D. Paternain, and M. Galar, ‘‘Metrics for dataset demographic bias: A case study on facial expression recognition,’’ IEEE Transactions on Pattern Analysis and Machine Int., vol. 46, no. 8, pp. 5209–5226, 2024."@en ;
                            rdfs:label "RepresentationEquality"@en ;
                            skos:altLabel "Disparidade de Representação"@pt ;
                            skos:definition "Fairness notion concerned with whether data or learned representations encode systematic and socially salient asymmetries between protected groups and semantic concepts, assessed at the representation level independently of downstream tasks."@en ,
                                            "Noção de fairness que avalia se dados ou representações aprendidas codificam vieses estereotípicos ou sub-representação sistemática."@pt .


###  http://www.usp.br/fmlo#SemanticAssociation
fmlo:SemanticAssociation rdf:type owl:Class ;
                         rdfs:subClassOf fmlo:RepresentationEquality ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty fmlo:isSpecialCaseOf ;
                                           owl:hasValue fmlo:RepresentationEquality_i
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty fmlo:satisfiesCriterion ;
                                           owl:hasValue fmlo:Relational_i
                                         ] ;
                         rdfs:isDefinedBy "A. Caliskan, J. J. Bryson, and A. Narayanan, ‘‘Semantics derived automatically from language corpora contain human-like biases,’’ Sci., vol. 356, no. 6334, pp. 183–186, 2017."@en ;
                         rdfs:label "SemanticAssociation"@en ;
                         skos:altLabel "Associação Semântica"@pt ;
                         skos:definition "A equidade de representação mede se as representações codificam estruturas estereotipadas dependentes de grupo por meio de diferenças sistemáticas em padrões de proximidade semântica. Operacionalizada pela medição da força esperada da associação relacional entre representações vinculadas a grupos e conjuntos de conceitos avaliativos, exigindo invariância entre os grupos protegidos."@pt ,
                                         "Representation equality fairness that captures whether embeddings encode group-dependent stereotypical structure through systematic differences in semantic proximity patterns. Operationalized by measuring the expected relational association strength between group-linked embeddings and evaluative concept sets, requiring invariance across protected groups."@en .


###  http://www.usp.br/fmlo#SensitiveAttribute
fmlo:SensitiveAttribute rdf:type owl:Class ;
                        rdfs:subClassOf obo:BFO_0000019 ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty fmlo:hasDataType ;
                                          owl:someValuesFrom fmlo:AttributeDataType
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty fmlo:isAffectedBy ;
                                          owl:someValuesFrom fmlo:BiasSource
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty fmlo:isAttributeOf ;
                                          owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass fmlo:Data
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty fmlo:hasImbalance ;
                                          owl:someValuesFrom xsd:boolean
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty fmlo:hasMissingValues ;
                                          owl:someValuesFrom xsd:boolean
                                        ] ;
                        rdfs:isDefinedBy "BAROCAS, Solon; HARDT, Moritz; NARAYANAN, Arvind. Fairness and machine learning: Limitations and opportunities. MIT press, 2023."@en ;
                        rdfs:label "SensitiveAttribute"@en ;
                        skos:altLabel "Atributo sensível"@pt ;
                        skos:definition "Atributos sensíveis referem-se a características individuais que, quando usadas em tomada de decisão automatizada, podem levar a resultados enviesados ou inequitativos."@pt ,
                                        "Sensitive attributes refer to individual characteristics that, when used in automated decision-making, may lead to biased or inequitable outcomes."@en .


###  http://www.usp.br/fmlo#SensitivePersonalData
fmlo:SensitivePersonalData rdf:type owl:Class ;
                           rdfs:subClassOf fmlo:PersonalData ,
                                           [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                    owl:onProperty fmlo:containsAttribute ;
                                                                    owl:hasValue fmlo:Ethnicity_i
                                                                  ]
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty fmlo:containsAttribute ;
                                                                    owl:hasValue fmlo:GeneticCharacteristic_i
                                                                  ]
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty fmlo:containsAttribute ;
                                                                    owl:hasValue fmlo:HealthInsurance_i
                                                                  ]
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty fmlo:containsAttribute ;
                                                                    owl:hasValue fmlo:PoliticalAffiliation_i
                                                                  ]
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty fmlo:containsAttribute ;
                                                                    owl:hasValue fmlo:Race_i
                                                                  ]
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty fmlo:containsAttribute ;
                                                                    owl:hasValue fmlo:Religion_i
                                                                  ]
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty fmlo:containsAttribute ;
                                                                    owl:hasValue fmlo:Sex_i
                                                                  ]
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty fmlo:containsAttribute ;
                                                                    owl:hasValue fmlo:SexualOrientation_i
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty fmlo:classifies ;
                                             owl:someValuesFrom fmlo:SensitiveAttribute
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty fmlo:protectedBy ;
                                             owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                             owl:onClass fmlo:LegalFramework
                                           ] ;
                           rdfs:isDefinedBy "Gereral data protection regulation (GDPR) - Recital 51. https://gdpr.eu/recital-51-protecting-sensitive-personal-data/"@en ;
                           rdfs:label "SensitivePersonalData"@en ;
                           skos:altLabel "Dado pessoal sensível"@pt ;
                           skos:definition "Dados pessoais que, por sua natureza, são particularmente sensíveis em relação a direitos e liberdades fundamentais."@pt ,
                                           "Personal data which are, by their nature, particularly sensitive in relation to fundamental rights and freedoms."@en .


###  http://www.usp.br/fmlo#Separation
fmlo:Separation rdf:type owl:Class ;
                rdfs:subClassOf fmlo:FairnessCriterion ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty fmlo:criterionBelongsToApproach ;
                                  owl:hasValue fmlo:Statistical_i
                                ] ;
                fmlo:probabilistic_definition "R ⊥ A | Y" ;
                rdfs:isDefinedBy "Barocas, S., Hardt, M., & Narayanan, A. (2019). Fairness and machine learning: Limitations and opportunities. fairmlbook. org."@en ;
                rdfs:label "Separation"@en ;
                skos:altLabel "Separação"@pt ;
                skos:definition "Criterion requiring predictions to be independent of the protected attribute conditional on the true label (R ⊥ A | Y), ensuring that error rates are equalized across groups for each outcome class."@en ,
                                "Critério de fairness que requer independência condicional entre decisão e atributo protegido dado o rótulo verdadeiro."@pt .


###  http://www.usp.br/fmlo#Sex
fmlo:Sex rdf:type owl:Class ;
         rdfs:subClassOf fmlo:SensitiveAttribute ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty fmlo:isClassifiedAs ;
                           owl:hasValue fmlo:ProtectedCharacteristic_i
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty fmlo:isClassifiedAs ;
                           owl:hasValue fmlo:SensitivePersonalData_i
                         ] ;
         rdfs:isDefinedBy "Canadian Institutes of Health Research (CIHR). https://cihr-irsc.gc.ca/e/47830.html"@en ;
         rdfs:label "Sex"@en ;
         skos:altLabel "Sexo"@pt ;
         skos:definition "An attribute that refers to a set of biological attributes associated with physical and physiological features."@en ,
                         "Um atributo que se refere a um conjunto de atributos biológicos associados a características físicas e fisiológicas."@pt .


###  http://www.usp.br/fmlo#SexualOrientation
fmlo:SexualOrientation rdf:type owl:Class ;
                       rdfs:subClassOf fmlo:SensitiveAttribute ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty fmlo:isClassifiedAs ;
                                         owl:hasValue fmlo:ProtectedCharacteristic_i
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty fmlo:isClassifiedAs ;
                                         owl:hasValue fmlo:SensitivePersonalData_i
                                       ] ;
                       rdfs:isDefinedBy "Patterson, C., & D'Augelli, A. R. (Eds.). (2013). Handbook of psychology and sexual orientation. Oxford University Press."@en ;
                       rdfs:label "SexualOrientation"@en ;
                       skos:altLabel "Orientação Sexual"@pt ;
                       skos:definition "An attribute that refers to an individual's pattern of emotional, romantic, or sexual attraction to people of a particular gender, as an aspect of identity"@en ,
                                       "Um atributo que se refere ao padrão de atração emocional, romântica ou sexual de um indivíduo por pessoas de um determinado gênero, como um aspecto da identidade."@pt .


###  http://www.usp.br/fmlo#Similarity
fmlo:Similarity rdf:type owl:Class ;
                rdfs:subClassOf fmlo:FairnessCriterion ,
                                [ rdf:type owl:Restriction ;
                                  owl:onProperty fmlo:criterionBelongsToApproach ;
                                  owl:hasValue fmlo:Geometric_i
                                ] ;
                fmlo:probabilistic_definition "d_Y(f(x),f(x')) ≤ L · d_X(x,x')" ;
                rdfs:isDefinedBy "C. Dwork, M. Hardt, T. Pitassi, O. Reingold, and R. Zemel, ‘‘Fairness through awareness,’’ in 3rd Innovations in Theoretical Computer Sci. Conf., pp. 214–226, 2012."@en ;
                rdfs:label "Similarity"@en ;
                skos:altLabel "Similaridade"@pt ;
                skos:definition "Critério de fairness baseado em preservação de similaridade entre indivíduos."@pt ,
                                "Geometric criterion imposing a smoothness constraint on the decision function via the Lipschitz continuity condition, requiring that similar individuals in input space receive similar outputs in decision space."@en .


###  http://www.usp.br/fmlo#SimilarityBased
fmlo:SimilarityBased rdf:type owl:Class ;
                     rdfs:subClassOf fmlo:MetricOperationalization ;
                     rdfs:isDefinedBy "C. Dwork, M. Hardt, T. Pitassi, O. Reingold, and R. Zemel, ‘‘Fairness through awareness,’’ in 3rd Innovations in Theoretical Computer Sci. Conf., pp. 214–226, 2012."@en ;
                     rdfs:label "SimilarityBased"@en ;
                     skos:altLabel "Baseado em Similaridade"@pt ;
                     skos:definition "Operacionalização que quantifica fairness através da preservação de distância entre indivíduos."@pt ,
                                     "Operationalization that quantifies fairness through pairwise distance preservation between individuals, measuring distortion of local neighborhoods between input and decision spaces."@en .


###  http://www.usp.br/fmlo#SocioTechnicalScope
fmlo:SocioTechnicalScope rdf:type owl:Class ;
                         rdfs:subClassOf obo:BFO_0000031 ;
                         rdfs:isDefinedBy "Fairness at Risk: Bias-Discovery and Mitigation Solutions"@en ;
                         rdfs:label "SocioTechnicalScope"@en ;
                         skos:altLabel "Escopo Sociotécnico"@pt ;
                         skos:definition "Especifica o escopo social no qual uma noção de fairness opera."@pt ,
                                         "Specifies the social scope at which a fairness notion operates, clarifying who is being protected and at what level inequity is evaluated."@en .


###  http://www.usp.br/fmlo#SocioTechnicalSolution
fmlo:SocioTechnicalSolution rdf:type owl:Class ;
                            rdfs:subClassOf obo:BFO_0000031 ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty fmlo:addressesTask ;
                                              owl:someValuesFrom fmlo:MLTask
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty fmlo:hasDatasetUsed ;
                                              owl:someValuesFrom xsd:string
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty fmlo:hasCodeAvailable ;
                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:boolean
                                            ] ,
                                            [ rdf:type owl:Restriction ;
                                              owl:onProperty fmlo:hasPublicationYear ;
                                              owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                              owl:onDataRange xsd:integer
                                            ] ;
                            rdfs:isDefinedBy "Fairness at Risk: Bias-Discovery and Mitigation Solutions"@en ;
                            rdfs:label "SocioTechnicalSolution"@en ;
                            skos:altLabel "Solução Sociotécnica"@pt ;
                            skos:definition "Classe raiz representando todas as soluções propostas para medir, descobrir, mitigar ou resolver viés em sistemas de ML."@pt ,
                                            "Root class representing all solutions proposed to measure, discover, mitigate, or solve bias in ML systems. Termed sociotechnical as fairness in ML inherently involves both social principles and technical components."@en .


###  http://www.usp.br/fmlo#Stability
fmlo:Stability rdf:type owl:Class ;
               rdfs:subClassOf fmlo:FairnessCriterion ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty fmlo:criterionBelongsToApproach ;
                                 owl:hasValue fmlo:Causal_i
                               ] ;
               fmlo:probabilistic_definition "Pr(Ŷ(A←a)(x) ≠ Ŷ(A←a')(x)) ≈ 0, ∀a,a'"@en ;
               rdfs:isDefinedBy "C. Agarwal, H. Lakkaraju, and M. Zitnik, ‘‘Towards a unified framework for fair and stable graph representation learning,’’ in Uncertainty in artificial intelligence, pp. 2114–2124, PMLR, 2021."@en ;
               rdfs:label "Stability"@en ;
               skos:altLabel "Estabilidade"@pt ;
               skos:definition "Causal criterion operating as a stochastic relaxation of Invariance, quantifying the probability or frequency with which the prediction is altered when the sensitive attribute is perturbed."@en ,
                               "Critério causal que opera como um relaxamento estocástico da invariância, quantificando a probabilidade ou frequência com que a previsão é alterada quando o atributo sensível é perturbado."@pt .


###  http://www.usp.br/fmlo#Statistical
fmlo:Statistical rdf:type owl:Class ;
                 rdfs:subClassOf fmlo:MethodologicalApproach ,
                                 [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                          owl:onProperty fmlo:approachHasLocus ;
                                                          owl:hasValue fmlo:Extrinsic_i
                                                        ]
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty fmlo:approachHasLocus ;
                                                          owl:hasValue fmlo:Intrinsic_i
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty fmlo:approachHasCriterion ;
                                   owl:allValuesFrom [ rdf:type owl:Restriction ;
                                                       owl:onProperty fmlo:isStatisticalCriterionOf ;
                                                       owl:someValuesFrom fmlo:StatisticalFamily
                                                     ]
                                 ] ;
                 rdfs:isDefinedBy "S. Barocas, M. Hardt, and A. Narayanan, Fairness and Machine Learning: Limitations and Opportunities. The MIT Press, 2023."@en ;
                 rdfs:label "Statistical"@en ;
                 skos:altLabel "Estatístico"@pt ;
                 skos:definition "Abordagem metodológica baseada em testes e medidas estatísticas."@pt ,
                                 "Methodological approach grounded in observable distributions and conditional independence relationships between predictions, outcomes, and sensitive attributes, typically enforcing parity constraints across groups."@en .


###  http://www.usp.br/fmlo#StatisticalFamily
fmlo:StatisticalFamily rdf:type owl:Class ;
                       rdfs:subClassOf obo:BFO_0000031 ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty fmlo:isFamilyOf ;
                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                         owl:onClass fmlo:EvaluationLocus
                                       ] ;
                       rdfs:isDefinedBy "Fairness at Risk: Bias-Discovery and Mitigation Solutions"@en ;
                       rdfs:label "StatisticalFamily"@en ;
                       skos:altLabel "Família Estatística"@pt ;
                       skos:definition "Específica da abordagem metodológica Estatística, fornece uma decomposição granular das noções de fairness."@pt ,
                                       "Specific to the Statistical methodological approach that provides a granular decomposition of fairness notions due to the proliferation of existing metrics. Organizes statistical notions into conceptual subtypes based on what they primarily measure."@en .


###  http://www.usp.br/fmlo#StatisticalParity
fmlo:StatisticalParity rdf:type owl:Class ;
                       rdfs:subClassOf fmlo:FairnessNotion ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty fmlo:belongsToFamily ;
                                         owl:hasValue fmlo:BaseRate_i
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty fmlo:hasCausalAnalogue ;
                                         owl:hasValue fmlo:CounterfactualFairness_i
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty fmlo:hasEthicalDimension ;
                                         owl:hasValue fmlo:DistributiveJustice_i
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty fmlo:hasEvaluationLocus ;
                                         owl:hasValue fmlo:Extrinsic_i
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty fmlo:hasMethodologicalApproach ;
                                         owl:hasValue fmlo:Causal_i
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty fmlo:hasMethodologicalApproach ;
                                         owl:hasValue fmlo:Statistical_i
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty fmlo:hasNormativePrinciple ;
                                         owl:hasValue fmlo:DisparateImpact_i
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty fmlo:hasSocioTechnicalScope ;
                                         owl:hasValue fmlo:Group_i
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty fmlo:hasTradeOffWith ;
                                         owl:hasValue fmlo:PerformanceOriented_i
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty fmlo:isIncompatibleWith ;
                                         owl:hasValue fmlo:Calibration_i
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty fmlo:isIncompatibleWith ;
                                         owl:hasValue fmlo:EqualizedOdds_i
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty fmlo:satisfiesCriterion ;
                                         owl:hasValue fmlo:Independence_i
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty fmlo:hasAcronym ;
                                         owl:someValuesFrom xsd:string
                                       ] ;
                       rdfs:comment """Causal formulation by \"S. Corbett-Davies, J. D. Gaebler, H. Nilforoshan, R. Shroff, and S. Goel,‘‘The measure and mismeasure of fairness,’’ Journal of Machine Learning
Research, vol. 24, no. 312, pp. 1–117, 2023.\""""@en ;
                       rdfs:isDefinedBy "Calders, T., Kamiran, F., & Pechenizkiy, M. (2009, December). Building classifiers with independency constraints. In 2009 IEEE international conference on data mining workshops (pp. 13-18). IEEE." ;
                       rdfs:label "StatisticalParity"@en ;
                       skos:altLabel "Paridade Estatística"@pt ;
                       skos:definition "Fairness notion requiring the probability of receiving a favorable prediction to be invariant with respect to protected group membership"@en ,
                                       "Noção de fairness que requer probabilidades iguais de resultado positivo entre grupos."@pt .


###  http://www.usp.br/fmlo#StatisticalTestBased
fmlo:StatisticalTestBased rdf:type owl:Class ;
                          rdfs:subClassOf fmlo:MetricOperationalization ;
                          rdfs:isDefinedBy "Ontology for Biomedical Investigations"@en ;
                          rdfs:label "StatisticalTestBased"@en ;
                          skos:altLabel "Baseado em Teste Estatístico"@pt ;
                          skos:closeMatch obo:OBI_0000673 ;
                          skos:definition "Operacionalização que quantifica viés através de teste de hipóteses ou procedimentos baseados em permutação."@pt ,
                                          "Operationalization that quantifies bias through hypothesis testing or permutation-based procedures."@en .


###  http://www.usp.br/fmlo#StereotypicalAssociation
fmlo:StereotypicalAssociation rdf:type owl:Class ;
                              rdfs:subClassOf fmlo:FairnessNotion ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty fmlo:belongsToFamily ;
                                                owl:hasValue fmlo:AssociationBased_i
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty fmlo:hasEthicalDimension ;
                                                owl:hasValue fmlo:DistributiveJustice_i
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty fmlo:hasEvaluationLocus ;
                                                owl:hasValue fmlo:Intrinsic_i
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty fmlo:hasMethodologicalApproach ;
                                                owl:hasValue fmlo:Statistical_i
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty fmlo:hasSocioTechnicalScope ;
                                                owl:hasValue fmlo:Group_i
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty fmlo:satisfiesCriterion ;
                                                owl:hasValue fmlo:Independence_i
                                              ] ;
                              rdfs:isDefinedBy "I. Dominguez-Catena, D. Paternain, and M. Galar, ‘‘Metrics for dataset demographic bias: A case study on facial expression recognition,’’ IEEE Transactions on Pattern Analysis and Machine Int., vol. 46, no. 8, pp. 5209–5226, 2024."@en ;
                              rdfs:label "StereotypicalAssociation"@en ;
                              skos:altLabel "Associação Estereotípica"@pt ;
                              skos:definition "Fairness notion concerned with systematic statistical dependencies between protected attributes and semantic variables in data."@en ,
                                              "Noção de fairness preocupada com dependências estatísticas sistemáticas entre atributos protegidos e variáveis semânticas."@pt .


###  http://www.usp.br/fmlo#StructuralMethodologicalContributions
fmlo:StructuralMethodologicalContributions rdf:type owl:Class ;
                                           rdfs:subClassOf fmlo:SocioTechnicalSolution ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty fmlo:systematizes ;
                                                             owl:someValuesFrom fmlo:BiasSource
                                                           ] ;
                                           rdfs:isDefinedBy "Fairness at Risk: Bias-Discovery and Mitigation Solutions"@en ;
                                           rdfs:label "StructuralMethodologicalContributions"@en ;
                                           skos:altLabel "Contribuições Estruturais e Metodológicas"@pt ;
                                           skos:definition "Solutions that operate at a higher level of abstraction, aiming to organize the field, provide new reasoning frameworks, critique foundational assumptions, or deliver enabling tools for fairness research and practice."@en ,
                                                           "Soluções que operam em um nível mais alto de abstração, visando organizar o campo e fornecer frameworks."@pt .


###  http://www.usp.br/fmlo#Sufficiency
fmlo:Sufficiency rdf:type owl:Class ;
                 rdfs:subClassOf fmlo:FairnessCriterion ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty fmlo:criterionBelongsToApproach ;
                                   owl:hasValue fmlo:Statistical_i
                                 ] ;
                 fmlo:probabilistic_definition "Y ⊥ A | R" ;
                 rdfs:isDefinedBy "Barocas, S., Hardt, M., & Narayanan, A. (2019). Fairness and machine learning: Limitations and opportunities. fairmlbook. org."@en ;
                 rdfs:label "Sufficiency"@en ;
                 skos:altLabel "Suficiência"@pt ;
                 skos:definition "Criterion requiring the true outcome to be independent of group membership given the prediction (Y ⊥ A | R), ensuring that predicted scores carry the same semantic meaning across groups."@en ,
                                 "Critério de fairness que requer que o resultado verdadeiro seja independente do atributo protegido dado a predição."@pt .


###  http://www.usp.br/fmlo#Taxonomy
fmlo:Taxonomy rdf:type owl:Class ;
              rdfs:subClassOf fmlo:StructuralMethodologicalContributions ;
              rdfs:isDefinedBy "Fairness at Risk: Bias-Discovery and Mitigation Solutions"@en ;
              rdfs:label "Taxonomy"@en ;
              skos:altLabel "Taxonomia"@pt ;
              skos:definition "Contribuições estruturais que organizam a literatura fragmentada de fairness em dimensões estruturadas."@pt ,
                              "Structural contributions that organize the fragmented fairness literature into structured dimensions, offering shared vocabularies and reference maps for comparison and synthesis."@en .


###  http://www.usp.br/fmlo#TechnicalArea
fmlo:TechnicalArea rdf:type owl:Class ;
                   rdfs:subClassOf obo:BFO_0000031 ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty fmlo:hasTask ;
                                     owl:someValuesFrom fmlo:MLTask
                                   ] ;
                   rdfs:isDefinedBy "Fairness at Risk: Bias-Discovery and Mitigation Solutions"@en ;
                   rdfs:label "TechnicalArea"@en ;
                   skos:altLabel "Área técnica"@pt ;
                   skos:definition "A broad field of artificial intelligence research that encompasses multiple related tasks and methodologies."@en ,
                                   "Um campo amplo de pesquisa em inteligência artificial que abrange múltiplas tarefas e metodologias relacionadas."@pt .


###  http://www.usp.br/fmlo#Toolkit
fmlo:Toolkit rdf:type owl:Class ;
             rdfs:subClassOf fmlo:StructuralMethodologicalContributions ;
             rdfs:isDefinedBy "Fairness at Risk: Bias-Discovery and Mitigation Solutions"@en ;
             rdfs:label "Toolkit"@en ;
             skos:altLabel "Ferramentário"@pt ;
             skos:definition "Contribuições estruturais que traduzem avanços conceituais em bibliotecas de software e benchmarks."@pt ,
                             "Structural contributions that translate conceptual advances into software libraries, benchmarks, and evaluation suites for standardized and reproducible fairness research."@en .


###  http://www.usp.br/fmlo#VeteranStatus
fmlo:VeteranStatus rdf:type owl:Class ;
                   rdfs:subClassOf fmlo:SensitiveAttribute ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty fmlo:isClassifiedAs ;
                                     owl:hasValue fmlo:ProtectedCharacteristic_i
                                   ] ;
                   rdfs:isDefinedBy "Fairness at Risk: Where Bias Emerges in Machine Learning"@en ;
                   rdfs:label "VeteranStatus"@en ;
                   skos:altLabel "Status de Veterano"@pt ;
                   skos:definition "An attribute that represents the current or past service of an individual in the military force."@en ,
                                   "Um atributo que representa o serviço atual ou passado de um indivíduo nas forças armadas."@pt .


