###  http://www.usp.br/fmlo#ConditionalPrincipalFairness
fmlo:ConditionalPrincipalFairness rdf:type owl:NamedIndividual ,
                                           fmlo:FairnessNotion ;
                                  fmlo:belongsToFamily fmlo:BaseRate_i ;
                                  fmlo:hasEthicalDimension fmlo:DistributiveJustice_i ;
                                  fmlo:hasEvaluationLocus fmlo:Extrinsic_i ;
                                  fmlo:hasMethodologicalApproach fmlo:Causal_i ;
                                  fmlo:hasNormativePrinciple fmlo:DisparateImpact_i ;
                                  fmlo:hasSocioTechnicalScope fmlo:Group_i ;
                                  fmlo:isCausalAnalogueOf fmlo:StatisticalParity_i ;
                                  fmlo:satisfiesCriterion fmlo:Independence_i ;
                                  fmlo:probabilistic_definition "P(Ŷ=1 | A=a, S=s, W=w) = P(Ŷ=1 | S=s, W=w), ∀a,s,w" ;
                                  rdfs:isDefinedBy "S. Corbett-Davies, J. D. Gaebler, H. Nilforoshan, R. Shroff, and S. Goel, ‘‘The measure and mismeasure of fairness,’’ Journal of Machine Learning Research, vol. 24, no. 312, pp. 1–117, 2023."@en .


