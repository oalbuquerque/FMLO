        <isCausalAnalogueOf rdf:resource="http://www.usp.br/fmlo#PredictiveParity_i"/>
        <satisfiesCriterion rdf:resource="http://www.usp.br/fmlo#Sufficiency_i"/>
        <probabilistic_definition>P(Y(1)=1 | Ŷ=0, A=a) = P(Y(1)=1 | Ŷ=0, A=a&apos;), ∀a,a&apos;</probabilistic_definition>
        <rdfs:isDefinedBy xml:lang="en">S. Corbett-Davies, J. D. Gaebler, H. Nilforoshan, R. Shroff, and S. Goel, ‘‘The measure and mismeasure of fairness,’’ Journal of Machine Learning Research, vol. 24, no. 312, pp. 1–117, 2023.</rdfs:isDefinedBy>
