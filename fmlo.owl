<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.usp.br/fmlo#"
     xml:base="http://www.usp.br/fmlo"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:fmo="https://purl.org/twc/fmo#"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:fmlo="http://www.usp.br/fmlo#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:terms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="http://www.usp.br/fmlo">
        <terms:abstract xml:lang="en">An ontology for fairness in machine learning that organizes bias sources, sensitive attributes, sociotechnical solutions, fairness notions, fairness criteria, and fairness metrics across the ML lifecycle.</terms:abstract>
        <terms:contributor>Marcelo Fantinato</terms:contributor>
        <terms:contributor>Sarajane Marques Peres</terms:contributor>
        <terms:creator>Otavio de Paula Albuquerque</terms:creator>
        <rdfs:label xml:lang="en">Fairness in Machine Learning Ontology</rdfs:label>
        <rdfs:label xml:lang="pt">Ontologia de Fairness em Aprendizado de Máquina</rdfs:label>
        <owl:versionInfo>1.0.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/elements/1.1/contributor -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/contributor"/>
    


    <!-- http://purl.org/dc/elements/1.1/identifier -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/identifier"/>
    


    <!-- http://purl.org/dc/elements/1.1/license -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/license"/>
    


    <!-- http://purl.org/dc/terms/abstract -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/abstract"/>
    


    <!-- http://purl.org/dc/terms/contributor -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/contributor"/>
    


    <!-- http://purl.org/dc/terms/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->

    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- http://www.usp.br/fmlo#mathematical_definition -->

    <owl:AnnotationProperty rdf:about="http://www.usp.br/fmlo#mathematical_definition">
        <rdfs:label xml:lang="en">mathematical definition</rdfs:label>
        <skos:definition xml:lang="en">Formal definition using an expanded mathematical equation</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://www.usp.br/fmlo#probabilistic_definition -->

    <owl:AnnotationProperty rdf:about="http://www.usp.br/fmlo#probabilistic_definition">
        <rdfs:label xml:lang="en">probabilistic definition</rdfs:label>
        <skos:definition xml:lang="en">Formal definition using a probabilistic or independence expression</skos:definition>
    </owl:AnnotationProperty>
    


    <!-- http://www.w3.org/2004/02/skos/core#altLabel -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#altLabel"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#broader -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#broader"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#closeMatch -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#closeMatch"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#definition -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#exactMatch -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#exactMatch"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#example -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#example"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.usp.br/fmlo#addressesBiasType -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#addressesBiasType">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#isAddressedByNotion"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#BiasSource"/>
        <rdfs:label xml:lang="en">addressesBiasType</rdfs:label>
        <skos:altLabel xml:lang="pt">endereça tipo de viés</skos:altLabel>
        <skos:definition xml:lang="en">Which bias source type a fairness notion is designed to detect</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#addressesTask -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#addressesTask">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#isAddressedBySolution"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#SocioTechnicalSolution"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#MLTask"/>
        <rdfs:label xml:lang="en">addressesTask</rdfs:label>
        <skos:altLabel xml:lang="pt">endereça tarefa</skos:altLabel>
        <skos:definition xml:lang="en">Which ML task a solution targets</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#affectsAttribute -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#affectsAttribute">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#isAffectedBy"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#BiasSource"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.usp.br/fmlo#hasDataType"/>
            <rdf:Description rdf:about="http://www.usp.br/fmlo#isVulnerableTo"/>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="en">affectsAttribute</rdfs:label>
        <skos:altLabel xml:lang="pt">afeta atributo</skos:altLabel>
        <skos:definition xml:lang="en">Which sensitive attribute is affected by a bias source</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#amplifies -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#amplifies">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#isAmplifiedBy"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#BiasSource"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#BiasSource"/>
        <rdfs:label xml:lang="en">amplifies</rdfs:label>
        <skos:altLabel xml:lang="pt">amplifica</skos:altLabel>
        <skos:definition xml:lang="en">When one bias source worsens another</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#appliedInDomain -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#appliedInDomain">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#hasSolution"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#SocioTechnicalSolution"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#ApplicationDomain"/>
        <rdfs:label xml:lang="en">appliedInDomain</rdfs:label>
        <skos:altLabel xml:lang="pt">aplicado no domínio</skos:altLabel>
        <skos:definition xml:lang="en">Which application domain a solution targets</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#appliesAtScope -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#appliesAtScope">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#scopeSupports"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#NormativeDimension"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#SocioTechnicalScope"/>
        <rdfs:label xml:lang="en">appliesAtScope</rdfs:label>
        <skos:altLabel xml:lang="pt">aplica-se ao escopo</skos:altLabel>
        <skos:definition xml:lang="en">Which sociotechnical scope a normative principle operates at</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#appliesInArea -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#appliesInArea">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#hasApplicableSolution"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#SocioTechnicalSolution"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#TechnicalArea"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.usp.br/fmlo#addressesTask"/>
            <rdf:Description rdf:about="http://www.usp.br/fmlo#belongsToArea"/>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="en">appliesInArea</rdfs:label>
        <skos:altLabel xml:lang="pt">Aplica na área</skos:altLabel>
        <skos:definition xml:lang="en">Relates a sociotechnical solution to the technical area in which it is applicable, inferred through the property chain addressesTask o belongsToArea.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#appliesToPhase -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#appliesToPhase">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#isPhaseOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#SocioTechnicalSolution"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#ProcessingPhase"/>
        <rdfs:label xml:lang="en">appliesToPhase</rdfs:label>
        <skos:altLabel xml:lang="pt">aplica-se à fase</skos:altLabel>
        <skos:definition xml:lang="en">In which processing phase the technique intervenes</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#appliesToStage -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#appliesToStage">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#isStageOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#SocioTechnicalSolution"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#LifeCycleStage"/>
        <rdfs:label xml:lang="en">appliesToStage</rdfs:label>
        <skos:altLabel xml:lang="pt">aplica-se ao estágio</skos:altLabel>
        <skos:definition xml:lang="en">Specifies in which lifecycle stage a solution operates</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#approachAppliesAtScope -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#approachAppliesAtScope">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#scopeUses"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#MethodologicalApproach"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#SocioTechnicalScope"/>
        <rdfs:label xml:lang="en">approachAppliesAtScope</rdfs:label>
        <skos:altLabel xml:lang="pt">abordagem aplica-se ao escopo</skos:altLabel>
        <skos:definition xml:lang="en">At which scope levels this approach operates</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#approachHasCriterion -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#approachHasCriterion">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#criterionBelongsToApproach"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#MethodologicalApproach"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#FairnessCriterion"/>
        <rdfs:label xml:lang="en">approachHasCriterion</rdfs:label>
        <skos:altLabel xml:lang="pt">abordagem tem critério</skos:altLabel>
        <skos:definition xml:lang="en">Which criteria belong to this approach</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#approachHasLocus -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#approachHasLocus">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#isLocusOfApproach"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#MethodologicalApproach"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#EvaluationLocus"/>
        <rdfs:label xml:lang="en">approachHasLocus</rdfs:label>
        <skos:altLabel xml:lang="pt">abordagem tem locus</skos:altLabel>
        <skos:definition xml:lang="en">Which evaluation loci a methodological approach supports</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#belongsToArea -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#belongsToArea">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#hasTask"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#MLTask"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#TechnicalArea"/>
        <rdfs:label xml:lang="en">belongsToArea</rdfs:label>
        <skos:altLabel xml:lang="pt">pertence à área</skos:altLabel>
        <skos:definition xml:lang="en">Which technical area a ML task belongs to</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#belongsToFamily -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#belongsToFamily">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#hasMember"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#StatisticalFamily"/>
        <rdfs:label xml:lang="en">belongsToFamily</rdfs:label>
        <skos:altLabel xml:lang="pt">pertence à família</skos:altLabel>
        <skos:definition xml:lang="en">Which statistical family a notion belongs to</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#canAffectDataType -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#canAffectDataType">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#isVulnerableTo"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#BiasSource"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#AttributeDataType"/>
        <rdfs:label xml:lang="en">canAffectDataType</rdfs:label>
        <skos:altLabel xml:lang="pt">pode afetar tipo de dado</skos:altLabel>
        <skos:definition xml:lang="pt">Quais tipos de dados de atributos são suscetíveis aos efeitos de uma determinada fonte de viés</skos:definition>
        <skos:definition xml:lang="en">Which attribute data types are susceptible to the effects of a given bias source</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#classifies -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#classifies">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#isClassifiedAs"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#Data"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
        <rdfs:label xml:lang="en">classifies</rdfs:label>
        <skos:altLabel xml:lang="pt">classifica</skos:altLabel>
        <skos:definition xml:lang="en">Which sensitive attributes fall under this data category</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#containsAttribute -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#containsAttribute">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#isAttributeOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#Data"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
        <rdfs:label xml:lang="en">containsAttribute</rdfs:label>
        <skos:altLabel xml:lang="pt">contém atributo</skos:altLabel>
        <skos:definition xml:lang="en">Which sensitive attributes are embedded in a data category</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#criterionBelongsToApproach -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#criterionBelongsToApproach">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#FairnessCriterion"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#MethodologicalApproach"/>
        <rdfs:label xml:lang="en">criterionBelongsToApproach</rdfs:label>
        <skos:altLabel xml:lang="pt">critério pertence à abordagem</skos:altLabel>
        <skos:definition xml:lang="en">Links a criterion to its methodological approach</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#discovers -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#discovers">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#isDiscoveredBy"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#BiasDiscoveryTechnique"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#BiasSource"/>
        <rdfs:label xml:lang="en">discovers</rdfs:label>
        <skos:altLabel xml:lang="pt">descobre</skos:altLabel>
        <skos:definition xml:lang="en">Indicates which bias source a discovery technique detects</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#discoversInStage -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#discoversInStage">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#hasDiscoveryIn"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#BiasDiscoveryTechnique"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#LifeCycleStage"/>
        <rdfs:label xml:lang="en">discoversInStage</rdfs:label>
        <skos:altLabel xml:lang="pt">descobre no estágio</skos:altLabel>
        <skos:definition xml:lang="en">In which lifecycle stage a discovery technique operates</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#encompassPrinciple -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#encompassPrinciple">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#isPrincipleOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#EthicalDimension"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#NormativeDimension"/>
        <rdfs:label xml:lang="en">encompassPrinciple</rdfs:label>
        <skos:altLabel xml:lang="pt">abrange princípio</skos:altLabel>
        <skos:definition xml:lang="en">Which normative principles an ethical dimension encompasses</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#evaluatesWith -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#evaluatesWith">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#isUsedToEvaluate"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#SocioTechnicalSolution"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#FairnessMetric"/>
        <rdfs:label xml:lang="en">evaluatesWith</rdfs:label>
        <skos:altLabel xml:lang="pt">avalia com</skos:altLabel>
        <skos:definition xml:lang="en">Which metrics are used to evaluate a solution</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#formalizesCriterion -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#formalizesCriterion">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#isFormalizedBy"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#FairnessMetric"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#FairnessCriterion"/>
        <rdfs:label xml:lang="en">formalizesCriterion</rdfs:label>
        <skos:altLabel xml:lang="pt">formaliza critério</skos:altLabel>
        <skos:definition xml:lang="en">Indicates that a metric formalizes a criterion mathematically</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#hasApplicableSolution -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#hasApplicableSolution">
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#TechnicalArea"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#SocioTechnicalSolution"/>
        <rdfs:label xml:lang="en">hasApplicableSolution</rdfs:label>
        <skos:altLabel xml:lang="pt">tem solução aplicável</skos:altLabel>
        <skos:definition xml:lang="pt">Relaciona uma área técnica às soluções sociotécnicas aplicáveis dentro dela</skos:definition>
        <skos:definition xml:lang="en">Relates a technical area to the sociotechnical solutions applicable within it.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#hasCausalAnalogue -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#hasCausalAnalogue">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#isCausalAnalogueOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
        <rdfs:label xml:lang="en">hasCausalAnalogue</rdfs:label>
        <skos:altLabel xml:lang="pt">tem análogo causal</skos:altLabel>
        <skos:definition xml:lang="en">Relates a fairness notion to its counterpart defined under the causal methodological approach, capturing the correspondence between statistical and causal formulations of the same fairness concept.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#hasCriterion -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#hasCriterion">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#isCriterionOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#EvaluationLocus"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#FairnessCriterion"/>
        <rdfs:label xml:lang="en">hasCriterion</rdfs:label>
        <skos:altLabel xml:lang="pt">tem critério</skos:altLabel>
        <skos:definition xml:lang="pt">Relaciona um locus de avaliação a um critério de fairness que ele abrange ou pelo qual é avaliado</skos:definition>
        <skos:definition xml:lang="en">Relates either an evaluation locus to a fairness criterion that it encompasses or is evaluated by</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#hasDataType -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#hasDataType">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#isTypeOfData"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#AttributeDataType"/>
        <rdfs:label xml:lang="en">hasDataType</rdfs:label>
        <skos:altLabel xml:lang="pt">tem tipo de dado</skos:altLabel>
        <skos:definition xml:lang="pt">Indica que uma entidade de dados é classificada sob um tipo específico de dado dentro da taxonomia de dados</skos:definition>
        <skos:definition xml:lang="en">Indicates that a data entity is classified under a specific data type within the data taxonomy</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#hasDiscoveryIn -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#hasDiscoveryIn">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#LifeCycleStage"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#BiasDiscoveryTechnique"/>
        <rdfs:label xml:lang="en">hasDiscoveryIn</rdfs:label>
        <skos:altLabel xml:lang="pt">tem descoberta em</skos:altLabel>
        <skos:definition xml:lang="en">Which discovery techniques operate in this stage</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#hasDocument -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#hasDocument">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#isDocumentOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#LegalFramework"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#LegalFramework"/>
        <rdfs:label xml:lang="en">hasDocument</rdfs:label>
        <skos:altLabel xml:lang="pt">tem documento</skos:altLabel>
        <skos:definition xml:lang="pt">Relaciona um framework legal a outro documento ou framework legal que ele referencia, incorpora ou do qual é composto</skos:definition>
        <skos:definition xml:lang="en">Relates a legal framework to another legal document or framework that it references, incorporates, or is composed of</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#hasDualRole -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#hasDualRole">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#isDualRoleOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#FairnessMetric"/>
        <rdfs:label xml:lang="en">hasDualRole</rdfs:label>
        <skos:altLabel xml:lang="pt">tem papel dual</skos:altLabel>
        <skos:definition xml:lang="en">When a notion serves both as evaluation metric and optimization constraint</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#hasEthicalDimension -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#hasEthicalDimension">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#isEthicalDimensionOf"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#EthicalDimension"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.usp.br/fmlo#hasNormativePrinciple"/>
            <rdf:Description rdf:about="http://www.usp.br/fmlo#isPrincipleOf"/>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="en">hasEthicalDimension</rdfs:label>
        <skos:altLabel xml:lang="pt">tem dimensão ética</skos:altLabel>
        <skos:definition xml:lang="en">Whether distributive or procedural justice</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#hasEvaluationLocus -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#hasEvaluationLocus">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#isEvaluationLocusOf"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#EvaluationLocus"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.usp.br/fmlo#belongsToFamily"/>
            <rdf:Description rdf:about="http://www.usp.br/fmlo#isFamilyOf"/>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="en">hasEvaluationLocus</rdfs:label>
        <skos:altLabel xml:lang="pt">tem locus de avaliação</skos:altLabel>
        <skos:definition xml:lang="en">Whether the notion is extrinsic or intrinsic</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#hasFamily -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#hasFamily">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#isFamilyOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#EvaluationLocus"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#StatisticalFamily"/>
        <rdfs:label xml:lang="en">hasFamily</rdfs:label>
        <skos:altLabel xml:lang="pt">tem família</skos:altLabel>
        <skos:definition xml:lang="en">Which statistical families an evaluation locus contains</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#hasMappedPhase -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#hasMappedPhase">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#mapsToStage"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#LifeCycleStage"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#ProcessingPhase"/>
        <rdfs:label xml:lang="en">hasMappedPhase</rdfs:label>
        <skos:altLabel xml:lang="pt">tem fase mapeada</skos:altLabel>
        <skos:definition xml:lang="en">Which processing phase corresponds to this stage</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#hasMember -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#hasMember">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#StatisticalFamily"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
        <rdfs:label xml:lang="en">hasMember</rdfs:label>
        <skos:altLabel xml:lang="pt">tem membro</skos:altLabel>
        <skos:definition xml:lang="en">Which notions belong to this family</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#hasMethodologicalApproach -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#hasMethodologicalApproach">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#isMethodologicalApproachOf"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#MethodologicalApproach"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.usp.br/fmlo#satisfiesCriterion"/>
            <rdf:Description rdf:about="http://www.usp.br/fmlo#criterionBelongsToApproach"/>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="en">hasMethodologicalApproach</rdfs:label>
        <skos:altLabel xml:lang="pt">tem abordagem metodológica</skos:altLabel>
        <skos:definition xml:lang="en">Whether the notion is statistical, causal, or geometric</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#hasNormativePrinciple -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#hasNormativePrinciple">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#isNormativePrincipleOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#NormativeDimension"/>
        <rdfs:label xml:lang="en">hasNormativePrinciple</rdfs:label>
        <skos:altLabel xml:lang="pt">tem princípio normativo</skos:altLabel>
        <skos:definition xml:lang="en">Which normative principle a notion operationalizes</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#hasOperationalization -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#hasOperationalization">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#isOperationalizationOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#FairnessMetric"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#MetricOperationalization"/>
        <rdfs:label xml:lang="en">Operationalizes</rdfs:label>
        <skos:altLabel xml:lang="pt">Operacionaliza</skos:altLabel>
        <skos:definition xml:lang="en">How the metric is computed</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#hasProxy -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#hasProxy">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#isProxyFor"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
        <rdfs:label xml:lang="en">hasProxy</rdfs:label>
        <skos:altLabel xml:lang="pt">tem proxy</skos:altLabel>
        <skos:definition xml:lang="en">A protected characteristic has an indirect proxy</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#hasSocioTechnicalScope -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#hasSocioTechnicalScope">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#isSocioTechnicalScopeOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#SocioTechnicalScope"/>
        <rdfs:label xml:lang="en">hasSocioTechnicalScope</rdfs:label>
        <skos:altLabel xml:lang="pt">tem escopo sociotécnico</skos:altLabel>
        <skos:definition xml:lang="en">Individual, group, or intersectional scope</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#hasSolution -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#hasSolution">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#ApplicationDomain"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#SocioTechnicalSolution"/>
        <rdfs:label xml:lang="en">hasSolution</rdfs:label>
        <skos:altLabel xml:lang="pt">tem solução</skos:altLabel>
        <skos:definition xml:lang="en">Which solutions target this domain</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#hasSource -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#hasSource">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#isSourceOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#BiasSource"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#Bias"/>
        <rdfs:label xml:lang="en">hasSource</rdfs:label>
        <skos:altLabel xml:lang="pt">tem fonte</skos:altLabel>
        <skos:definition xml:lang="en">Relates a bias type to its source</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#hasSpecialCase -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#hasSpecialCase">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#isSpecialCaseOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
        <rdfs:label xml:lang="en">hasSpecialCase</rdfs:label>
        <skos:altLabel xml:lang="pt">tem caso especial</skos:altLabel>
        <skos:definition xml:lang="en">One notion has a more restricted variant</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#hasStatisticalCriterion -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#hasStatisticalCriterion">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#isStatisticalCriterionOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#StatisticalFamily"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#FairnessCriterion"/>
        <rdfs:label xml:lang="en">hasStatisticalCriterion</rdfs:label>
        <skos:altLabel xml:lang="pt">tem critério estatístico</skos:altLabel>
        <skos:definition xml:lang="en">Which criterion is associated with a statistical family</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#hasTask -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#hasTask">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#TechnicalArea"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#MLTask"/>
        <rdfs:label xml:lang="en">hasTask</rdfs:label>
        <skos:altLabel>tem tarefa</skos:altLabel>
        <skos:definition xml:lang="en">Which tasks belong to this technical area</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#hasTradeOffWith -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#hasTradeOffWith">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
        <rdfs:label xml:lang="en">hasTradeOffWith</rdfs:label>
        <skos:altLabel xml:lang="pt">tem trade-off com</skos:altLabel>
        <skos:definition xml:lang="en">Tension between notions but not impossibility</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#isAddressedByNotion -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#isAddressedByNotion">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#BiasSource"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
        <rdfs:label xml:lang="en">isAddressedByNotion</rdfs:label>
        <skos:altLabel xml:lang="pt">é endereçado por noção</skos:altLabel>
        <skos:definition xml:lang="en">Which fairness notions address this bias type</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#isAddressedBySolution -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#isAddressedBySolution">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#MLTask"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#SocioTechnicalSolution"/>
        <rdfs:label xml:lang="en">isAddressedBySolution</rdfs:label>
        <skos:altLabel xml:lang="pt">é endereçada por solução</skos:altLabel>
        <skos:definition xml:lang="en">Which solutions address this task</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#isAffectedBy -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#isAffectedBy">
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#BiasSource"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.usp.br/fmlo#hasDataType"/>
            <rdf:Description rdf:about="http://www.usp.br/fmlo#isVulnerableTo"/>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="en">isAffectedBy</rdfs:label>
        <skos:altLabel xml:lang="pt">é afetado por</skos:altLabel>
        <skos:definition xml:lang="en">Which bias sources affect this attribute</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#isAmplifiedBy -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#isAmplifiedBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#BiasSource"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#BiasSource"/>
        <rdfs:label xml:lang="en">isAmplifiedBy</rdfs:label>
        <skos:altLabel xml:lang="pt">é amplificado por</skos:altLabel>
        <skos:definition xml:lang="en">When a bias source is worsened by another</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#isAttributeOf -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#isAttributeOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#Data"/>
        <rdfs:label xml:lang="en">isAttributeOf</rdfs:label>
        <skos:altLabel xml:lang="pt">é atributo de</skos:altLabel>
        <skos:definition xml:lang="en">To which data category this attribute belongs</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#isCausalAnalogueOf -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#isCausalAnalogueOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
        <rdfs:label xml:lang="en">isCausalAnalogueOf</rdfs:label>
        <skos:altLabel xml:lang="pt">é análogo estatístico de</skos:altLabel>
        <skos:definition xml:lang="en">Relates a causal fairness notion to the statistical fairness notion from which it derives, indicating that it formalizes the same fairness concept under a causal framework.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#isClassifiedAs -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#isClassifiedAs">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#Data"/>
        <rdfs:label xml:lang="en">isClassifiedAs</rdfs:label>
