    <!-- http://www.usp.br/fmlo#ConditionalPrincipalFairness -->

    <owl:NamedIndividual rdf:about="http://www.usp.br/fmlo#ConditionalPrincipalFairness">
        <rdf:type rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
        <belongsToFamily rdf:resource="http://www.usp.br/fmlo#BaseRate_i"/>
        <hasEthicalDimension rdf:resource="http://www.usp.br/fmlo#DistributiveJustice_i"/>
        <hasEvaluationLocus rdf:resource="http://www.usp.br/fmlo#Extrinsic_i"/>
        <hasMethodologicalApproach rdf:resource="http://www.usp.br/fmlo#Causal_i"/>
        <hasNormativePrinciple rdf:resource="http://www.usp.br/fmlo#DisparateImpact_i"/>
        <hasSocioTechnicalScope rdf:resource="http://www.usp.br/fmlo#Group_i"/>
        <isCausalAnalogueOf rdf:resource="http://www.usp.br/fmlo#StatisticalParity_i"/>
        <satisfiesCriterion rdf:resource="http://www.usp.br/fmlo#Independence_i"/>
        <probabilistic_definition>P(Ŷ=1 | A=a, S=s, W=w) = P(Ŷ=1 | S=s, W=w), ∀a,s,w</probabilistic_definition>
        <rdfs:isDefinedBy xml:lang="en">S. Corbett-Davies, J. D. Gaebler, H. Nilforoshan, R. Shroff, and S. Goel, ‘‘The measure and mismeasure of fairness,’’ Journal of Machine Learning Research, vol. 24, no. 312, pp. 1–117, 2023.</rdfs:isDefinedBy>
    </owl:NamedIndividual>
    


