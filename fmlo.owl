            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isClassifiedAs"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#ProtectedCharacteristic_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Where Bias Emerges in Machine Learning</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">VeteranStatus</rdfs:label>
        <skos:altLabel xml:lang="pt">Status de Veterano</skos:altLabel>
        <skos:definition xml:lang="en">An attribute that represents the current or past service of an individual in the military force.</skos:definition>
        <skos:definition xml:lang="pt">Um atributo que representa o serviço atual ou passado de um indivíduo nas forças armadas.</skos:definition>
    </owl:Class>
    


