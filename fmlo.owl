    <!-- http://www.usp.br/fmlo#isUsedToEvaluate -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#isUsedToEvaluate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#FairnessMetric"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#SocioTechnicalSolution"/>
        <rdfs:label xml:lang="en">isUsedToEvaluate</rdfs:label>
        <skos:altLabel xml:lang="pt">é usada para avaliar</skos:altLabel>
        <skos:definition xml:lang="en">Which solutions this metric evaluates</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#isVulnerableTo -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#isVulnerableTo">
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#AttributeDataType"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#BiasSource"/>
        <rdfs:label xml:lang="en">isVulnerableTo</rdfs:label>
        <skos:altLabel xml:lang="pt">é vulnerável à</skos:altLabel>
        <skos:definition xml:lang="en">Relates an attribute data type to the bias sources it is susceptible to, based on the statistical and representational characteristics of that type.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#mapsToStage -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#mapsToStage">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#ProcessingPhase"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#LifeCycleStage"/>
        <rdfs:label xml:lang="en">mapsToStage</rdfs:label>
        <skos:altLabel xml:lang="pt">mapeia para estágio</skos:altLabel>
        <skos:definition xml:lang="en">Which lifecycle stages a processing phase corresponds to</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#mitigates -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#mitigates">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#BiasMitigationTechnique"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#BiasSource"/>
        <rdfs:label xml:lang="en">mitigates</rdfs:label>
        <skos:altLabel xml:lang="pt">mitiga</skos:altLabel>
        <skos:definition xml:lang="en">Indicates which bias source a mitigation technique addresses</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#operationalizes -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#operationalizes">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#FairnessMetric"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
        <rdfs:label xml:lang="en">measures</rdfs:label>
        <skos:altLabel xml:lang="pt">mede</skos:altLabel>
        <skos:definition xml:lang="en">Which fairness notion a metric quantifies</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#originatesIn -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#originatesIn">
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#BiasSource"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#LifeCycleStage"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.usp.br/fmlo#originatesInPhase"/>
            <rdf:Description rdf:about="http://www.usp.br/fmlo#mapsToStage"/>
        </owl:propertyChainAxiom>
        <rdfs:label xml:lang="en">originatesIn</rdfs:label>
        <skos:altLabel xml:lang="pt">origina-se em</skos:altLabel>
        <skos:definition xml:lang="en">Identifies in which ML lifecycle stage a bias source originates</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#originatesInPhase -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#originatesInPhase">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#BiasSource"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#ProcessingPhase"/>
        <rdfs:label xml:lang="en">originatesInPhase</rdfs:label>
        <skos:altLabel xml:lang="pt">origina-se na fase</skos:altLabel>
        <skos:definition xml:lang="en">Identifies in which processing phase a bias source originates</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#propagatesTo -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#propagatesTo">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#receivesPropagationFrom"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#LifeCycleStage"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#LifeCycleStage"/>
        <rdfs:label xml:lang="en">propagatesTo</rdfs:label>
        <skos:altLabel xml:lang="pt">propaga para</skos:altLabel>
        <skos:definition xml:lang="en">How bias propagates through pipeline stages</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#protectedBy -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#protectedBy">
        <owl:inverseOf rdf:resource="http://www.usp.br/fmlo#protects"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#Data"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#LegalFramework"/>
        <rdfs:label xml:lang="en">protectedBy</rdfs:label>
        <skos:altLabel xml:lang="pt">protegido por</skos:altLabel>
        <skos:definition xml:lang="en">Which legislation protects this attribute</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#protects -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#protects">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#LegalFramework"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#Data"/>
        <rdfs:label xml:lang="en">protects</rdfs:label>
        <skos:altLabel xml:lang="pt">protege</skos:altLabel>
        <skos:definition xml:lang="en">Which attributes this legislation protects</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#receivesPropagationFrom -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#receivesPropagationFrom">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#LifeCycleStage"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#LifeCycleStage"/>
        <rdfs:label xml:lang="en">receivesPropagationFrom</rdfs:label>
        <skos:altLabel xml:lang="pt">recebe propagação de</skos:altLabel>
        <skos:definition xml:lang="en">Which stage receives propagated bias</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#requiresAccessTo -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#requiresAccessTo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
        <rdfs:label xml:lang="en">requiresAccessTo</rdfs:label>
        <skos:altLabel xml:lang="pt">requer acesso a</skos:altLabel>
        <skos:definition xml:lang="en">Whether a notion requires access to protected attributes</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#requiresDataType -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#requiresDataType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#FairnessMetric"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#AttributeDataType"/>
        <rdfs:label xml:lang="en">requiresDataType</rdfs:label>
        <skos:altLabel xml:lang="pt">requer tipo de dado</skos:altLabel>
        <skos:definition xml:lang="en">Specifies which attribute data type a fairness metric requires or is compatible with for its computation</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#satisfiesCriterion -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#satisfiesCriterion">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#FairnessCriterion"/>
        <rdfs:label xml:lang="en">satisfiesCriterion</rdfs:label>
        <skos:altLabel xml:lang="pt">satisfaz critério</skos:altLabel>
        <skos:definition xml:lang="en">Which formal criterion a notion satisfies</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#scopeSupports -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#scopeSupports">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#SocioTechnicalScope"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#NormativeDimension"/>
        <rdfs:label xml:lang="en">scopeSupports</rdfs:label>
        <skos:altLabel xml:lang="pt">escopo suporta</skos:altLabel>
        <skos:definition xml:lang="en">Which normative principles operate at this scope</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#scopeUses -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#scopeUses">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#SocioTechnicalScope"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#MethodologicalApproach"/>
        <rdfs:label xml:lang="en">scopeUses</rdfs:label>
        <skos:altLabel xml:lang="pt">escopo usa</skos:altLabel>
        <skos:definition xml:lang="en">Which methodological approaches are used at this scope level</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#systematizes -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#systematizes">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#StructuralMethodologicalContributions"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#BiasSource"/>
        <rdfs:label xml:lang="en">systematizes</rdfs:label>
        <skos:altLabel xml:lang="pt">sistematiza</skos:altLabel>
        <skos:definition xml:lang="pt">Indica que uma contribuição estrutural ou metodológica organiza, estrutura ou formaliza o conhecimento sobre fontes de viés</skos:definition>
        <skos:definition xml:lang="en">Indicates that a structural or methodological contribution organizes, structures, or formalizes knowledge about bias sources</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#usesMetric -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#usesMetric">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#BiasDiscoveryTechnique"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#FairnessMetric"/>
        <rdfs:label xml:lang="en">usesMetric</rdfs:label>
        <skos:altLabel xml:lang="pt">usa métrica</skos:altLabel>
        <skos:definition xml:lang="en">Which metric a discovery technique employs</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://www.usp.br/fmlo#usesNotion -->

    <owl:ObjectProperty rdf:about="http://www.usp.br/fmlo#usesNotion">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#SocioTechnicalSolution"/>
        <rdfs:range rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
        <rdfs:label xml:lang="en">usesNotion</rdfs:label>
        <skos:altLabel xml:lang="pt">usa noção</skos:altLabel>
        <skos:definition xml:lang="en">Which fairness notion a technique optimizes for</skos:definition>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.usp.br/fmlo#hasAcronym -->

    <owl:DatatypeProperty rdf:about="http://www.usp.br/fmlo#hasAcronym">
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#FairnessMetric"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">hasAcronym</rdfs:label>
        <skos:altLabel xml:lang="pt">tem acrônimo</skos:altLabel>
        <skos:definition xml:lang="pt">Acrônimo curto comumente usado para se referir à métrica (ex: SPD, EOD, DI).</skos:definition>
        <skos:definition xml:lang="en">Short acronym commonly used to refer to the metric (e.g., SPD, EOD, DI).</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://www.usp.br/fmlo#hasCodeAvailable -->

    <owl:DatatypeProperty rdf:about="http://www.usp.br/fmlo#hasCodeAvailable">
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#SocioTechnicalSolution"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label xml:lang="en">hasCodeAvailable</rdfs:label>
        <skos:altLabel xml:lang="pt">tem código disponível</skos:altLabel>
        <skos:definition xml:lang="pt">Se o código fonte que implementa a solução está publicamente disponível.</skos:definition>
        <skos:definition xml:lang="en">Whether source code implementing the solution is publicly available.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://www.usp.br/fmlo#hasDatasetUsed -->

    <owl:DatatypeProperty rdf:about="http://www.usp.br/fmlo#hasDatasetUsed">
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#SocioTechnicalSolution"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">hasDatasetUsed</rdfs:label>
        <skos:altLabel xml:lang="pt">tem dataset utilizado</skos:altLabel>
        <skos:definition xml:lang="en">Name of the dataset used for evaluation of the solution.</skos:definition>
        <skos:definition xml:lang="pt">Nome do dataset utilizado para avaliação da solução.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://www.usp.br/fmlo#hasEnactmentYear -->

    <owl:DatatypeProperty rdf:about="http://www.usp.br/fmlo#hasEnactmentYear">
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#LegalFramework"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="en">hasEnactmentYear</rdfs:label>
        <skos:altLabel xml:lang="pt">tem ano de promulgação</skos:altLabel>
        <skos:definition xml:lang="pt">Ano em que a legislação foi promulgada ou entrou em vigor.</skos:definition>
        <skos:definition xml:lang="en">Year the legislation was enacted or came into force.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://www.usp.br/fmlo#hasFairnessThreshold -->

    <owl:DatatypeProperty rdf:about="http://www.usp.br/fmlo#hasFairnessThreshold">
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label xml:lang="en">hasFairnessThreshold</rdfs:label>
        <skos:altLabel xml:lang="pt">tem limiar de fairness</skos:altLabel>
        <skos:definition xml:lang="en">Epsilon tolerance threshold for approximate satisfaction of the fairness notion.</skos:definition>
        <skos:definition xml:lang="pt">Limiar de tolerância epsilon para satisfação aproximada da noção de fairness.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://www.usp.br/fmlo#hasFormula -->

    <owl:DatatypeProperty rdf:about="http://www.usp.br/fmlo#hasFormula">
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#FairnessMetric"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">hasFormula</rdfs:label>
        <skos:altLabel xml:lang="pt">tem fórmula</skos:altLabel>
        <skos:definition xml:lang="pt">Fórmula matemática usada para calcular a métrica.</skos:definition>
        <skos:definition xml:lang="en">Mathematical formula used to compute the metric.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://www.usp.br/fmlo#hasIdealValue -->

    <owl:DatatypeProperty rdf:about="http://www.usp.br/fmlo#hasIdealValue">
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#FairnessMetric"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:label xml:lang="en">hasIdealValue</rdfs:label>
        <skos:altLabel xml:lang="pt">tem valor ideal</skos:altLabel>
        <skos:definition xml:lang="pt">Valor que indica fairness perfeita (ex: 0 para métricas baseadas em diferença, 1 para razão).</skos:definition>
        <skos:definition xml:lang="en">Value indicating perfect fairness (e.g., 0 for difference-based, 1 for ratio-based metrics).</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://www.usp.br/fmlo#hasImbalance -->

    <owl:DatatypeProperty rdf:about="http://www.usp.br/fmlo#hasImbalance">
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label xml:lang="en">hasImbalance</rdfs:label>
        <skos:altLabel xml:lang="pt">tem desequilíbrio</skos:altLabel>
        <skos:definition xml:lang="pt">Desequilíbrio entre grupos protegidos em um dataset para este atributo.</skos:definition>
        <skos:definition xml:lang="en">Imbalance between protected groups in a dataset for this attribute.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://www.usp.br/fmlo#hasJurisdiction -->

    <owl:DatatypeProperty rdf:about="http://www.usp.br/fmlo#hasJurisdiction">
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#LegalFramework"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">hasJurisdiction</rdfs:label>
        <skos:altLabel xml:lang="pt">tem jurisdição</skos:altLabel>
        <skos:definition xml:lang="en">Geographic jurisdiction where the legal document applies.</skos:definition>
        <skos:definition xml:lang="pt">Jurisdição geográfica onde o documento legal se aplica.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://www.usp.br/fmlo#hasMissingValues -->

    <owl:DatatypeProperty rdf:about="http://www.usp.br/fmlo#hasMissingValues">
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label xml:lang="en">hasMissingValues</rdfs:label>
        <skos:altLabel xml:lang="pt">Tem dados faltantes</skos:altLabel>
        <skos:definition xml:lang="pt">Indica se um conjunto de dados ou atributo contém valores faltantes que podem introduzir viés de medição ou representação</skos:definition>
        <skos:definition xml:lang="en">Indicates whether a dataset or attribute contains missing values that may introduce measurement or representation bias</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://www.usp.br/fmlo#hasNormalization -->

    <owl:DatatypeProperty rdf:about="http://www.usp.br/fmlo#hasNormalization">
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#AttributeDataType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label xml:lang="en">hasNormalization</rdfs:label>
        <skos:altLabel xml:lang="pt">Tem normalização</skos:altLabel>
        <skos:definition xml:lang="pt">Indica se um procedimento de normalização foi aplicado aos dados, o que pode afetar a distribuição de valores entre grupos sensíveis</skos:definition>
        <skos:definition xml:lang="en">Indicates whether a normalization procedure has been applied to the data, which may affect the distribution of values across sensitive groups</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://www.usp.br/fmlo#hasNumberOfCategories -->

    <owl:DatatypeProperty rdf:about="http://www.usp.br/fmlo#hasNumberOfCategories">
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#AttributeDataType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="en">hasNumberOfCategories</rdfs:label>
        <skos:altLabel xml:lang="pt">Tem número de categorias</skos:altLabel>
        <skos:definition xml:lang="pt">Especifica o número de categorias ou níveis distintos que um atributo sensível pode assumir em um conjunto de dados.</skos:definition>
        <skos:definition xml:lang="en">Specifies the number of distinct categories or levels that a sensitive attribute can assume in a dataset.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://www.usp.br/fmlo#hasOrder -->

    <owl:DatatypeProperty rdf:about="http://www.usp.br/fmlo#hasOrder">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="en">hasOrder</rdfs:label>
        <skos:altLabel xml:lang="pt">tem ordem</skos:altLabel>
        <skos:definition xml:lang="pt">Posição sequencial  no pipeline do ciclo de vida de ML</skos:definition>
        <skos:definition xml:lang="en">Sequential position  in the ML lifecycle pipeline</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://www.usp.br/fmlo#hasPublicationYear -->

    <owl:DatatypeProperty rdf:about="http://www.usp.br/fmlo#hasPublicationYear">
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#SocioTechnicalSolution"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label xml:lang="en">hasPublicationYear</rdfs:label>
        <skos:altLabel xml:lang="pt">tem ano de publicação</skos:altLabel>
        <skos:definition xml:lang="pt">Ano em que a solução foi publicada em um veículo revisado por pares.</skos:definition>
        <skos:definition xml:lang="en">Year the solution was published in a peer-reviewed venue.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://www.usp.br/fmlo#hasRange -->

    <owl:DatatypeProperty rdf:about="http://www.usp.br/fmlo#hasRange">
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#FairnessMetric"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">hasRange</rdfs:label>
        <skos:altLabel xml:lang="pt">tem intervalo</skos:altLabel>
        <skos:definition xml:lang="pt">Intervalo válido de saída da métrica (ex: &quot;[-1,1]&quot;, &quot;[0,∞)&quot;).</skos:definition>
        <skos:definition xml:lang="en">Valid output range of the metric (e.g., &quot;[-1,1]&quot;, &quot;[0,∞)&quot;).</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- http://www.usp.br/fmlo#hasSampleSize -->

    <owl:DatatypeProperty rdf:about="http://www.usp.br/fmlo#hasSampleSize">
        <rdfs:domain rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <rdfs:label xml:lang="en">hasSampleSize</rdfs:label>
        <skos:altLabel xml:lang="pt">Tem tamanho amostral</skos:altLabel>
        <skos:definition xml:lang="en">Records the number of instances in a dataset or subgroup, which is relevant for assessing representation bias and the statistical reliability of fairness evaluations</skos:definition>
        <skos:definition xml:lang="pt">Registra o número de instâncias em um conjunto de dados ou subgrupo, relevante para avaliar viés de representação e a confiabilidade estatística das avaliações de justiça</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/BFO_0000001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000001">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <dc:identifier>BFO - 001</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo.owl"/>
        <rdfs:label xml:lang="en">Entity</rdfs:label>
        <skos:altLabel xml:lang="pt">Entidade</skos:altLabel>
        <skos:definition xml:lang="en">An entity is anything that exists or has existed or will exist. (axiom label in BFO2 Reference: [001-001])</skos:definition>
        <skos:definition xml:lang="pt">Uma entidade é tudo o que existe ou existiu ou existirá. (Rótulo axioma na Referência da Referência da BFO2 : [001-001])</skos:definition>
        <skos:example xml:lang="en">Julius Caesar; the Second World War; your body mass index; Verdi&apos;s Requiem</skos:example>
        <skos:example xml:lang="pt">Júlio César; a Segunda Guerra Mundial; seu índice de massa corporal; o Réquiem de Verdi.</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <dc:identifier>BFO - 008</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo.owl"/>
        <rdfs:label xml:lang="en">Continuant</rdfs:label>
        <skos:altLabel xml:lang="pt">Continuante</skos:altLabel>
        <skos:definition xml:lang="en">A continuant is an entity that persists, endures, or continues to exist through time while maintaining its identity. (axiom label in BFO2 Reference: [008-002])</skos:definition>
        <skos:definition xml:lang="pt">Um continuante é uma entidade que persiste, que se mantém, ou continua a existir ao longo do tempo, enquanto mantém sua identidade. (Rótulo axioma na Referência da BFO2 : [008-002])</skos:definition>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000003 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
        <dc:identifier>BFO 0 077</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo.owl"/>
        <rdfs:label xml:lang="en">Occurent</rdfs:label>
        <skos:altLabel xml:lang="pt">Ocorrente</skos:altLabel>
        <skos:definition xml:lang="en">An occurrent is an entity that unfolds itself in time or it is the instantaneous boundary of such an entity (for example a beginning or an ending) or it is a temporal or spatiotemporal region which such an entity occupies_temporal_region or occupies_spatiotemporal_region. (axiom label in BFO2 Reference: [077-002])</skos:definition>
        <skos:definition xml:lang="pt">Um ocorrente é uma entidade que se desdobra no tempo ou é o limite instantâneo dessa entidade (por exemplo, um começar ou um finalizar) ou é uma região temporal ou espaço-temporal a qual tal entidade que ocupa uma região temporal (occupies_temporal_region) ou ocupa uma região espaço temporal (occupies_spatiotemporal_region). (Rótulo axioma em Referência da BFO2 : [077-002])</skos:definition>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000020"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <dc:identifier>BFO - 017</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo.owl"/>
        <rdfs:label xml:lang="en">IndependentContinuant</rdfs:label>
        <skos:altLabel xml:lang="pt">Continuante independente</skos:altLabel>
        <skos:definition xml:lang="en">b is an independent continuant = Def. b is a continuant which is such that there is no c and no t such that b s-depends_on c at t. (axiom label in BFO2 Reference: [017-002])</skos:definition>
        <skos:definition xml:lang="pt">“b” é um continuante independente = Def. “b“ é um continuante tal que não existe nenhum “c“ e nenhum t de forma que b depende especificamente (s-depende) de “c“ em t. (Rótulo axioma em Referência da BFO2 : [017-002])</skos:definition>
        <skos:example xml:lang="en">An atom; a molecule; an organism; a heart; a chair; the bottom right portion of a human torso; a leg; the interior of your mouth; a spatial region; an orchestra</skos:example>
        <skos:example xml:lang="pt">Um átomo; uma molécula; um organismo; um coração; uma cadeira; a parte inferior direita do torso humano; uma perna; o interior da boca; uma região espacial; uma orquestra.</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000008 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000008">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000011"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000035"/>
        <dc:identifier>BFO - 100</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo.owl"/>
        <rdfs:label xml:lang="en">TemporalRegion</rdfs:label>
        <skos:altLabel xml:lang="pt">Região Temporal</skos:altLabel>
        <skos:definition xml:lang="en">A temporal region is an occurrent entity that is part of time as defined relative to some reference frame. (axiom label in BFO2 Reference: [100-001])</skos:definition>
        <skos:definition xml:lang="pt">Uma região temporal é uma entidade ocorrente que é parte do tempo, tal como definido em relação a algum quadro de referência. (Rótulo axioma em Referência da BFO2 : [100-001])</skos:definition>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000011 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000011">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <dc:identifier>BFO - 095</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo.owl"/>
        <rdfs:label xml:lang="en">SpatiotemporalRegion</rdfs:label>
        <skos:altLabel xml:lang="pt">Região espaço-temporal</skos:altLabel>
        <skos:definition xml:lang="en">A spatiotemporal region is an occurrent entity that is part of spacetime. (axiom label in BFO2 Reference: [095-001])</skos:definition>
        <skos:definition xml:lang="pt">Uma região espaço-temporal é uma entidade ocorrente que faz parte do espaço-tempo. (Rótulo axioma em Referência da BFO2 : [095-001])</skos:definition>
        <skos:example xml:lang="pt">A região espaço-temporal ocupada pelo desenvolvimento de um tumor cancerígeno; a região espaço-temporal ocupada por um satélite em órbita.</skos:example>
        <skos:example xml:lang="en">The spatiotemporal region occupied by the development of a cancer tumour; the spatiotemporal region occupied by an orbiting satellite</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000015 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <dc:identifier>BFO - 083</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo.owl"/>
        <rdfs:label xml:lang="en">Process</rdfs:label>
        <skos:altLabel xml:lang="pt">Processo</skos:altLabel>
        <skos:definition xml:lang="en">p is a process = Def. p is an occurrent that has temporal proper parts and for some time t, p s-depends_on some material entity at t. (axiom label in BFO2 Reference: [083-003])</skos:definition>
        <skos:definition xml:lang="pt">p é um processo = Def. “p” é um ocorrente que tem partes próprias temporais e por algum tempo t, “p” depende especificamente (s-depends_on) de alguma entidade material em t. (Rótulo axioma em Referência da BFO2: [083-003])</skos:definition>
        <skos:example xml:lang="en">An act of selling; the life of an organism; a process of sleeping; a process of cell-division; a beating of the heart; a process of meiosis; the taxiing of an aircraft; the programming of a computer</skos:example>
        <skos:example xml:lang="pt">Um ato de venda; a vida de um organismo; o processo de dormir; o processo de divisão celular; uma batida do coração; o processo de meiose; o táxi de uma aeronave; a programação de um computador.</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000016 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000016">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <dc:identifier>BFO - 062</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo.owl"/>
        <rdfs:label xml:lang="en">Disposition</rdfs:label>
        <skos:altLabel xml:lang="pt">Disposição</skos:altLabel>
        <skos:definition xml:lang="en">b is a disposition means: b is a realizable entity &amp; b’s bearer is some material entity &amp; b is such that if it ceases to exist, then its bearer is physically changed, &amp; b’s realization occurs when and because this bearer is in some special physical circumstances, &amp; this realization occurs in virtue of the bearer’s physical make-up. (axiom label in BFO2 Reference: [062-002])</skos:definition>
        <skos:definition xml:lang="pt">“b” é uma disposição: “b” é uma entidade realizável &amp; o portador de “b” é uma entidade material &amp; “b” é tal que, se ele deixa de existir, então seu portador muda fisicamente &amp; realização de “b” ocorre quando e porque este portador está em alguma circunstância física especial &amp; esta realização ocorre em virtude da composição física do portador. (Rótulo do axioma na Referência da BFO2: [062-002])</skos:definition>
        <skos:example xml:lang="en">An atom of element X has the disposition to decay to an atom of element Y; the cell wall is disposed to transport cellular material through endocytosis and exocytosis; certain people have a predisposition to colon cancer; children are innately disposed to categorize objects in certain ways</skos:example>
        <skos:example xml:lang="pt">Um átomo do elemento X tem a tendência de se decompor em um átomo do elemento Y; a parede celular está disposta a transportar material celular por meio de endocitose e exocitose; certas pessoas têm predisposição ao câncer de cólon; crianças são inatamente predispostas a categorizar objetos de certas maneiras.</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000017 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000017">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000020"/>
        <owl:disjointWith rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <dc:identifier>BFO - 058</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo.owl"/>
        <rdfs:label xml:lang="en">RealizableEntity</rdfs:label>
        <skos:altLabel xml:lang="pt">Entidade realizável</skos:altLabel>
        <skos:definition xml:lang="pt">Dizer que “b” é uma entidade realizável é dizer que “b” é um continuante especificamente dependente, o qual é inerente a algum continuante independente, e ainda: i) não é uma região espacial; ii) é um tipo de instância que é realizada em certos tipos de processos correlacionados. (Rótulo axioma em Referência da BFO2 : [058-002])</skos:definition>
        <skos:definition xml:lang="en">To say that b is a realizable entity is to say that b is a specifically dependent continuant that inheres in some independent continuant which is not a spatial region and is of a type instances of which are realized in processes of a correlated type. (axiom label in BFO2 Reference: [058-002])</skos:definition>
        <skos:example xml:lang="pt">O papel de um médico; o papel desta fronteira em delimitar o encontro entre Utah e Colorado; a função dos seus órgãos reprodutivos; a capacidade do seu sangue de coagular; a capacidade deste pedaço de metal de conduzir eletricidade.</skos:example>
        <skos:example xml:lang="en">The role of being a doctor; the role of this boundary to delineate where Utah and Colorado meet; the function of your reproductive organs; the disposition of your blood to coagulate; the disposition of this piece of metal to conduct electricity</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000019 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000020"/>
        <dc:identifier>BFO - 055</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo.owl"/>
        <rdfs:label xml:lang="en">Quality</rdfs:label>
        <skos:altLabel xml:lang="pt">Qualidade</skos:altLabel>
        <skos:definition xml:lang="pt">Uma qualidade é um continuante especificamente dependente que, ao contrário de papéis e disposições, não necessita de qualquer processo adicional para ser realizado. (Rótulo axioma em Referência da BFO2 : [055-001])</skos:definition>
        <skos:definition xml:lang="en">a quality is a specifically dependent continuant that, in contrast to roles and dispositions, does not require any further process in order to be realized. (axiom label in BFO2 Reference: [055-001])</skos:definition>
        <skos:example xml:lang="pt">A cor de um tomate; a temperatura ambiente desta porção de ar; a circunferência da sua cintura; o formato do seu nariz; o formato da sua narina; a massa deste pedaço de ouro.</skos:example>
        <skos:example xml:lang="en">The colour of a tomato; the ambient temperature of this portion of air; the length of the circumference of your waist; the shape of your nose; the shape of your nostril; the mass of this piece of gold</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000020 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <dc:identifier>BFO - 050</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo.owl"/>
        <rdfs:label xml:lang="en">SpecificallyDependentContinuant</rdfs:label>
        <skos:altLabel xml:lang="pt">Continuante especificamente dependente</skos:altLabel>
        <skos:definition xml:lang="en">b is a specifically dependent continuant = Def. b is a continuant &amp; there is some independent continuant c which is not a spatial region and which is such that b s-depends_on c at every time t during the course of b’s existence. (axiom label in BFO2 Reference: [050-003])</skos:definition>
        <skos:definition xml:lang="pt">“b” é um continuante especificamente dependente = Def. “b” é um continuante e existe um continuante independente “c” que não é uma região espacial, o qual é tal que b “depende especificamente de  c”  em cada momento t no curso da existência de “b”. (Rótulo axioma em Referência da BFO2 : [050-003])</skos:definition>
        <skos:example xml:lang="pt">a dependência mútua do papel  de predador e do papel de presa desempenhado por dois organismos em uma determinada interação</skos:example>
        <skos:example xml:lang="en">the mutual dependence of the role predator and the role prey as played by two organisms in a given interaction</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000031 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000002"/>
        <dc:identifier>BFO - 074</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo.owl"/>
        <rdfs:label xml:lang="en">GenericallyDependentContinuant</rdfs:label>
        <skos:altLabel xml:lang="pt">Continuante genericamente dependente</skos:altLabel>
        <skos:definition xml:lang="en">b is a generically dependent continuant = Def. b is a continuant that g-depends_on one or more other entities. (axiom label in BFO2 Reference: [074-001])</skos:definition>
        <skos:definition xml:lang="pt">“b” é um continuante genericamente dependente = Def. “b“ é um continuante que depende genericamente (g-depends) de uma ou mais outras entidades. (Rótulo axioma em Referência da BFO2 : [074-001])</skos:definition>
        <skos:example xml:lang="pt">o arquivo pdf em seu notebook, o arquivo pdf que é uma cópia do mesmo arquivo pdf mencionado no meu notebook</skos:example>
        <skos:example xml:lang="en">the pdf file on your laptop, the pdf file that is a copy thereof on my laptop</skos:example>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000035 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000035">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <dc:identifier>BFO - 084</dc:identifier>
        <rdfs:isDefinedBy rdf:resource="http://purl.obolibrary.org/obo/bfo.owl"/>
        <rdfs:label xml:lang="en">ProcessBoundary</rdfs:label>
        <skos:altLabel xml:lang="pt">Limite de processo</skos:altLabel>
        <skos:definition xml:lang="en">p is a process boundary =Def. p is a temporal part of a process &amp; p has no proper temporal parts. (axiom label in BFO2 Reference: [084-001])</skos:definition>
        <skos:definition xml:lang="pt">p é um limite de processo = Def. “p” é uma parte temporal do processo e “p” não tem partes próprias temporais. (Rótulo axioma em Referência da BFO2 : [084-001])</skos:definition>
        <skos:example xml:lang="pt">a fronteira entre o 2º e o 3º ano de sua vida.</skos:example>
        <skos:example xml:lang="en">the boundary between the 2nd and 3rd year of your life.</skos:example>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#AIRegulation -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#AIRegulation">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#LegalFramework"/>
        <rdfs:isDefinedBy xml:lang="en"></rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">AIRegulation</rdfs:label>
        <skos:altLabel xml:lang="pt">Regulação de IA</skos:altLabel>
        <skos:definition xml:lang="en">A type of legal document that establishes rules and mechanisms for governing AI systems.</skos:definition>
        <skos:definition xml:lang="pt">Um tipo de documento legal que estabelece regras e mecanismos para governança de sistemas de IA.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#AccuracyRate -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#AccuracyRate">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#StatisticalFamily"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasCriterion"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Separation_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isFamilyOf"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Extrinsic_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">M. Hardt, E. Price, and N. Srebro, ‘‘Equality of opportunity in supervised learning,’’ in 30th Conf. on Neural Inf. Processing Sys., pp. 1–9, 2016.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">AccuracyRate</rdfs:label>
        <skos:altLabel xml:lang="pt">Taxa de Acurácia</skos:altLabel>
        <skos:definition xml:lang="pt">Família estatística que avalia predições em relação à sua precisão através de taxas de acerto e erro.</skos:definition>
        <skos:definition xml:lang="en">Statistical family that equalizes predictive performance or error rates across protected groups.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#Age -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#Age">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isClassifiedAs"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#ProtectedCharacteristic_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Equality and Human Rights Commission (EHRC). &quot;Protected characteristics.&quot; Equality Act 2010. Disponível em: https://www.equalityhumanrights.com/equality/equality-act-2010/protected-characteristics</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Age</rdfs:label>
        <skos:altLabel xml:lang="pt">Idade</skos:altLabel>
        <skos:definition xml:lang="en">An attribute representing the particular age or age range of an individual.</skos:definition>
        <skos:definition xml:lang="pt">Um atributo representando a idade ou faixa etária particular de um indivíduo.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#AggregationBias -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#AggregationBias">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#BiasSource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#originatesIn"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#ModelDevelopment_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#originatesInPhase"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#InProcessing_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Harini Suresh and John Guttag. 2021. A Framework for Understanding Sources of Harm throughout the Machine Learning Life Cycle. In Proceedings of the 1st ACM Conference on Equity and Access in Algorithms, Mechanisms, and Optimization (EAAMO &apos;21). Association for Computing Machinery, New York, NY, USA, Article 17, 1–9. https://doi.org/10.1145/3465416.3483305.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">AggregationBias</rdfs:label>
        <skos:altLabel xml:lang="pt">Viés de agregação</skos:altLabel>
        <skos:definition xml:lang="en">Occurs when a one-size-fits-all model is used for data in which there are underlying groups that should be considered differently.</skos:definition>
        <skos:definition xml:lang="pt">Ocorre quando um modelo único é usado para dados nos quais existem grupos subjacentes que deveriam ser considerados de forma diferente.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#AnonymousData -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#AnonymousData">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#Data"/>
        <rdfs:isDefinedBy xml:lang="en">General Data Protection Regulation (GDPR) - Recital 26. https://gdpr.eu/recital-26-not-applicable-to-anonymous-data/</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">AnonymousData</rdfs:label>
        <skos:altLabel xml:lang="pt">Dado Anônimo</skos:altLabel>
        <skos:definition xml:lang="pt">Dado que não pode ser conectado a uma pessoa natural identificada ou identificável.</skos:definition>
        <skos:definition xml:lang="en">Data is termed to be anonymous if it cannot be connected to an identified or identifiable natural person.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#AntiDiscrimination -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#AntiDiscrimination">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#LegalFramework"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#protects"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#ProtectedCharacteristic_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en"></rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">AntiDiscrimination</rdfs:label>
        <skos:altLabel xml:lang="pt">Lei Antidiscriminação</skos:altLabel>
        <skos:definition xml:lang="en">A type of legal document that regulates the collection, processing, storage, and sharing of personal data, aiming to protect individual privacy and fundamental rights.</skos:definition>
        <skos:definition xml:lang="pt">Um tipo de documento legal que regulamenta a coleta, o processamento, o armazenamento e o compartilhamento de dados pessoais, visando proteger a privacidade individual e os direitos fundamentais.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#ApplicationDomain -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#ApplicationDomain">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Bias-Discovery and Mitigation Solutions</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">ApplicationDomain</rdfs:label>
        <skos:altLabel xml:lang="pt">Domínio de Aplicação</skos:altLabel>
        <skos:definition xml:lang="en">A real-world sector or field in which ML-based fairness solutions are applied and evaluated.</skos:definition>
        <skos:definition xml:lang="pt">Um setor ou campo do mundo real no qual soluções de fairness baseadas em ML são aplicadas e avaliadas.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#AssociationBased -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#AssociationBased">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#StatisticalFamily"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasCriterion"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Independence_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isFamilyOf"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Intrinsic_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">I. Dominguez-Catena, D. Paternain, and M. Galar, ‘‘Metrics for dataset demographic bias: A case study on facial expression recognition,’’ IEEE Transactions on Pattern Analysis and Machine Int., vol. 46, no. 8, pp. 5209–5226, 2024.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">AssociationBased</rdfs:label>
        <skos:altLabel xml:lang="pt">Baseado em Associação</skos:altLabel>
        <skos:definition xml:lang="pt">Família estatística que avalia fairness através de medidas de associação entre atributos.</skos:definition>
        <skos:definition xml:lang="en">Statistical family that quantifies systematic statistical dependencies between protected attributes and semantic categories or labels encoded in data or representations, capturing stereotypical co-occurrence patterns independently of downstream predictions.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#AttributeDataType -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#AttributeDataType">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isTypeOfData"/>
                <owl:someValuesFrom rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isVulnerableTo"/>
                <owl:someValuesFrom rdf:resource="http://www.usp.br/fmlo#BiasSource"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasNormalization"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasNumberOfCategories"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Statistics ontology (STATO)</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">AttributeDataType</rdfs:label>
        <skos:altLabel xml:lang="pt">Tipo de Dado do Atributo</skos:altLabel>
        <skos:altLabel xml:lang="en">variableType</skos:altLabel>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000258"/>
        <skos:definition xml:lang="en">A classification that defines the structure and nature of values an attribute can assume in data analysis and machine learning, determining how it can be processed and interpreted.</skos:definition>
        <skos:definition xml:lang="pt">Uma classificação que define a estrutura e natureza dos valores que um atributo pode assumir em análise de dados e aprendizado de máquina, determinando como ele pode ser processado e interpretado.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#BaseRate -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#BaseRate">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#StatisticalFamily"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasCriterion"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Independence_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isFamilyOf"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Extrinsic_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">T. Calders and S. Verwer, ‘‘Three naive bayes approaches for discrimination-free classification,’’ Data Mining and Knowledge Discovery, vol. 21, pp. 277–292, 2010.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">BaseRate</rdfs:label>
        <skos:altLabel xml:lang="pt">Taxa Base</skos:altLabel>
        <skos:definition xml:lang="pt">Família estatística que avalia fairness com base nas taxas base de diferentes grupos.</skos:definition>
        <skos:definition xml:lang="en">Statistical family that targets parity in decision distributions (e.g., selection rates) across protected groups</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#Bias -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#Bias">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasSource"/>
                <owl:someValuesFrom rdf:resource="http://www.usp.br/fmlo#BiasSource"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Where Bias Emerges in Machine Learning</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Bias</rdfs:label>
        <skos:altLabel xml:lang="pt">Viés</skos:altLabel>
        <skos:definition xml:lang="pt">Discriminação sistemática e injusta contra certos indivíduos ou grupos em favor de outros.</skos:definition>
        <skos:definition xml:lang="en">Systematically and unfairly discriminate against certain individuals or groups of individuals in favor of others.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#BiasDiscoveryTechnique -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#BiasDiscoveryTechnique">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#SocioTechnicalSolution"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#appliesToPhase"/>
                <owl:someValuesFrom rdf:resource="http://www.usp.br/fmlo#ProcessingPhase"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#appliesToStage"/>
                <owl:someValuesFrom rdf:resource="http://www.usp.br/fmlo#LifeCycleStage"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#evaluatesWith"/>
                <owl:someValuesFrom rdf:resource="http://www.usp.br/fmlo#FairnessMetric"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#discovers"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.usp.br/fmlo#BiasSource"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#discoversInStage"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.usp.br/fmlo#LifeCycleStage"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Bias-Discovery and Mitigation Solutions</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">BiasDiscoveryTechnique</rdfs:label>
        <skos:altLabel xml:lang="pt">Técnica de Descoberta de Viés</skos:altLabel>
        <skos:definition xml:lang="en">Techniques designed to analyze, diagnose, or measure bias in datasets or models without attempting mitigation. They are diagnostic: the contribution is the identification or quantification of bias.</skos:definition>
        <skos:definition xml:lang="pt">Técnicas projetadas para analisar, diagnosticar ou medir viés em datasets ou modelos sem tentar mitigação.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#BiasMitigationTechnique -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#BiasMitigationTechnique">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#SocioTechnicalSolution"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#appliesToPhase"/>
                <owl:someValuesFrom rdf:resource="http://www.usp.br/fmlo#ProcessingPhase"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#appliesToStage"/>
                <owl:someValuesFrom rdf:resource="http://www.usp.br/fmlo#LifeCycleStage"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#evaluatesWith"/>
                <owl:someValuesFrom rdf:resource="http://www.usp.br/fmlo#FairnessMetric"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#mitigates"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.usp.br/fmlo#BiasSource"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#usesNotion"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Bias-Discovery and Mitigation Solutions</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">BiasMitigationTechnique</rdfs:label>
        <skos:altLabel xml:lang="pt">Técnica de Mitigação de Viés</skos:altLabel>
        <skos:definition xml:lang="en">Solutions that propose an active intervention to reduce or eliminate unfairness in ML systems. They are prescriptive: the contribution is the reduction of bias through intervention in the ML lifecycle.</skos:definition>
        <skos:definition xml:lang="pt">Soluções que propõem uma intervenção ativa para reduzir ou eliminar injustiças em sistemas de ML.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#BiasSource -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#BiasSource">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#originatesIn"/>
                <owl:someValuesFrom rdf:resource="http://www.usp.br/fmlo#LifeCycleStage"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#affectsAttribute"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#originatesInPhase"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.usp.br/fmlo#ProcessingPhase"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Harini Suresh and John Guttag. 2021. A Framework for Understanding Sources of Harm throughout the Machine Learning Life Cycle. In Proceedings of the 1st ACM Conference on Equity and Access in Algorithms, Mechanisms, and Optimization (EAAMO &apos;21). Association for Computing Machinery, New York, NY, USA, Article 17, 1–9. https://doi.org/10.1145/3465416.3483305</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">BiasSource</rdfs:label>
        <skos:altLabel xml:lang="pt">Fonte de viés</skos:altLabel>
        <skos:altLabel xml:lang="en">SourceOfBias</skos:altLabel>
        <skos:definition xml:lang="en">A stage or mechanism in the ML pipeline at which bias originates or is introduced.</skos:definition>
        <skos:definition xml:lang="pt">Um estágio ou mecanismo no pipeline de ML no qual o viés se origina ou é introduzido.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#Binary -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#Binary">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#Categorical"/>
        <rdfs:isDefinedBy xml:lang="en">Statistics ontology (STATO)</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Binary</rdfs:label>
        <skos:altLabel xml:lang="pt">Binário</skos:altLabel>
        <skos:altLabel xml:lang="en">dichotomous</skos:altLabel>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000090"/>
        <skos:definition xml:lang="en">A categorical data type restricted to exactly two mutually exclusive categories, often used to represent dichotomous attributes.</skos:definition>
        <skos:definition xml:lang="pt">Tipo de dado categórico restrito a exatamente duas categorias mutuamente exclusivas, frequentemente usado para representar atributos dicotômicos.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#Calibration -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#Calibration">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#belongsToFamily"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#CalibrationRate_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasEthicalDimension"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#DistributiveJustice_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasEvaluationLocus"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Extrinsic_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasMethodologicalApproach"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Statistical_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasNormativePrinciple"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#DisparateImpact_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasSocioTechnicalScope"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Group_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasTradeOffWith"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#PerformanceOriented_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isIncompatibleWith"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#EqualizedOdds_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isIncompatibleWith"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#StatisticalParity_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#satisfiesCriterion"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Sufficiency_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Pleiss, G., Raghavan, M., Wu, F., Kleinberg, J., &amp; Weinberger, K. Q. (2017). On fairness and calibration. Advances in neural information processing systems, 30.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Calibration</rdfs:label>
        <skos:altLabel xml:lang="pt">Calibração</skos:altLabel>
        <skos:definition xml:lang="en">Fairness notion enforcing the Sufficiency condition, requiring that for any given predicted score, the probability of the true outcome is independent of the protected attribute, ensuring predicted probabilities have the same meaning across groups.</skos:definition>
        <skos:definition xml:lang="pt">Noção de fairness que requer a condição de suficiência, exigindo que para qualquer valor de pontuação previsto, a probabilidade do resultado real seja a mesma entre grupos.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#CalibrationRate -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#CalibrationRate">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#StatisticalFamily"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasCriterion"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Sufficiency_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isFamilyOf"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Extrinsic_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">J. Kleinberg, S. Mullainathan, and M. Raghavan, ‘‘Inherent trade-offs in the fair determination of risk scores,’’ arXiv preprint arXiv:1609.05807, 2016.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">CalibrationRate</rdfs:label>
        <skos:altLabel xml:lang="pt">Taxa de calibração</skos:altLabel>
        <skos:definition xml:lang="pt">Família estatística que requer interpretações probabilísticas consistentes entre grupos.</skos:definition>
        <skos:definition xml:lang="en">Statistical family that enforces consistent probabilistic interpretations across groups</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#Categorical -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#Categorical">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#AttributeDataType"/>
        <owl:disjointWith rdf:resource="http://www.usp.br/fmlo#Continuous"/>
        <rdfs:isDefinedBy xml:lang="en">Statistics ontology (STATO) .</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Categorical</rdfs:label>
        <skos:altLabel xml:lang="pt">Categórico</skos:altLabel>
        <skos:altLabel xml:lang="en">nominal</skos:altLabel>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000252"/>
        <skos:definition xml:lang="en">A data type whose values are drawn from a finite set of distinct categories representing qualitative differences, without necessarily implying order.</skos:definition>
        <skos:definition xml:lang="pt">Tipo de dado cujos valores são extraídos de um conjunto finito de categorias distintas representando diferenças qualitativas, sem necessariamente implicar ordem.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#Causal -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#Causal">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#MethodologicalApproach"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#approachHasLocus"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Extrinsic_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">M. J. Kusner, J. Loftus, C. Russell, and R. Silva, ‘‘Counterfactual fairness,’’ in 31st Annual Conf. on Neural Inf. Processing Sys., 2017.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Causal</rdfs:label>
        <skos:altLabel xml:lang="pt">Causal</skos:altLabel>
        <skos:definition xml:lang="pt">Abordagem metodológica baseada em raciocínio causal e modelos de equações estruturais.</skos:definition>
        <skos:definition xml:lang="en">Methodological approach relying on structural causal models and counterfactual reasoning to assess whether decisions would remain invariant under hypothetical interventions on protected attributes, addressing forms of unfairness that may be obscured by purely observational criteria.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#CausalEffectBased -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#CausalEffectBased">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#MetricOperationalization"/>
        <rdfs:isDefinedBy xml:lang="en">M. J. Kusner, J. Loftus, C. Russell, and R. Silva, ‘‘Counterfactual fairness,’’ in 31st Annual Conf. on Neural Inf. Processing Sys., 2017.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">CausalEffectBased</rdfs:label>
        <skos:altLabel xml:lang="pt">Baseado em Efeito Causal</skos:altLabel>
        <skos:definition xml:lang="pt">Operacionalização que quantifica fairness medindo mudança de predição sob intervenções contrafactuais.</skos:definition>
        <skos:definition xml:lang="en">Operationalization that quantifies fairness by measuring prediction change under counterfactual interventions.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#CognitiveBias -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#CognitiveBias">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#BiasSource"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#originatesIn"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#DataCollection_i"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#originatesIn"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#DataPreparation_i"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#originatesIn"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#ModelDeployment_i"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#originatesIn"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#ModelDevelopment_i"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#originatesIn"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#ModelEvaluation_i"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#originatesIn"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#ModelPostProcessing_i"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#originatesInPhase"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#InProcessing_i"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#originatesInPhase"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#PostProcessing_i"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#originatesInPhase"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#PreProcessing_i"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#amplifies"/>
                <owl:someValuesFrom rdf:resource="http://www.usp.br/fmlo#BiasSource"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Tversky, A., &amp; Kahneman, D. (1974). Judgment under Uncertainty: Heuristics and Biases: Biases in judgments reveal some heuristics of thinking under uncertainty. science, 185(4157), 1124-1131.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">CognitiveBias</rdfs:label>
        <skos:altLabel xml:lang="pt">Viés cognitivo</skos:altLabel>
        <skos:definition xml:lang="pt">Disposições ou inclinações cognitivas sistemáticas no pensamento e raciocínio humanos que influenciam a forma como as pessoas percebem, interpretam e agem com base nas informações, e que frequentemente não estão em conformidade com os princípios da lógica, do raciocínio probabilístico e da plausibilidade.</skos:definition>
        <skos:definition xml:lang="en">Systematic cognitive dispositions or inclinations in human thinking and reasoning that influencing how people perceive, interpret, and act on information, and often do not comply with the tenets of logic, probability reasoning, and plausibility</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#ConceptualFramework -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#ConceptualFramework">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#StructuralMethodologicalContributions"/>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Bias-Discovery and Mitigation Solutions</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">ConceptualFramework</rdfs:label>
        <skos:altLabel xml:lang="pt">Framework Conceitual</skos:altLabel>
        <skos:definition xml:lang="pt">Contribuições estruturais que formalizam questões de fairness em modelos coerentes ou procedimentos.</skos:definition>
        <skos:definition xml:lang="en">Structural contributions that formalize fairness-related questions into coherent models, workflows, or procedures for reasoning about bias and integrating fairness into ML pipelines.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#Consistency -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#Consistency">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#NormativeDimension"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#appliesAtScope"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Individual_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isPrincipleOf"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#ProceduralJustice_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">C. Dwork, M. Hardt, T. Pitassi, O. Reingold, and R. Zemel, ‘‘Fairness through awareness,’’ in 3rd Innovations in Theoretical Computer Sci. Conf., pp. 214–226, 2012.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Consistency</rdfs:label>
        <skos:altLabel xml:lang="pt">Consistência</skos:altLabel>
        <skos:definition xml:lang="en">Normative-philosophical principle requiring decision stability relative to individual similarity, operationalizing Aristotle&apos;s precept that &quot;likes should be treated alike.&quot; Grounded in the Lipschitz condition, it posits that individuals close in the metric space must map to similar probability distributions in the decision space.</skos:definition>
        <skos:definition xml:lang="pt">Princípio normativo que requer tratamento consistente de indivíduos similares.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#Continuous -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#Continuous">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#AttributeDataType"/>
        <rdfs:isDefinedBy xml:lang="en">Statistics ontology (STATO).</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Continuous</rdfs:label>
        <skos:altLabel xml:lang="pt">Contínuo</skos:altLabel>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000251"/>
        <skos:definition xml:lang="en">A data type whose values lie on a continuous numeric scale.</skos:definition>
        <skos:definition xml:lang="pt">Tipo de dado cujos valores estão em uma escala numérica contínua.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#CounterfactualFairness -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#CounterfactualFairness">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasEthicalDimension"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#ProceduralJustice_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasEvaluationLocus"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Extrinsic_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasMethodologicalApproach"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Causal_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasNormativePrinciple"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#DisparateTreatment_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasSocioTechnicalScope"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Individual_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#satisfiesCriterion"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Invariance_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">M. J. Kusner, J. Loftus, C. Russell, and R. Silva, ‘‘Counterfactual fairness,’’ in 31st Annual Conf. on Neural Inf. Processing Sys., 2017.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">CounterfactualFairness</rdfs:label>
        <skos:altLabel xml:lang="pt">Justiça Contrafactual</skos:altLabel>
        <skos:definition xml:lang="en">Fairness notion requiring that the predicted outcome remains unchanged for the same individual under a counterfactual intervention on the protected attribute, capturing causal independence of the prediction from A.</skos:definition>
        <skos:definition xml:lang="pt">Noção de fairness que requer que o resultado previsto permaneça inalterado para o mesmo indivíduo em um mundo contrafactual onde o atributo protegido fosse diferente.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#CriticalAnalysis -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#CriticalAnalysis">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#StructuralMethodologicalContributions"/>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Bias-Discovery and Mitigation Solutions</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">CriticalAnalysis</rdfs:label>
        <skos:altLabel xml:lang="pt">Análise Crítica</skos:altLabel>
        <skos:definition xml:lang="pt">Contribuições estruturais que investigam os pressupostos fundamentais do campo.</skos:definition>
        <skos:definition xml:lang="en">Structural contributions that investigate the fields foundational assumptions, bridging technical metrics and ethical principles by questioning how systemic inequities are embedded in AI systems.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#Data -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#Data">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <rdfs:isDefinedBy xml:lang="en">Organization for Economic Cooperation and Development (OECD). Recommendation of the Council on Enhancing Access to and Sharing of Data. Paris: OCDE, 2021. Available at: https://legalinstruments.oecd.org/en/instruments/OECD-LEGAL-0463.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Data</rdfs:label>
        <skos:altLabel xml:lang="pt">Dados</skos:altLabel>
        <skos:definition xml:lang="pt">Refere-se a informações registradas em formato estruturado ou não estruturado usadas em sistemas de ML.</skos:definition>
        <skos:definition xml:lang="en">Refers to recorded information in structured or unstructured format used in ML systems.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#DataCentricTechnique -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#DataCentricTechnique">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#ExploratoryTechnique"/>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Bias-Discovery and Mitigation Solutions</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">DataCentricTechnique</rdfs:label>
        <skos:altLabel xml:lang="pt">Técnica Centrada em Dados</skos:altLabel>
        <skos:definition xml:lang="en">Exploratory methods that quantify biases prior to model training by directly analyzing dataset properties such as distributions, labels, and feature correlations with protected attributes.</skos:definition>
        <skos:definition xml:lang="pt">Métodos exploratórios que quantificam vieses antes do treino do modelo analisando diretamente propriedades do dataset.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#DataCollection -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#DataCollection">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#LifeCycleStage"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasMappedPhase"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#PreProcessing_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Harini Suresh and John Guttag. 2021. A Framework for Understanding Sources of Harm throughout the Machine Learning Life Cycle. In Proceedings of the 1st ACM Conference on Equity and Access in Algorithms, Mechanisms, and Optimization (EAAMO &apos;21). Association for Computing Machinery, New York, NY, USA, Article 17, 1–9. https://doi.org/10.1145/3465416.3483305</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">DataCollection</rdfs:label>
        <skos:altLabel xml:lang="pt">Coleta de Dados</skos:altLabel>
        <skos:definition xml:lang="pt">Estágio envolvendo a identificação de uma população-alvo, definição e mensuração de features e labels.</skos:definition>
        <skos:definition xml:lang="en">Stage involving the identification of a target population, the definition and measurement of features and labels, and sampling.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#DataPreparation -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#DataPreparation">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#LifeCycleStage"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasMappedPhase"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#PreProcessing_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Harini Suresh and John Guttag. 2021. A Framework for Understanding Sources of Harm throughout the Machine Learning Life Cycle. In Proceedings of the 1st ACM Conference on Equity and Access in Algorithms, Mechanisms, and Optimization (EAAMO &apos;21). Association for Computing Machinery, New York, NY, USA, Article 17, 1–9. https://doi.org/10.1145/3465416.3483305</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">DataPreparation</rdfs:label>
        <skos:altLabel xml:lang="pt">Preparação de Dados</skos:altLabel>
        <skos:definition xml:lang="pt">Etapa que envolve o pré-processamento aplicado ao conjunto de dados antes do uso do modelo, incluindo o tratamento de dados faltantes, transformação de atributos, normalização e divisão em conjuntos de treinamento, validação e teste.</skos:definition>
        <skos:definition xml:lang="en">Stage involving preprocessing applied to the dataset before model use, including handling missing data, feature transformation, normalization, and splitting into training, validation, and test sets.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#DataProtectionLaw -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#DataProtectionLaw">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#LegalFramework"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#protects"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#SensitivePersonalData_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en"></rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">DataProtectionLaw</rdfs:label>
        <skos:altLabel xml:lang="pt">Lei de Proteção de Dados</skos:altLabel>
        <skos:definition xml:lang="en">A type of legal document that prohibits discrimination based on protected characteristics, ensuring equal treatment and protection under the law.</skos:definition>
        <skos:definition xml:lang="pt">Um tipo de documento legal que proíbe a discriminação com base em características protegidas, garantindo igualdade de tratamento e proteção perante a lei.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#DeploymentBias -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#DeploymentBias">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#BiasSource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#originatesIn"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#ModelDeployment_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#originatesInPhase"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#PostProcessing_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Harini Suresh and John Guttag. 2021. A Framework for Understanding Sources of Harm throughout the Machine Learning Life Cycle. In Proceedings of the 1st ACM Conference on Equity and Access in Algorithms, Mechanisms, and Optimization (EAAMO &apos;21). Association for Computing Machinery, New York, NY, USA, Article 17, 1–9. https://doi.org/10.1145/3465416.3483305</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">DeploymentBias</rdfs:label>
        <skos:altLabel xml:lang="pt">Viés de implantação</skos:altLabel>
        <skos:definition xml:lang="en">Occurs when there is a mismatch between the problem a model is intended to solve and the way in which it is actually used.</skos:definition>
        <skos:definition xml:lang="pt">Ocorre quando há uma incompatibilidade entre o problema que o modelo pretende resolver e a forma como é realmente usado.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#DifferenceBased -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#DifferenceBased">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#MetricOperationalization"/>
        <rdfs:isDefinedBy xml:lang="en">Statistics ontology (STATO) .</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">DifferenceBased</rdfs:label>
        <skos:altLabel xml:lang="pt">Baseado em Diferença</skos:altLabel>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000184"/>
        <skos:definition xml:lang="pt">Operacionalização que quantifica violações de fairness como diferenças absolutas entre estatísticas condicionais de grupo.</skos:definition>
        <skos:definition xml:lang="en">Operationalization that quantifies fairness violations as absolute differences between group-conditional statistics.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#Disability -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#Disability">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isClassifiedAs"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#ProtectedCharacteristic_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isClassifiedAs"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#SensitivePersonalData_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Equality and Human Rights Commission (EHRC). &quot;Protected characteristics.&quot; Equality Act 2010. Disponível em: https://www.equalityhumanrights.com/equality/equality-act-2010/protected-characteristics</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Disability</rdfs:label>
        <skos:altLabel xml:lang="pt">Deficiência</skos:altLabel>
        <skos:definition xml:lang="en">An attribute indicating a physical, mental, intellectual or sensory impairment.</skos:definition>
        <skos:definition xml:lang="pt">Um atributo indicando uma deficiência física, mental, intelectual ou sensorial.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#DisparateImpact -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#DisparateImpact">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#NormativeDimension"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#appliesAtScope"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Group_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isPrincipleOf"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#DistributiveJustice_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">S. Barocas and A. D. Selbst, ‘‘Big data’s disparate impact,’’ California Law Review, pp. 671–732, 2016</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">DisparateImpact</rdfs:label>
        <skos:altLabel xml:lang="pt">Impacto Dispar</skos:altLabel>
        <skos:definition xml:lang="en">Normative principle concerned with unequal aggregate outcomes across protected groups, prohibiting decisions that produce disproportionately adverse effects on a group regardless of intent. Aligned with substantive (material) equality in legal theory.</skos:definition>
        <skos:definition xml:lang="pt">Princípio normativo que proíbe políticas neutras que produzem efeitos desproporcionais em grupos protegidos.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#DisparateMistreatment -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#DisparateMistreatment">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#NormativeDimension"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#appliesAtScope"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Group_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isPrincipleOf"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#DistributiveJustice_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">M. B. Zafar, I. Valera, M. Gomez Rodriguez, and K. P. Gummadi, ‘‘Fairness beyond disparate treatment &amp; disparate impact: Learning classification without disparate mistreatment,’’ in 26th Int’l Conf. on World Wide Web, pp. 1171–1180, 2017.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">DisparateMistreatment</rdfs:label>
        <skos:altLabel xml:lang="pt">Tratamento Dispar</skos:altLabel>
        <skos:definition xml:lang="en">Normative principle concerned with disparities in predictive error rates across groups, requiring that no protected group systematically bears higher rates of prediction errors (false positives or false negatives).</skos:definition>
        <skos:definition xml:lang="pt">Princípio normativo que proíbe erros de classificação desproporcionais entre grupos.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#DisparateTreatment -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#DisparateTreatment">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#NormativeDimension"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#appliesAtScope"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Individual_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isPrincipleOf"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#ProceduralJustice_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">J. Kleinberg, J. Ludwig, S. Mullainathan, and C. R. Sunstein, ‘‘Discrimination in the age of algorithms,’’ J. of Legal Analysis, vol. 10, pp. 113–174, 2018.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">DisparateTreatment</rdfs:label>
        <skos:altLabel xml:lang="pt">Tratamento Diferenciado</skos:altLabel>
        <skos:definition xml:lang="en">Normative principle that prohibits direct causal dependence of the decision on the protected attribute, requiring that a change in group status does not alter the outcome for the same individual. Aligned with formal equality in legal theory.</skos:definition>
        <skos:definition xml:lang="pt">Princípio normativo que proíbe dependência causal direta da decisão em relação ao atributo protegido.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#Distributional -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#Distributional">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#FairnessCriterion"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#criterionBelongsToApproach"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Statistical_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <probabilistic_definition>H(C | A=a) ≈ H(C | A=b)</probabilistic_definition>
        <rdfs:isDefinedBy xml:lang="en">I. Dominguez-Catena, D. Paternain, and M. Galar, ‘‘Metrics for dataset demographic bias: A case study on facial expression recognition,’’ IEEE Transactions on Pattern Analysis and Machine Int., vol. 46, no. 8, pp. 5209–5226, 2024.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Distributional</rdfs:label>
        <skos:altLabel xml:lang="pt">Distribucional</skos:altLabel>
        <skos:definition xml:lang="en">Criterion inspired by ecological diversity analysis that measures semantic concentration or dispersion within group-conditional representations, requiring comparable semantic diversity across groups</skos:definition>
        <skos:definition xml:lang="pt">Critério de fairness que requer equidade na distribuição de resultados entre grupos.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#DistributionalDiversity -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#DistributionalDiversity">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#RepresentationEquality"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isSpecialCaseOf"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#RepresentationEquality_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#satisfiesCriterion"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Distributional_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">I. Dominguez-Catena, D. Paternain, and M. Galar, ‘‘Metrics for dataset demographic bias: A case study on facial expression recognition,’’ IEEE Transactions on Pattern Analysis and Machine Int., vol. 46, no. 8, pp. 5209–5226, 2024.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">DistributionalDiversity</rdfs:label>
        <skos:altLabel xml:lang="pt">Diversidade Distribucional</skos:altLabel>
        <skos:definition xml:lang="pt">A igualdade de representação, inspirada na análise da diversidade ecológica, avalia se os grupos protegidos exibem cobertura e equilíbrio semânticos comparáveis ​​dentro do espaço de representação. Operacionalizada por meio de índices baseados em entropia e dominância, que medem a dispersão ou concentração sobre as distribuições semânticas condicionais ao grupo.</skos:definition>
        <skos:definition xml:lang="en">Representation equality inspired by ecological diversity analysis that assesses whether protected groups exhibit comparable semantic coverage and balance within the representation space. Operationalized through entropy- and dominance-based indices measuring dispersion or concentration over group-conditional semantic distributions.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#DistributiveEquity -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#DistributiveEquity">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#belongsToFamily"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#InequalityBased_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasEthicalDimension"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#DistributiveJustice_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasEvaluationLocus"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Extrinsic_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasMethodologicalApproach"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Statistical_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasSocioTechnicalScope"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Group_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#satisfiesCriterion"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#InequalityMinimization_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Y. Deldjoo, V. W. Anelli, H. Zamani, A. Bellogin, and T. Di Noia, ‘‘A flexible framework for evaluating user and item fairness in recommender systems,’’ User Modeling and User-Adapted Interaction, vol. 31, no. 3, pp. 457–511, 2021.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">DistributiveEquity</rdfs:label>
        <skos:altLabel xml:lang="pt">Igualdade Distributiva</skos:altLabel>
        <skos:definition xml:lang="pt">A noção de justiça, fundamentada na teoria do bem-estar social e em medidas de desigualdade baseadas na teoria da informação, concebe a justiça como uma questão de grau, avaliando como o erro, a informação ou o benefício são distribuídos de forma desigual na população, em vez de impor paridade estrita ou independência condicional.</skos:definition>
        <skos:definition xml:lang="en">Fairness notion grounded in social welfare theory and information-theoretic measures of inequality, conceptualizing fairness as a matter of degree by assessing how error, information, or benefit is unevenly distributed within the population, rather than enforcing strict parity or conditional independence.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#DistributiveJustice -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#DistributiveJustice">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#EthicalDimension"/>
        <owl:disjointWith rdf:resource="http://www.usp.br/fmlo#ProceduralJustice"/>
        <rdfs:isDefinedBy xml:lang="en">G. S. Leventhal, ‘‘The distribution of rewards and resources in groups and organizations,’’ in Advances in experimental social psychology, vol. 9, pp. 91–131, Elsevier, 1976.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">DistributiveJustice</rdfs:label>
        <skos:altLabel xml:lang="pt">Justiça Distributiva</skos:altLabel>
        <skos:definition xml:lang="pt">Dimensão ética que se preocupa com a distribuição justa de benefícios e ônus na sociedade.</skos:definition>
        <skos:definition xml:lang="en">Ethical orientation where fairness is conceptualized as the equitable allocation of benefits, opportunities, or predictive outcomes across individuals and groups, focusing on who receives favorable predictions and who bears disproportionate error burdens.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#EconomicalStatus -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#EconomicalStatus">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isProxyFor"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Ethnicity_i"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isProxyFor"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Race_i"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Where Bias Emerges in Machine Learning</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">EconomicalStatus</rdfs:label>
        <skos:altLabel xml:lang="pt">Condição Econômica</skos:altLabel>
        <skos:altLabel xml:lang="en">Income</skos:altLabel>
        <skos:definition xml:lang="en">A sensitive attribute referring to the economic condition of an individual or household, typically determined by financial indicators such as income level, wealth, or access to economic resources.</skos:definition>
        <skos:definition xml:lang="pt">Um atributo sensível que se refere à condição econômica de um indivíduo ou família, geralmente determinado por indicadores financeiros como nível de renda, patrimônio ou acesso a recursos econômicos.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#EducationalLevel -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#EducationalLevel">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isProxyFor"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#EconomicalStatus_i"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isProxyFor"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Race_i"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Unesco. (2012). International standard classification of education (ISCED) 2011. UNESCO.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">EducationalLevel</rdfs:label>
        <skos:altLabel xml:lang="pt">Nível de Escolaridade</skos:altLabel>
        <skos:definition xml:lang="en">An attribute that indicates the highest level of education completed by an individual.</skos:definition>
        <skos:definition xml:lang="pt">Um atributo que indica o mais alto nível de educação completado por um indivíduo.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#EqualityOfOpportunity -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#EqualityOfOpportunity">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasEthicalDimension"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#DistributiveJustice_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasEvaluationLocus"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Extrinsic_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasMethodologicalApproach"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Statistical_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasNormativePrinciple"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#DisparateMistreatment_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasSocioTechnicalScope"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Group_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isSpecialCaseOf"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#EqualizedOdds_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#satisfiesCriterion"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Separation_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Causal formulation by &quot;S. Corbett-Davies, J. D. Gaebler, H. Nilforoshan, R. Shroff, and S. Goel,‘‘The measure and mismeasure of fairness,’’ Journal of Machine Learning
Research, vol. 24, no. 312, pp. 1–117, 2023.&quot;</rdfs:comment>
        <rdfs:isDefinedBy xml:lang="en">M. Hardt, E. Price, and N. Srebro, ‘‘Equality of opportunity in supervised learning,’’ in 30th Conf. on Neural Inf. Processing Sys., pp. 1–9, 2016.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">EqualityOfOpportunity</rdfs:label>
        <skos:altLabel xml:lang="en">Equal Sensitivity</skos:altLabel>
        <skos:altLabel xml:lang="en">High-Risk Sensitivity</skos:altLabel>
        <skos:altLabel xml:lang="pt">Igualdade de Oportunidade</skos:altLabel>
        <skos:definition xml:lang="pt">Caso especial de Equalized Odds que requer paridade apenas para a classe de resultado desejável.</skos:definition>
        <skos:definition xml:lang="en">Special case of Equalized Odds requiring parity only for the desirable outcome class (Y=1), demanding equal TPR across groups, operationalizing the one-sided Separation criterion.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#EqualizedOdds -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#EqualizedOdds">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasCausalAnalogue"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#CounterfactualFairness_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasEthicalDimension"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#DistributiveJustice_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasEvaluationLocus"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Extrinsic_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasMethodologicalApproach"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Causal_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasMethodologicalApproach"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Statistical_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasNormativePrinciple"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#DisparateMistreatment_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasSocioTechnicalScope"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Group_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasTradeOffWith"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#PerformanceOriented_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isIncompatibleWith"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Calibration_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isIncompatibleWith"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#StatisticalParity_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#satisfiesCriterion"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Separation_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Causal formulation by &quot;S. Corbett-Davies, J. D. Gaebler, H. Nilforoshan, R. Shroff, and S. Goel,‘‘The measure and mismeasure of fairness,’’ Journal of Machine Learning
Research, vol. 24, no. 312, pp. 1–117, 2023.&quot;</rdfs:comment>
        <rdfs:isDefinedBy xml:lang="en">M. Hardt, E. Price, and N. Srebro, ‘‘Equality of opportunity in supervised learning,’’ in 30th Conf. on Neural Inf. Processing Sys., pp. 1–9, 2016.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">EqualizedOdds</rdfs:label>
        <skos:altLabel xml:lang="pt">Chances equalizadas</skos:altLabel>
        <skos:definition xml:lang="en">Fairness notion requiring parity of prediction behavior across groups conditional on the true label for both outcome classes</skos:definition>
        <skos:definition xml:lang="pt">Noção de fairness que requer taxas iguais de verdadeiros positivos e falsos positivos entre grupos.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#ErrorCostParity -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#ErrorCostParity">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#LossBased"/>
        <probabilistic_definition xml:lang="en">FNR/FPR ⊥ A</probabilistic_definition>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Bias-Discovery and Mitigation Solutions</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">ErrorCostParity</rdfs:label>
        <skos:altLabel xml:lang="pt">Paridade de Custo de Erro</skos:altLabel>
        <skos:definition xml:lang="pt">Critério baseado em perda que foca em equalizar a razão de custos de erro entre falsos negativos e falsos positivos.</skos:definition>
        <skos:definition xml:lang="en">Loss-based criteria that focuses on equalizing the ratio of error costs between false negatives and false positives.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#EthicalDimension -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#EthicalDimension">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#encompassPrinciple"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.usp.br/fmlo#NormativeDimension"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Bias-Discovery and Mitigation Solutions</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">EthicalDimension</rdfs:label>
        <skos:altLabel xml:lang="pt">Dimensão Ética</skos:altLabel>
        <skos:definition xml:lang="en">A high-level layer that defines the ethical and philosophical foundation situating fairness in machine learning in classical theories of justice.</skos:definition>
        <skos:definition xml:lang="pt">Uma camada de alto nível que define a base ética e filosófica que situa a equidade na aprendizagem de máquina dentro das teorias clássicas da justiça.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#Ethnicity -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#Ethnicity">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isClassifiedAs"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#ProtectedCharacteristic_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isClassifiedAs"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#SensitivePersonalData_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Edwards, C. L., Fillingim, R. B., &amp; Keefe, F. (2001). Race, ethnicity and pain. Pain, 94(2), 133-137.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Ethnicity</rdfs:label>
        <skos:altLabel xml:lang="pt">Etnia</skos:altLabel>
        <skos:definition xml:lang="en">An attribute that refers to an individual&apos;s cultural identity and affiliation with a particular group, typically defined through shared traditions, ancestry, religion, beliefs, values, language, and practices</skos:definition>
        <skos:definition xml:lang="pt">Um atributo que se refere à identidade cultural de um indivíduo e à sua afiliação a um determinado grupo, geralmente definida por meio de tradições, ancestralidade, religião, crenças, valores, idioma e práticas compartilhadas.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#EvaluationBias -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#EvaluationBias">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#BiasSource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#originatesIn"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#ModelEvaluation_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#originatesInPhase"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#PostProcessing_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Harini Suresh and John Guttag. 2021. A Framework for Understanding Sources of Harm throughout the Machine Learning Life Cycle. In Proceedings of the 1st ACM Conference on Equity and Access in Algorithms, Mechanisms, and Optimization (EAAMO &apos;21). Association for Computing Machinery, New York, NY, USA, Article 17, 1–9. https://doi.org/10.1145/3465416.3483305</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">EvaluationBias</rdfs:label>
        <skos:altLabel xml:lang="pt">Viés de avaliação</skos:altLabel>
        <skos:definition xml:lang="en">Occurs when the benchmark data used for a particular task does not represent the use population.</skos:definition>
        <skos:definition xml:lang="pt">Ocorre quando os dados de benchmark usados para uma tarefa particular não representam a população de uso.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#EvaluationLocus -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#EvaluationLocus">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasFamily"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.usp.br/fmlo#StatisticalFamily"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Y. Li, M. Du, R. Song, X. Wang, and Y. Wang, ‘‘A survey on fairness in large language models,’’ arXiv preprint arXiv:2308.10149, 2023.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">EvaluationLocus</rdfs:label>
        <skos:altLabel xml:lang="pt">Locus de Avaliação</skos:altLabel>
        <skos:definition xml:lang="en">Categorizes fairness notions based on the specific site of evaluation, distinguishing whether fairness is assessed through the external effects of a model or through structural disparities encoded in its internal representations.</skos:definition>
        <skos:definition xml:lang="pt">Classifica as noções de justiça com base no local específico de avaliação, distinguindo se a justiça é avaliada por meio dos efeitos externos de um modelo ou por meio de disparidades estruturais codificadas em suas representações internas.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#ExploratoryTechnique -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#ExploratoryTechnique">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#BiasDiscoveryTechnique"/>
        <owl:disjointWith rdf:resource="http://www.usp.br/fmlo#MeasurementTechnique"/>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Bias-Discovery and Mitigation Solutions</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">ExploratoryTechnique</rdfs:label>
        <skos:altLabel xml:lang="pt">Técnica Exploratória</skos:altLabel>
        <skos:definition xml:lang="en">Discovery methods focused on detecting and quantifying bias through empirical experiments or theoretical frameworks applied to datasets or trained models.</skos:definition>
        <skos:definition xml:lang="pt">Métodos de descoberta focados em detectar e quantificar viés através de experimentos empíricos ou frameworks teóricos.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#Extrinsic -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#Extrinsic">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#EvaluationLocus"/>
        <owl:disjointWith rdf:resource="http://www.usp.br/fmlo#Intrinsic"/>
        <rdfs:isDefinedBy xml:lang="en">Y. Li, M. Du, R. Song, X. Wang, and Y. Wang, ‘‘A survey on fairness in large language models,’’ arXiv preprint arXiv:2308.10149, 2023.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Extrinsic</rdfs:label>
        <skos:altLabel xml:lang="pt">Extrínseco</skos:altLabel>
        <skos:definition xml:lang="en">Evaluation locus that assesses fairness through disparities in observable quantities external to the representation itself, such as predictions, outcomes, errors, losses, or utilities. Requires variables associated with a decision-making process.</skos:definition>
        <skos:definition xml:lang="pt">Locus de avaliação que avalia fairness através de referência a rótulos de ground-truth externos.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#FairnessCriterion -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#FairnessCriterion">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#criterionBelongsToApproach"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.usp.br/fmlo#MethodologicalApproach"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Bias-Discovery and Mitigation Solutions</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">FairnessCriterion</rdfs:label>
        <skos:altLabel xml:lang="pt">Critério de Justiça</skos:altLabel>
        <skos:definition xml:lang="pt">Estabelece o padrão formal usado para operacionalizar fairness.</skos:definition>
        <skos:definition xml:lang="en">Establishes the formal standard used to operationalize fairness notions.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#FairnessMetric -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#FairnessMetric">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#requiresDataType"/>
                <owl:someValuesFrom rdf:resource="http://www.usp.br/fmlo#AttributeDataType"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#operationalizes"/>
                <owl:allValuesFrom rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#formalizesCriterion"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.usp.br/fmlo#FairnessCriterion"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasOperationalization"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.usp.br/fmlo#MetricOperationalization"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasAcronym"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasFormula"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasIdealValue"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Bias-Discovery and Mitigation Solutions</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">FairnessMetric</rdfs:label>
        <skos:altLabel xml:lang="pt">Métrica de Justiça</skos:altLabel>
        <skos:definition xml:lang="pt">Medida escalar que quantifica o grau em que um modelo ou dataset desvia de uma noção de fairness.</skos:definition>
        <skos:definition xml:lang="en">Scalar measure that quantifies the degree to which a model or dataset deviates from a given fairness notion.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#FairnessNotion -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#FairnessNotion">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#requiresAccessTo"/>
                <owl:someValuesFrom rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasDualRole"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.usp.br/fmlo#FairnessMetric"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Bias-Discovery and Mitigation Solutions</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">FairnessNotion</rdfs:label>
        <skos:altLabel xml:lang="pt">Noção de Justiça</skos:altLabel>
        <skos:definition xml:lang="en">Conceptual definition of fairness grounded in probabilistic, statistical, causal, or geometric criteria, applicable to models, predictions, or data distributions.</skos:definition>
        <skos:definition xml:lang="pt">Definição conceitual de fairness fundamentada em critérios probabilísticos, estatísticos, causais ou geométricos.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#FairnessThroughAwareness -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#FairnessThroughAwareness">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasEthicalDimension"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#ProceduralJustice_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasEvaluationLocus"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Extrinsic_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasMethodologicalApproach"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Geometric_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasNormativePrinciple"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Consistency_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasSocioTechnicalScope"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Individual_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#satisfiesCriterion"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Similarity_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">C. Dwork, M. Hardt, T. Pitassi, O. Reingold, and R. Zemel, ‘‘Fairness through awareness,’’ in 3rd Innovations in Theoretical Computer Sci.
Conf., pp. 214–226, 2012.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">FairnessThroughAwareness</rdfs:label>
        <skos:altLabel xml:lang="pt">Justiça por Consciência</skos:altLabel>
        <skos:definition xml:lang="en">Fairness notion requiring that individuals similar with respect to task-relevant characteristics be treated similarly.</skos:definition>
        <skos:definition xml:lang="pt">Noção de fairness que requer que indivíduos similares sejam tratados de forma similar.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#Gender -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#Gender">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isClassifiedAs"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#ProtectedCharacteristic_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Canadian Institutes of Health Research (CIHR). https://cihr-irsc.gc.ca/e/47830.html</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Gender</rdfs:label>
        <skos:altLabel xml:lang="pt">Gênero</skos:altLabel>
        <skos:definition xml:lang="en">An attribute that refers to the socially constructed roles, behaviours, expressions and identities of girls, women, boys, men, and gender diverse people.</skos:definition>
        <skos:definition xml:lang="pt">Um atributo que se refere aos papéis, comportamentos, expressões e identidades socialmente construídos de meninas, mulheres, meninos, homens e pessoas com diversidade de gênero.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#GeneticCharacteristic -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#GeneticCharacteristic">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isClassifiedAs"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#SensitivePersonalData_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">General Data Protection Regulation (GDPR), Recital 34. Available: https://gdpr.eu/Recital-34-Genetic-data/</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">GeneticCharacteristic</rdfs:label>
        <skos:altLabel xml:lang="pt">Características Genéticas</skos:altLabel>
        <skos:definition xml:lang="en">A personal data relating to the inherited or acquired genetic characteristics of a natural person which give unique information about the physiology or the health of that natural person and which result, in particular, from an analysis of a biological sample from the natural person in question</skos:definition>
        <skos:definition xml:lang="pt">Dados pessoais relativos às características genéticas herdadas ou adquiridas de uma pessoa singular, que fornecem informações únicas sobre a fisiologia ou a saúde dessa pessoa singular e que resultam, em particular, da análise de uma amostra biológica da referida pessoa.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#GeographyLocation -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#GeographyLocation">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isProxyFor"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#EconomicalStatus_i"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isProxyFor"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Ethnicity_i"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isProxyFor"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Race_i"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Where Bias Emerges in Machine Learning</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">GeographyLocation</rdfs:label>
        <skos:altLabel xml:lang="pt">Localização Geográfica</skos:altLabel>
        <skos:definition xml:lang="en">An attribute of the geographical location of an individual or population.</skos:definition>
        <skos:definition xml:lang="pt">Um atributo da localização geográfica de um indivíduo ou população.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#Geometric -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#Geometric">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#MethodologicalApproach"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#approachHasLocus"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Extrinsic_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">C. Dwork, M. Hardt, T. Pitassi, O. Reingold, and R. Zemel, ‘‘Fairness through awareness,’’ in 3rd Innovations in Theoretical Computer Sci. Conf., pp. 214–226, 2012.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Geometric</rdfs:label>
        <skos:altLabel xml:lang="pt">Geométrico</skos:altLabel>
        <skos:definition xml:lang="pt">Abordagem metodológica baseada em conceitos geométricos de distância e similaridade.</skos:definition>
        <skos:definition xml:lang="en">Methodological approach in which fairness is formalized through the geometric or topological structure of the individual or representation space, imposing locality-preserving constraints requiring that proximity in the input or latent space be reflected by proximity in the decision space.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#Group -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#Group">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#SocioTechnicalScope"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#requiresAccessTo"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">T. Calders and S. Verwer, ‘‘Three naive bayes approaches for discrimination-free classification,’’ Data Mining and Knowledge Discovery, vol. 21, pp. 277–292, 2010.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Group</rdfs:label>
        <skos:altLabel xml:lang="pt">Grupo</skos:altLabel>
        <skos:definition xml:lang="pt">Escopo sociotécnico que avalia fairness no nível de grupos definidos por atributos protegidos.</skos:definition>
        <skos:definition xml:lang="en">Scope level that evaluates equity through parity constraints on predictions, allocations, or error rates across protected groups, focusing on aggregate disparities rather than pairwise similarity.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#Guidelines -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#Guidelines">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#StructuralMethodologicalContributions"/>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Bias-Discovery and Mitigation Solutions</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Guidelines</rdfs:label>
        <skos:altLabel xml:lang="pt">Diretrizes</skos:altLabel>
        <skos:definition xml:lang="pt">Contribuições estruturais que fornecem boas práticas acionáveis e aconselhamento de políticas.</skos:definition>
        <skos:definition xml:lang="en">Structural contributions providing actionable best practices and policy advice derived from empirical, legal, or ethical considerations to guide AI development.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#HealthInsurance -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#HealthInsurance">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isProxyFor"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#EconomicalStatus_i"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isProxyFor"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Race_i"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Adapted from: Organisation for Economic Co-operation and Development (OECD). (2017). Health at a Glance 2017: OECD Indicators.
https://doi.org/10.1787/health_glance-2017-en</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">HealthInsurance</rdfs:label>
        <skos:altLabel xml:lang="pt">Seguro de Saúde</skos:altLabel>
        <skos:definition xml:lang="en">A sensitive attribute referring to the type or presence of health insurance coverage.</skos:definition>
        <skos:definition xml:lang="pt">Um atributo sensível referente ao tipo ou presença de cobertura de seguro de saúde.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#HistoricalBias -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#HistoricalBias">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#BiasSource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#originatesIn"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#DataCollection_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#originatesInPhase"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#PreProcessing_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Harini Suresh and John Guttag. 2021. A Framework for Understanding Sources of Harm throughout the Machine Learning Life Cycle. In Proceedings of the 1st ACM Conference on Equity and Access in Algorithms, Mechanisms, and Optimization (EAAMO &apos;21). Association for Computing Machinery, New York, NY, USA, Article 17, 1–9. https://doi.org/10.1145/3465416.3483305</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">HistoricalBias</rdfs:label>
        <skos:altLabel xml:lang="pt">Viés histórico</skos:altLabel>
        <skos:definition xml:lang="en">Occurs when training data contains biased patterns reflecting historical inequities in the real world.</skos:definition>
        <skos:definition xml:lang="pt">Ocorre quando os dados de treino contêm padrões enviesados refletindo iniquidades históricas no mundo real.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#HospitalLocation -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#HospitalLocation">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isProxyFor"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#EconomicalStatus_i"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isProxyFor"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#GeographyLocation_i"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isProxyFor"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Race_i"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Where Bias Emerges in Machine Learning</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">HospitalLocation</rdfs:label>
        <skos:altLabel xml:lang="pt">Localização do Hospital</skos:altLabel>
        <skos:definition xml:lang="en">An attribute that refers to the hospital location or site where healthcare is provided.</skos:definition>
        <skos:definition xml:lang="pt">Um atributo que se refere à localização do hospital ou site onde os cuidados de saúde são prestados.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#HybridTechnique -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#HybridTechnique">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#ExploratoryTechnique"/>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Bias-Discovery and Mitigation Solutions</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">HybridTechnique</rdfs:label>
        <skos:altLabel xml:lang="pt">Técnica Híbrida</skos:altLabel>
        <skos:definition xml:lang="en">Exploratory methods that combine data-centric and model-centric auditing to trace how dataset biases propagate and amplify in model predictions.</skos:definition>
        <skos:definition xml:lang="pt">Métodos exploratórios que combinam auditoria centrada em dados e centrada em modelos.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#ImmigrationStatus -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#ImmigrationStatus">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isProxyFor"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Ethnicity_i"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isProxyFor"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Nationality_i"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isProxyFor"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Race_i"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Where Bias Emerges in Machine Learning</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">ImmigrationStatus</rdfs:label>
        <skos:altLabel xml:lang="pt">Status Migratório</skos:altLabel>
        <skos:definition xml:lang="en">An attribute that refers to the legal status of an individual within a country.</skos:definition>
        <skos:definition xml:lang="pt">Um atributo que se refere ao status legal de um indivíduo dentro de um país.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#InProcessing -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#InProcessing">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#ProcessingPhase"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#mapsToStage"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#ModelDevelopment_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Where Bias Emerges in Machine Learning</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">InProcessing</rdfs:label>
        <skos:altLabel xml:lang="pt">em processamento</skos:altLabel>
        <skos:definition xml:lang="pt">Fase de processamento do ciclo de vida do aprendizado de máquina que ocorre antes do treinamento do modelo, abrangendo todas as atividades relacionadas à coleta, preparação e transformação de dados.</skos:definition>
        <skos:definition xml:lang="en">Processing phase of the ML lifecycle occurring during model training, encompassing algorithm selection, objective function definition, and learning procedures.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#Independence -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#Independence">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#FairnessCriterion"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#criterionBelongsToApproach"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Statistical_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <probabilistic_definition>R ⊥ A</probabilistic_definition>
        <rdfs:isDefinedBy xml:lang="en">Barocas, S., Hardt, M., &amp; Narayanan, A. (2019). Fairness and machine learning: Limitations and opportunities. fairmlbook. org.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Independence</rdfs:label>
        <skos:altLabel xml:lang="pt">Independência</skos:altLabel>
        <skos:definition xml:lang="en">Criterion requiring predictions to be statistically independent of group membership (R ⊥ A), ensuring that the probability of receiving a favorable outcome is invariant across protected groups.</skos:definition>
        <skos:definition xml:lang="pt">Critério de fairness que requer independência estatística entre a decisão e o atributo protegido.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#Individual -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#Individual">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#SocioTechnicalScope"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#requiresAccessTo"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">C. Dwork, M. Hardt, T. Pitassi, O. Reingold, and R. Zemel, ‘‘Fairness through awareness,’’ in 3rd Innovations in Theoretical Computer Sci. Conf., pp. 214–226, 2012.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Individual</rdfs:label>
        <skos:altLabel xml:lang="pt">Indivíduo</skos:altLabel>
        <skos:definition xml:lang="pt">Escopo sociotécnico que avalia fairness no nível de indivíduos similares.</skos:definition>
        <skos:definition xml:lang="en">Scope level requiring that similar individuals receive similar outcomes, emphasizing consistency of treatment within local neighborhoods of the feature or representation space, regardless of group membership</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#InequalityBased -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#InequalityBased">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#StatisticalFamily"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasCriterion"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#InequalityMinimization_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isFamilyOf"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Extrinsic_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Y. Deldjoo, V. W. Anelli, H. Zamani, A. Bellogin, and T. Di Noia, ‘‘A flexible framework for evaluating user and item fairness in recommender systems,’’ User Modeling and User-Adapted Interaction, vol. 31, no. 3, pp. 457–511, 2021.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">InequalityBased</rdfs:label>
        <skos:altLabel xml:lang="pt">Baseado em Desigualdade</skos:altLabel>
        <skos:definition xml:lang="pt">Família estatística que avalia fairness através de medidas de desigualdade.</skos:definition>
        <skos:definition xml:lang="en">Statistical family that departs from conditional independence constraints to operationalize fairness as the minimization of benefit or loss dispersion,</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#InequalityMinimization -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#InequalityMinimization">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#FairnessCriterion"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#criterionBelongsToApproach"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Statistical_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <probabilistic_definition>Φ(u | A=a) ≈ Φ(u | A=b), ∀a,b</probabilistic_definition>
        <rdfs:isDefinedBy xml:lang="en">Y. Deldjoo, V. W. Anelli, H. Zamani, A. Bellogin, and T. Di Noia, ‘‘A flexible framework for evaluating user and item fairness in recommender systems,’’ User Modeling and User-Adapted Interaction, vol. 31, no. 3, pp. 457–511, 2021.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">InequalityMinimization</rdfs:label>
        <skos:altLabel xml:lang="pt">Minimização de Desigualdade</skos:altLabel>
        <skos:definition xml:lang="en">Criterion requiring that the dispersion of harm or benefit, measured by an inequality functional, remains comparable across protected groups or bounded for the worst-off group. Grounded in welfare economics and information theory.</skos:definition>
        <skos:definition xml:lang="pt">Critério de fairness que busca minimizar métricas de desigualdade entre grupos.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#Intersectional -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#Intersectional">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#SocioTechnicalScope"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#requiresAccessTo"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">M. Kearns, S. Neel, A. Roth, and Z. S. Wu, ‘‘Preventing fairness gerrymandering: Auditing and learning for subgroup fairness,’’ in 35th Int’l Conf. on Machine Learning, pp. 2564–2572, PMLR, 2018.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Intersectional</rdfs:label>
        <skos:altLabel xml:lang="pt">Interseccional</skos:altLabel>
        <skos:definition xml:lang="pt">Nível de escopo que estende critérios baseados em grupo exigindo garantias em interseções de múltiplos atributos.</skos:definition>
        <skos:definition xml:lang="en">Scope level that extends group-based criteria by requiring fairness guarantees to hold across intersections of multiple protected attributes.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#Intrinsic -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#Intrinsic">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#EvaluationLocus"/>
        <rdfs:isDefinedBy xml:lang="en">Y. Li, M. Du, R. Song, X. Wang, and Y. Wang, ‘‘A survey on fairness in large language models,’’ arXiv preprint arXiv:2308.10149, 2023.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Intrinsic</rdfs:label>
        <skos:altLabel xml:lang="pt">Intrínseco</skos:altLabel>
        <skos:definition xml:lang="en">Evaluation locus that evaluates fairness directly within the learned representation, by comparing distributional properties of internal scores, distances, similarities, or associations, without reference to explicit decisions, labels, or downstream outcomes.</skos:definition>
        <skos:definition xml:lang="pt">Local de avaliação que avalia a equidade diretamente dentro da representação aprendida, comparando propriedades distribucionais de pontuações internas, distâncias, similaridades ou associações, sem referência a decisões explícitas, rótulos ou resultados subsequentes.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#Invariance -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#Invariance">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#FairnessCriterion"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#criterionBelongsToApproach"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Causal_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <probabilistic_definition>Ŷ(A←a)(x) = Ŷ(A←a&apos;)(x), ∀a,a&apos;</probabilistic_definition>
        <rdfs:isDefinedBy xml:lang="en">C. Agarwal, H. Lakkaraju, and M. Zitnik, ‘‘Towards a unified framework for fair and stable graph representation learning,’’ in Uncertainty in artificial intelligence, pp. 2114–2124, PMLR, 2021.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Invariance</rdfs:label>
        <skos:altLabel xml:lang="pt">Invariancia</skos:altLabel>
        <skos:definition xml:lang="en">Causal criterion imposing a strict equality condition requiring that the model&apos;s decision remains mathematically identical for the same individual under any intervention on the protected attribute</skos:definition>
        <skos:definition xml:lang="pt">Critério de fairness baseado em invariância causal das predições.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#Language -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#Language">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isProxyFor"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Ethnicity_i"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isProxyFor"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#ImmigrationStatus_i"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isProxyFor"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Nationality_i"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Where Bias Emerges in Machine Learning</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Language</rdfs:label>
        <skos:altLabel xml:lang="pt">Idioma</skos:altLabel>
        <skos:definition xml:lang="en">An attribute that refers to the way individuals communicate, encompassing both spoken and written forms.</skos:definition>
        <skos:definition xml:lang="pt">Um atributo que se refere à forma como os indivíduos se comunicam, abrangendo formas faladas e escritas.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#LearningBias -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#LearningBias">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#BiasSource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#originatesIn"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#ModelDevelopment_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#originatesInPhase"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#InProcessing_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Harini Suresh and John Guttag. 2021. A Framework for Understanding Sources of Harm throughout the Machine Learning Life Cycle. In Proceedings of the 1st ACM Conference on Equity and Access in Algorithms, Mechanisms, and Optimization (EAAMO &apos;21). Association for Computing Machinery, New York, NY, USA, Article 17, 1–9. https://doi.org/10.1145/3465416.3483305</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">LearningBias</rdfs:label>
        <skos:altLabel xml:lang="pt">Viés de aprendizado</skos:altLabel>
        <skos:definition xml:lang="pt">Refere-se ao dano que surge durante a fase de treinamento de um modelo de aprendizado de máquina quando as escolhas de modelagem amplificam as disparidades entre grupos, mesmo quando os dados são representativos.</skos:definition>
        <skos:definition xml:lang="en">Refers to the harm that arises during the training phase of a machine learning model when modeling choices amplify disparities between groups, even when the data is representative.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#LegalFramework -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#LegalFramework">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#protects"/>
                <owl:someValuesFrom rdf:resource="http://www.usp.br/fmlo#Data"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasEnactmentYear"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasJurisdiction"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Data Privacy Vocabulary (DPV)</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">LegalFramework</rdfs:label>
        <skos:altLabel xml:lang="pt">Documento Legal</skos:altLabel>
        <skos:closeMatch rdf:resource="https://w3c.github.io/dpv/2.3/dpv/#Law"/>
        <skos:definition xml:lang="en">A formal document issued by a governmental or regulatory authority establishing legal requirements.</skos:definition>
        <skos:definition xml:lang="pt">Um documento formal emitido por autoridade governamental ou reguladora estabelecendo requisitos legais.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#LifeCycleStage -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#LifeCycleStage">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasOrder"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Harini Suresh and John Guttag. 2021. A Framework for Understanding Sources of Harm throughout the Machine Learning Life Cycle. In Proceedings of the 1st ACM Conference on Equity and Access in Algorithms, Mechanisms, and Optimization (EAAMO &apos;21). Association for Computing Machinery, New York, NY, USA, Article 17, 1–9. https://doi.org/10.1145/3465416.3483305</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">LifeCycleStage</rdfs:label>
        <skos:altLabel xml:lang="pt">Estágio do Ciclo de Vida</skos:altLabel>
        <skos:definition xml:lang="en">Broader stage within the machine learning development lifecycle, from problem formulation through deployment and monitoring.</skos:definition>
        <skos:definition xml:lang="pt">Estágio mais amplo dentro do ciclo de vida de desenvolvimento de ML.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#LossBased -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#LossBased">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#FairnessCriterion"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#criterionBelongsToApproach"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Statistical_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Bias-Discovery and Mitigation Solutions</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">LossBased</rdfs:label>
        <skos:altLabel xml:lang="pt">Baseado em Perda</skos:altLabel>
        <skos:definition xml:lang="en">Criteria that emerges when standard performance measures are directly repurposed as fairness objectives.</skos:definition>
        <skos:definition xml:lang="pt">Critério de fairness baseado em funções de perda equalizadas entre grupos.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#MLTask -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#MLTask">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Bias-Discovery and Mitigation Solutions</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">MLTask</rdfs:label>
        <skos:altLabel xml:lang="pt">tarefa de ML</skos:altLabel>
        <skos:closeMatch rdf:resource="https://purl.org/twc/fmo#MLProblem%20"/>
        <skos:definition xml:lang="en">A specific computational problem or learning objective addressed by a machine learning system.</skos:definition>
        <skos:definition xml:lang="pt">Um problema computacional específico ou objetivo de aprendizado endereçado por um sistema de aprendizado de máquina.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#MaritalStatus -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#MaritalStatus">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isClassifiedAs"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#ProtectedCharacteristic_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">UNSTAT: Principles and Recommendations for Population and Housing Censuses; Series M No. 67/Rev.2. https://www.unescwa.org/sd-glossary/marital-status</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">MaritalStatus</rdfs:label>
        <skos:altLabel xml:lang="en">CivilPartnerships</skos:altLabel>
        <skos:altLabel xml:lang="pt">Estado Civil</skos:altLabel>
        <skos:definition xml:lang="en">An attribute that refers to the personal status of each individual in relation to marriage or civil partnership.</skos:definition>
        <skos:definition xml:lang="pt">Um atributo que se refere ao status pessoal de cada indivíduo em relação ao casamento ou parceria civil.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#MeasurementBias -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#MeasurementBias">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#BiasSource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#originatesIn"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#DataCollection_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#originatesInPhase"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#PreProcessing_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Harini Suresh and John Guttag. 2021. A Framework for Understanding Sources of Harm throughout the Machine Learning Life Cycle. In Proceedings of the 1st ACM Conference on Equity and Access in Algorithms, Mechanisms, and Optimization (EAAMO &apos;21). Association for Computing Machinery, New York, NY, USA, Article 17, 1–9. https://doi.org/10.1145/3465416.3483305</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">MeasurementBias</rdfs:label>
        <skos:altLabel xml:lang="pt">Viés de mensuração</skos:altLabel>
        <skos:definition xml:lang="en">Occurs when there are errors or inconsistencies in choosing, collecting, or computing features and labels.</skos:definition>
        <skos:definition xml:lang="pt">Ocorre quando há erros ou inconsistências na escolha, coleta ou computação de features e labels.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#MeasurementTechnique -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#MeasurementTechnique">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#BiasDiscoveryTechnique"/>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Bias-Discovery and Mitigation Solutions</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">MeasurementTechnique</rdfs:label>
        <skos:altLabel xml:lang="pt">Técnica de Medição</skos:altLabel>
        <skos:definition xml:lang="en">Discovery methods whose primary contribution is proposing a novel fairness notion or quantification framework, rather than using existing metrics as validation tools.</skos:definition>
        <skos:definition xml:lang="pt">Métodos de descoberta cuja contribuição principal é propor uma nova noção de fairness ou framework de quantificação.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#MethodologicalApproach -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#MethodologicalApproach">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#approachHasCriterion"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.usp.br/fmlo#FairnessCriterion"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Bias-Discovery and Mitigation Solutions</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">MethodologicalApproach</rdfs:label>
        <skos:altLabel xml:lang="pt">Abordagem Metodológica</skos:altLabel>
        <skos:definition xml:lang="pt">Especifica o aparato formal pelo qual fairness é expressa e avaliada em sistemas de ML.</skos:definition>
        <skos:definition xml:lang="en">Specifies the formal apparatus through which fairness is expressed and evaluated in ML systems.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#MetricOperationalization -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#MetricOperationalization">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Bias-Discovery and Mitigation Solutions</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">MetricOperationalization</rdfs:label>
        <skos:altLabel xml:lang="pt">Operacionalização de Métrica</skos:altLabel>
        <skos:definition xml:lang="pt">Classifica métricas de fairness pelo seu método de computação matemático.</skos:definition>
        <skos:definition xml:lang="en">Classifies fairness metrics by their mathematical computation method.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#ModelCentricTechnique -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#ModelCentricTechnique">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#ExploratoryTechnique"/>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Bias-Discovery and Mitigation Solutions</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">ModelCentricTechnique</rdfs:label>
        <skos:altLabel xml:lang="pt">Técnica Centrada no Modelo</skos:altLabel>
        <skos:definition xml:lang="en">Exploratory methods that empirically analyze a trained models outputs, applying fairness metrics or qualitative inspections to identify performance disparities across demographic subgroups.</skos:definition>
        <skos:definition xml:lang="pt">Métodos exploratórios que analisam empiricamente as saídas de um modelo treinado.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#ModelDeployment -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#ModelDeployment">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#LifeCycleStage"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasMappedPhase"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#PostProcessing_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Harini Suresh and John Guttag. 2021. A Framework for Understanding Sources of Harm throughout the Machine Learning Life Cycle. In Proceedings of the 1st ACM Conference on Equity and Access in Algorithms, Mechanisms, and Optimization (EAAMO &apos;21). Association for Computing Machinery, New York, NY, USA, Article 17, 1–9. https://doi.org/10.1145/3465416.3483305</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">ModelDeployment</rdfs:label>
        <skos:altLabel xml:lang="pt">Implantação do Modelo</skos:altLabel>
        <skos:definition xml:lang="pt">Etapa em que um modelo treinado é integrado a um contexto do mundo real, envolvendo o design da interface do usuário, requisitos de explicabilidade, mecanismos de feedback e interação com tomadores de decisão humanos.</skos:definition>
        <skos:definition xml:lang="en">Stage in which a trained model is integrated into a real-world context, involving user interface design, explainability requirements, feedback mechanisms, and interaction with human decision-makers.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#ModelDevelopment -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#ModelDevelopment">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#LifeCycleStage"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasMappedPhase"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#InProcessing_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Harini Suresh and John Guttag. 2021. A Framework for Understanding Sources of Harm throughout the Machine Learning Life Cycle. In Proceedings of the 1st ACM Conference on Equity and Access in Algorithms, Mechanisms, and Optimization (EAAMO &apos;21). Association for Computing Machinery, New York, NY, USA, Article 17, 1–9. https://doi.org/10.1145/3465416.3483305</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">ModelDevelopment</rdfs:label>
        <skos:altLabel xml:lang="pt">Desenvolvimento do Modelo</skos:altLabel>
        <skos:definition xml:lang="pt">Estágio no qual modelos são construídos usando dados de treino.</skos:definition>
        <skos:definition xml:lang="en">Stage in which models are built using training data, involving architecture instantiation and optimization.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#ModelEvaluation -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#ModelEvaluation">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#LifeCycleStage"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasMappedPhase"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#PostProcessing_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Harini Suresh and John Guttag. 2021. A Framework for Understanding Sources of Harm throughout the Machine Learning Life Cycle. In Proceedings of the 1st ACM Conference on Equity and Access in Algorithms, Mechanisms, and Optimization (EAAMO &apos;21). Association for Computing Machinery, New York, NY, USA, Article 17, 1–9. https://doi.org/10.1145/3465416.3483305</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">ModelEvaluation</rdfs:label>
        <skos:altLabel xml:lang="pt">Avaliação do Modelo</skos:altLabel>
        <skos:definition xml:lang="pt">Etapa em que o desempenho do modelo final é avaliado em dados de teste reservados e conjuntos de dados de referência externos, usando métricas específicas da tarefa para medir a qualidade e a generalização.</skos:definition>
        <skos:definition xml:lang="en">Stage in which the final model&apos;s performance is assessed on held-out test data and external benchmark datasets, using task-specific metrics to measure quality and generalization.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#ModelPostProcessing -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#ModelPostProcessing">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#LifeCycleStage"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasMappedPhase"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#PostProcessing_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Harini Suresh and John Guttag. 2021. A Framework for Understanding Sources of Harm throughout the Machine Learning Life Cycle. In Proceedings of the 1st ACM Conference on Equity and Access in Algorithms, Mechanisms, and Optimization (EAAMO &apos;21). Association for Computing Machinery, New York, NY, USA, Article 17, 1–9. https://doi.org/10.1145/3465416.3483305</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">ModelPostProcessing</rdfs:label>
        <skos:altLabel xml:lang="pt">Pós-processamento do Modelo</skos:altLabel>
        <skos:definition xml:lang="pt">Estágio envolvendo transformações aplicadas às saídas do modelo após o treino.</skos:definition>
        <skos:definition xml:lang="en">Stage involving transformations applied to model outputs after training, such as threshold selection.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#MotionStatus -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#MotionStatus">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
        <rdfs:isDefinedBy xml:lang="en">Sun, Y., Haghighat, F., &amp; Fung, B. C. (2022). Trade-off between accuracy and fairness of data-driven building and indoor environment models: A comparative study of pre-processing methods. Energy, 239, 122273.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">MotionStatus</rdfs:label>
        <skos:altLabel xml:lang="pt">Estado de movimento</skos:altLabel>
        <skos:definition xml:lang="en">An attribute that refers to the operational state of devices, sensors or systems, commonly used in smart environments.</skos:definition>
        <skos:definition xml:lang="pt">Um atributo que se refere ao estado operacional de dispositivos, sensores ou sistemas, comumente usado em ambientes inteligentes.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#Nationality -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#Nationality">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isClassifiedAs"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#ProtectedCharacteristic_i"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isClassifiedAs"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#SensitivePersonalData_i"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">International Organization for Migration. International Migration Law. Glossary on Migration (2019)</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Nationality</rdfs:label>
        <skos:altLabel xml:lang="pt">Nacionalidade</skos:altLabel>
        <skos:definition xml:lang="en">An attribute that refers to the country of origin or citizenship of an individual.</skos:definition>
        <skos:definition xml:lang="pt">Um atributo que se refere ao país de origem ou cidadania de um indivíduo.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#NormativeDimension -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#NormativeDimension">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isPrincipleOf"/>
                <owl:someValuesFrom rdf:resource="http://www.usp.br/fmlo#EthicalDimension"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Bias-Discovery and Mitigation Solutions</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">NormativePrinciples</rdfs:label>
        <skos:altLabel xml:lang="pt">Dimensão Normativa</skos:altLabel>
        <skos:definition xml:lang="en">Acts as the translation layer between abstract ethical values and technical implementation, specifying the prescriptive criteria that define a fair state. Incorporates established legal doctrines and normative principles that capture how discrimination is manifested in algorithmic decision-making.</skos:definition>
        <skos:definition xml:lang="pt">Atua como camada de tradução entre valores éticos abstratos e implementação técnica, especificando os critérios prescritivos que definem um Estado justo. Incorpora doutrinas jurídicas estabelecidas e princípios normativos que capturam como a discriminação se manifesta na tomada de decisões algorítmicas.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#Occupation -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#Occupation">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isProxyFor"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#EconomicalStatus_i"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isProxyFor"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#EducationalLevel_i"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isProxyFor"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Gender_i"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">International Labour Organization (ILO), International Standard Classification of Occupations (ISCO-08), 2008. https://ilostat.ilo.org/methods/concepts-and-definitions/classification-occupation/</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Occupation</rdfs:label>
        <skos:altLabel xml:lang="pt">Ocupação</skos:altLabel>
        <skos:definition xml:lang="en">An attribute that refers to the kind of work performed by an individual.</skos:definition>
        <skos:definition xml:lang="pt">Um atributo que se refere ao tipo de trabalho realizado por um indivíduo.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#Ordinal -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#Ordinal">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#Categorical"/>
        <rdfs:isDefinedBy xml:lang="en">Statistics ontology (STATO)</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Ordinal</rdfs:label>
        <skos:altLabel xml:lang="pt">Ordinal</skos:altLabel>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000228"/>
        <skos:definition xml:lang="en">A categorical data type whose values are ordered or ranked, but where the differences between categories are not necessarily measurable or equal.</skos:definition>
        <skos:definition xml:lang="pt">Tipo de dado categórico cujos valores são ordenados ou classificados, mas onde as diferenças entre categorias não são necessariamente mensuráveis ou iguais.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#PathSpecificCounterfactualFairness -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#PathSpecificCounterfactualFairness">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasEthicalDimension"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#ProceduralJustice_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasEvaluationLocus"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Extrinsic_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasMethodologicalApproach"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Causal_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasNormativePrinciple"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#DisparateTreatment_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasSocioTechnicalScope"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Individual_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isSpecialCaseOf"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#CounterfactualFairness_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#satisfiesCriterion"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Invariance_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">S. Chiappa, ‘‘Path-specific counterfactual fairness,’’ in AAAI Conf. on Art. Int., vol. 33, pp. 7801–7808, 2019.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">PathSpecificCounterfactualFairness</rdfs:label>
        <skos:altLabel xml:lang="pt">Contrafactual Específico de Caminho</skos:altLabel>
        <skos:altLabel xml:lang="en">Path-specific CF</skos:altLabel>
        <skos:definition xml:lang="pt">Refinamento de Counterfactual Fairness permitindo influência apenas por caminhos causais admissíveis.</skos:definition>
        <skos:definition xml:lang="en">Refinement of Counterfactual Fairness allowing the protected attribute to influence predictions only through predefined admissible causal paths, requiring invariance under interventions along all disallowed paths while permitting effects through justified paths.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#PerformanceBound -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#PerformanceBound">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#LossBased"/>
        <probabilistic_definition xml:lang="en">E[L | A=a] ≤ ζ, ∀a</probabilistic_definition>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Bias-Discovery and Mitigation Solutions</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">PerformanceBound</rdfs:label>
        <skos:altLabel xml:lang="pt">Limite de Desempenho</skos:altLabel>
        <skos:definition xml:lang="pt">Critério baseado em perda que relaxa paridade estrita em uma garantia mínima de serviço.</skos:definition>
        <skos:definition xml:lang="en">Loss-based criteria that relaxes strict parity into a minimum-service guarantee.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#PerformanceOriented -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#PerformanceOriented">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasEthicalDimension"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#DistributiveJustice_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasEvaluationLocus"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Extrinsic_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasMethodologicalApproach"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Statistical_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasNormativePrinciple"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#DisparateMistreatment_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasSocioTechnicalScope"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Group_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#satisfiesCriterion"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#LossBased_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Bias-Discovery and Mitigation Solutions</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">PerformanceOriented</rdfs:label>
        <skos:altLabel xml:lang="pt">Orientado ao Desempenho</skos:altLabel>
        <skos:definition xml:lang="en">Fairness notions requiring predictive performance to be equitable across protected groups.</skos:definition>
        <skos:definition xml:lang="pt">Noções de fairness que requerem desempenho preditivo equitativo entre grupos protegidos.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#PerformanceParity -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#PerformanceParity">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#LossBased"/>
        <probabilistic_definition xml:lang="en">⊮(R=Y) ⊥ A</probabilistic_definition>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Bias-Discovery and Mitigation Solutions</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">PerformanceParity</rdfs:label>
        <skos:altLabel xml:lang="pt">Paridade de Desempenho</skos:altLabel>
        <skos:definition xml:lang="pt">Critério baseado em perda que requer sucesso preditivo geral invariante entre grupos.</skos:definition>
        <skos:definition xml:lang="en">Loss-based criteria that requires overall predictive success to be invariant across groups.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#PersonalData -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#PersonalData">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#Data"/>
        <rdfs:isDefinedBy xml:lang="en">Gereral data protection regulation (GDPR) - Art. 4. https://gdpr.eu/article-4-definitions/</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">PersonalData</rdfs:label>
        <skos:altLabel xml:lang="pt">Dado Pessoal</skos:altLabel>
        <skos:definition xml:lang="en">Any information relating to an identified or identifiable natural person.</skos:definition>
        <skos:definition xml:lang="pt">Qualquer informação relativa a uma pessoa natural identificada ou identificável.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#PoliticalAffiliation -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#PoliticalAffiliation">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isClassifiedAs"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#SensitivePersonalData_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">adapted from: General Data Protection Regulation, recital 56. Avaliable: https://gdpr.eu/recital-56-processing-personal-data-on-peoples-political-opinions-by-parties/</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">PoliticalAffiliation</rdfs:label>
        <skos:altLabel xml:lang="pt">Filiação Política</skos:altLabel>
        <skos:definition xml:lang="en">A sensitive attribute referring to an individual&apos;s identification with, or support for, a particular political party, ideology, or movement</skos:definition>
        <skos:definition xml:lang="pt">Um atributo sensível que se refere à identificação de um indivíduo com, ou ao apoio a, um determinado partido político, ideologia ou movimento.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#PostProcessing -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#PostProcessing">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#ProcessingPhase"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#mapsToStage"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#ModelDeployment_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#mapsToStage"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#ModelEvaluation_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#mapsToStage"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#ModelPostProcessing_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Where Bias Emerges in Machine Learning</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">PostProcessing</rdfs:label>
        <skos:altLabel xml:lang="pt">Pós-processamento</skos:altLabel>
        <skos:definition xml:lang="pt">Fase de processamento do ciclo de vida do aprendizado de máquina que ocorre após o treinamento do modelo, abrangendo a geração de previsões, o ajuste de saída e as decisões de implantação.</skos:definition>
        <skos:definition xml:lang="en">Processing phase of the ML lifecycle occurring after model training, encompassing prediction generation, output adjustment, and deployment decisions.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#PostProcessingBias -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#PostProcessingBias">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#BiasSource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#originatesIn"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#ModelPostProcessing_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#originatesInPhase"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#PostProcessing_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Where Bias Emerges in Machine Learning</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">PostProcessingBias</rdfs:label>
        <skos:altLabel xml:lang="pt">Viés de pós-processamento</skos:altLabel>
        <skos:definition xml:lang="en">Occurs when steps taken to prepare the model output for deployment, such as setting decision thresholds, introduce bias.</skos:definition>
        <skos:definition xml:lang="pt">Ocorre quando etapas tomadas para preparar a saída do modelo para implantação, como definir limiares de decisão, introduzem viés.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#PreProcessing -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#PreProcessing">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#ProcessingPhase"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#mapsToStage"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#DataCollection_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#mapsToStage"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#DataPreparation_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Where Bias Emerges in Machine Learning</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">PreProcessing</rdfs:label>
        <skos:altLabel xml:lang="pt">Pré-processamento</skos:altLabel>
        <skos:definition xml:lang="pt">Fase de processamento do ciclo de vida do aprendizado de máquina que ocorre antes do treinamento do modelo, abrangendo todas as atividades relacionadas à coleta, preparação e transformação de dados.</skos:definition>
        <skos:definition xml:lang="en">Processing phase of the ML lifecycle occurring before model training, encompassing all activities related to data collection, preparation, and transformation.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#PreProcessingBias -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#PreProcessingBias">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#BiasSource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#originatesIn"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#DataPreparation_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#originatesInPhase"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#PreProcessing_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Sorelle A. Friedler, Carlos Scheidegger, Suresh Venkatasubramanian, Sonam Choudhary, Evan P. Hamilton, and Derek Roth. 2019. A comparative study of fairness-enhancing interventions in machine learning. In Proceedings of the Conference on Fairness, Accountability, and Transparency (FAT* &apos;19). Association for Computing Machinery, New York, NY, USA, 329–338. https://doi.org/10.1145/3287560.3287589</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">PreProcessingBias</rdfs:label>
        <skos:altLabel xml:lang="pt">Viés de pré-processamento</skos:altLabel>
        <skos:definition xml:lang="en">Occurs when decisions related to data cleaning, transformation, handling missing values or splitting introduce or amplify bias.</skos:definition>
        <skos:definition xml:lang="pt">Ocorre quando decisões relacionadas à limpeza, transformação, tratamento de valores ausentes ou divisão de dados introduzem ou amplificam o viés.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#PredictiveEquality -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#PredictiveEquality">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasEthicalDimension"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#DistributiveJustice_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasEvaluationLocus"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Extrinsic_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasMethodologicalApproach"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Statistical_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasNormativePrinciple"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#DisparateMistreatment_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasSocioTechnicalScope"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Group_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isSpecialCaseOf"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#EqualizedOdds_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#satisfiesCriterion"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Separation_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">A. Castelnovo, R. Crupi, G. Greco, D. Regoli, I. G. Penco, and A. C. Cosentini, ‘‘A clarification of the nuances in the fairness metrics landscape,’’ Scientific Reports, vol. 12, no. 1, p. 4209, 2022.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">PredictiveEquality</rdfs:label>
        <skos:altLabel xml:lang="en">Balance on Negative Class</skos:altLabel>
        <skos:altLabel xml:lang="pt">Igualdade Preditiva</skos:altLabel>
        <skos:definition xml:lang="pt">Noção de Separação unilateral aplicada à classe negativa requerendo paridade de FPR entre grupos.</skos:definition>
        <skos:definition xml:lang="en">One-sided Separation notion applied to the negative class requiring FPR parity across groups.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#PredictiveParity -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#PredictiveParity">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#belongsToFamily"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#CalibrationRate_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasCausalAnalogue"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#CounterfactualFairness_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasEthicalDimension"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#DistributiveJustice_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasEvaluationLocus"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Extrinsic_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasMethodologicalApproach"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Causal_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasMethodologicalApproach"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Statistical_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasNormativePrinciple"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#DisparateImpact_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasSocioTechnicalScope"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Group_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isSpecialCaseOf"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Calibration_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Causal formulation by &quot;S. Corbett-Davies, J. D. Gaebler, H. Nilforoshan, R. Shroff, and S. Goel,‘‘The measure and mismeasure of fairness,’’ Journal of Machine Learning
Research, vol. 24, no. 312, pp. 1–117, 2023.&quot;</rdfs:comment>
        <rdfs:isDefinedBy xml:lang="en">A. Castelnovo, R. Crupi, G. Greco, D. Regoli, I. G. Penco, and A. C. Cosentini, ‘‘A clarification of the nuances in the fairness metrics landscape,’’ Scientific Reports, vol. 12, no. 1, p. 4209, 2022.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">PredictiveParity</rdfs:label>
        <skos:altLabel xml:lang="en">Equal PPV</skos:altLabel>
        <skos:altLabel xml:lang="pt">Paridade Preditiva</skos:altLabel>
        <skos:definition xml:lang="pt">Instanciação unilateral baseada em rótulos de Suficiência requerendo PPV igual entre grupos.</skos:definition>
        <skos:definition xml:lang="en">One-sided, label-based instantiation of Sufficiency requiring equal Positive Predictive Value (PPV) across groups.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#PregnancyAndMaternity -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#PregnancyAndMaternity">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isClassifiedAs"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#ProtectedCharacteristic_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Equality and Human Rights Commission (EHRC). &quot;Protected characteristics.&quot; Equality Act 2010. Avaliable: https://www.equalityhumanrights.com/equality/equality-act-2010/protected-characteristics#pregnancy-and-maternity</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">PregnancyAndMaternity</rdfs:label>
        <skos:altLabel xml:lang="pt">Gravidez e Maternidade</skos:altLabel>
        <skos:definition xml:lang="en">An attribute representing the condition of being pregnant or having recently given birth.</skos:definition>
        <skos:definition xml:lang="pt">Um atributo representando a condição de estar grávida ou ter dado à luz recentemente.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#ProceduralJustice -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#ProceduralJustice">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#EthicalDimension"/>
        <rdfs:isDefinedBy xml:lang="en">J. Thibaut, ‘‘Procedural justice: A psychological analysis,’’ Lawrance Erlbaum Associates, 1975.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">ProceduralJustice</rdfs:label>
        <skos:altLabel xml:lang="pt">Justiça Procedimental</skos:altLabel>
        <skos:definition xml:lang="pt">Dimensão ética que se preocupa com a justiça dos processos e procedimentos de tomada de decisão.</skos:definition>
        <skos:definition xml:lang="en">Ethical orientation where fairness is conceptualized as the equity of the decision-making process itself, focusing on whether decisions are generated through consistent treatment of similar individuals, without unjustified use of sensitive attributes or structural biases in the modeling pipeline.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#ProcessingPhase -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#ProcessingPhase">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasOrder"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Where Bias Emerges in Machine Learning</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">ProcessingPhase</rdfs:label>
        <skos:altLabel xml:lang="pt">Fase de Processamento</skos:altLabel>
        <skos:definition xml:lang="pt">Estágios do ciclo de vida do ML que caracterizam quando uma intervenção ou análise ocorre em relação ao treino.</skos:definition>
        <skos:definition xml:lang="en">Phases of the machine learning lifecycle that characterize when an intervention or analysis occurs relative to model training.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#ProtectedCharacteristic -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#ProtectedCharacteristic">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#Data"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#classifies"/>
                <owl:someValuesFrom rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#protectedBy"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.usp.br/fmlo#LegalFramework"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Equality Act 2010 (UK). https://www.legislation.gov.uk/ukpga/2010/15/part/2</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">ProtectedCharacteristic</rdfs:label>
        <skos:altLabel xml:lang="pt">Característica Protegida</skos:altLabel>
        <skos:definition xml:lang="pt">Características de indivíduos legalmente reconhecidas como base para proteção contra discriminação.</skos:definition>
        <skos:definition xml:lang="en">Characteristics of individuals that are legally recognized as grounds for protection against discrimination.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#PseudoAnonymousData -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#PseudoAnonymousData">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#PersonalData"/>
        <rdfs:isDefinedBy xml:lang="en">Gereral data protection regulation (GDPR) - Art. 4. https://gdpr.eu/article-4-definitions/</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">PseudoAnonymousData</rdfs:label>
        <skos:altLabel xml:lang="pt">Dado Pseudo-anônimo</skos:altLabel>
        <skos:definition xml:lang="pt">Dado pessoal que não pode mais ser atribuído a um titular de dados específico sem o uso de informações adicionais.</skos:definition>
        <skos:definition xml:lang="en">Personal data that can no longer be attributed to a specific data subject without the use of additional information.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#Race -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#Race">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isClassifiedAs"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#ProtectedCharacteristic_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isClassifiedAs"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#SensitivePersonalData_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Edwards, C. L., Fillingim, R. B., &amp; Keefe, F. (2001). Race, ethnicity and pain. Pain, 94(2), 133-137.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Race</rdfs:label>
        <skos:altLabel xml:lang="pt">Raça</skos:altLabel>
        <skos:definition xml:lang="en">An attribute that classifies individuals primarily on the basis of physical characteristics.</skos:definition>
        <skos:definition xml:lang="pt">Um atributo que classifica indivíduos principalmente com base em características físicas.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#RatioBased -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#RatioBased">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#MetricOperationalization"/>
        <rdfs:isDefinedBy xml:lang="en">Statistics ontology (STATO) .</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">RatioBased</rdfs:label>
        <skos:altLabel xml:lang="pt">Baseado em Razão</skos:altLabel>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/STATO_0000613"/>
        <skos:definition xml:lang="pt">Operacionalização que quantifica fairness como a razão entre estatísticas condicionais de grupo.</skos:definition>
        <skos:definition xml:lang="en">Operationalization that quantifies fairness as the ratio between group-conditional statistics.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#Relational -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#Relational">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#FairnessCriterion"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#criterionBelongsToApproach"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Statistical_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <probabilistic_definition>E[S(Z,C) | A=a] ≈ E[S(Z,C) | A=b]</probabilistic_definition>
        <rdfs:isDefinedBy xml:lang="en">A. Caliskan, J. J. Bryson, and A. Narayanan, ‘‘Semantics derived automatically from language corpora contain human-like biases,’’ Sci., vol. 356, no. 6334, pp. 183–186, 2017.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Relational</rdfs:label>
        <skos:altLabel xml:lang="pt">Relacional</skos:altLabel>
        <skos:definition xml:lang="en">Criterion that captures whether embeddings encode group-dependent stereotypical structure through systematic differences in semantic proximity patterns, requiring invariant expected association strength across groups</skos:definition>
        <skos:definition xml:lang="pt">Critério de fairness baseado em relações entre indivíduos.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#Religion -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#Religion">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isClassifiedAs"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#ProtectedCharacteristic_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isClassifiedAs"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#SensitivePersonalData_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isProxyFor"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Ethnicity_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Equality and Human Rights Commission (EHRC). &quot;Protected characteristics.&quot; Equality Act 2010. Avaliable: https://www.equalityhumanrights.com/equality/equality-act-2010/protected-characteristics#religion</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Religion</rdfs:label>
        <skos:altLabel xml:lang="pt">Religião</skos:altLabel>
        <skos:definition xml:lang="en">A sensitive attribute referring to an individuals religious beliefs or affiliation.</skos:definition>
        <skos:definition xml:lang="pt">Um atributo sensível referente às crenças religiosas ou afiliação de um indivíduo.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#RepresentationBased -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#RepresentationBased">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#StatisticalFamily"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasCriterion"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Distributional_i"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasCriterion"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Relational_i"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isFamilyOf"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Intrinsic_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">I. Dominguez-Catena, D. Paternain, and M. Galar, ‘‘Metrics for dataset demographic bias: A case study on facial expression recognition,’’ IEEE Transactions on Pattern Analysis and Machine Int., vol. 46, no. 8, pp. 5209–5226, 2024.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">RepresentationBased</rdfs:label>
        <skos:altLabel xml:lang="pt">Baseado em Representação</skos:altLabel>
        <skos:definition xml:lang="pt">Família estatística que avalia fairness diretamente nas representações aprendidas.</skos:definition>
        <skos:definition xml:lang="en">Statistical family that assesses fairness directly within learned representations by evaluating distributional disparities in internal properties of the representation space, such as similarities or distances, aggregated across groups defined by sensitive attributes.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#RepresentationBias -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#RepresentationBias">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#BiasSource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#originatesIn"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#DataCollection_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#originatesInPhase"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#PreProcessing_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Harini Suresh and John Guttag. 2021. A Framework for Understanding Sources of Harm throughout the Machine Learning Life Cycle. In Proceedings of the 1st ACM Conference on Equity and Access in Algorithms, Mechanisms, and Optimization (EAAMO &apos;21). Association for Computing Machinery, New York, NY, USA, Article 17, 1–9. https://doi.org/10.1145/3465416.3483305</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">RepresentationBias</rdfs:label>
        <skos:altLabel xml:lang="pt">Viés de representação</skos:altLabel>
        <skos:definition xml:lang="en">Occurs when the development sample under-represents some part of the population.</skos:definition>
        <skos:definition xml:lang="pt">Ocorre quando a amostra de desenvolvimento sub-representa alguma parte da população.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#RepresentationEquality -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#RepresentationEquality">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#belongsToFamily"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#RepresentationBased_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasEthicalDimension"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#DistributiveJustice_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasEvaluationLocus"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Intrinsic_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasMethodologicalApproach"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Statistical_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasSocioTechnicalScope"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Group_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">I. Dominguez-Catena, D. Paternain, and M. Galar, ‘‘Metrics for dataset demographic bias: A case study on facial expression recognition,’’ IEEE Transactions on Pattern Analysis and Machine Int., vol. 46, no. 8, pp. 5209–5226, 2024.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">RepresentationEquality</rdfs:label>
        <skos:altLabel xml:lang="pt">Disparidade de Representação</skos:altLabel>
        <skos:definition xml:lang="en">Fairness notion concerned with whether data or learned representations encode systematic and socially salient asymmetries between protected groups and semantic concepts, assessed at the representation level independently of downstream tasks.</skos:definition>
        <skos:definition xml:lang="pt">Noção de fairness que avalia se dados ou representações aprendidas codificam vieses estereotípicos ou sub-representação sistemática.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#SemanticAssociation -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#SemanticAssociation">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#RepresentationEquality"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isSpecialCaseOf"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#RepresentationEquality_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#satisfiesCriterion"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Relational_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">A. Caliskan, J. J. Bryson, and A. Narayanan, ‘‘Semantics derived automatically from language corpora contain human-like biases,’’ Sci., vol. 356, no. 6334, pp. 183–186, 2017.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">SemanticAssociation</rdfs:label>
        <skos:altLabel xml:lang="pt">Associação Semântica</skos:altLabel>
        <skos:definition xml:lang="pt">A equidade de representação mede se as representações codificam estruturas estereotipadas dependentes de grupo por meio de diferenças sistemáticas em padrões de proximidade semântica. Operacionalizada pela medição da força esperada da associação relacional entre representações vinculadas a grupos e conjuntos de conceitos avaliativos, exigindo invariância entre os grupos protegidos.</skos:definition>
        <skos:definition xml:lang="en">Representation equality fairness that captures whether embeddings encode group-dependent stereotypical structure through systematic differences in semantic proximity patterns. Operationalized by measuring the expected relational association strength between group-linked embeddings and evaluative concept sets, requiring invariance across protected groups.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#SensitiveAttribute -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#SensitiveAttribute">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasDataType"/>
                <owl:someValuesFrom rdf:resource="http://www.usp.br/fmlo#AttributeDataType"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isAffectedBy"/>
                <owl:someValuesFrom rdf:resource="http://www.usp.br/fmlo#BiasSource"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isAttributeOf"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.usp.br/fmlo#Data"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasImbalance"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasMissingValues"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">BAROCAS, Solon; HARDT, Moritz; NARAYANAN, Arvind. Fairness and machine learning: Limitations and opportunities. MIT press, 2023.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">SensitiveAttribute</rdfs:label>
        <skos:altLabel xml:lang="pt">Atributo sensível</skos:altLabel>
        <skos:definition xml:lang="pt">Atributos sensíveis referem-se a características individuais que, quando usadas em tomada de decisão automatizada, podem levar a resultados enviesados ou inequitativos.</skos:definition>
        <skos:definition xml:lang="en">Sensitive attributes refer to individual characteristics that, when used in automated decision-making, may lead to biased or inequitable outcomes.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#SensitivePersonalData -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#SensitivePersonalData">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#PersonalData"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#containsAttribute"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Ethnicity_i"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#containsAttribute"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#GeneticCharacteristic_i"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#containsAttribute"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#HealthInsurance_i"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#containsAttribute"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#PoliticalAffiliation_i"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#containsAttribute"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Race_i"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#containsAttribute"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Religion_i"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#containsAttribute"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Sex_i"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#containsAttribute"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#SexualOrientation_i"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#classifies"/>
                <owl:someValuesFrom rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#protectedBy"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.usp.br/fmlo#LegalFramework"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Gereral data protection regulation (GDPR) - Recital 51. https://gdpr.eu/recital-51-protecting-sensitive-personal-data/</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">SensitivePersonalData</rdfs:label>
        <skos:altLabel xml:lang="pt">Dado pessoal sensível</skos:altLabel>
        <skos:definition xml:lang="pt">Dados pessoais que, por sua natureza, são particularmente sensíveis em relação a direitos e liberdades fundamentais.</skos:definition>
        <skos:definition xml:lang="en">Personal data which are, by their nature, particularly sensitive in relation to fundamental rights and freedoms.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#Separation -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#Separation">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#FairnessCriterion"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#criterionBelongsToApproach"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Statistical_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <probabilistic_definition>R ⊥ A | Y</probabilistic_definition>
        <rdfs:isDefinedBy xml:lang="en">Barocas, S., Hardt, M., &amp; Narayanan, A. (2019). Fairness and machine learning: Limitations and opportunities. fairmlbook. org.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Separation</rdfs:label>
        <skos:altLabel xml:lang="pt">Separação</skos:altLabel>
        <skos:definition xml:lang="en">Criterion requiring predictions to be independent of the protected attribute conditional on the true label (R ⊥ A | Y), ensuring that error rates are equalized across groups for each outcome class.</skos:definition>
        <skos:definition xml:lang="pt">Critério de fairness que requer independência condicional entre decisão e atributo protegido dado o rótulo verdadeiro.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#Sex -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#Sex">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isClassifiedAs"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#ProtectedCharacteristic_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isClassifiedAs"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#SensitivePersonalData_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Canadian Institutes of Health Research (CIHR). https://cihr-irsc.gc.ca/e/47830.html</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Sex</rdfs:label>
        <skos:altLabel xml:lang="pt">Sexo</skos:altLabel>
        <skos:definition xml:lang="en">An attribute that refers to a set of biological attributes associated with physical and physiological features.</skos:definition>
        <skos:definition xml:lang="pt">Um atributo que se refere a um conjunto de atributos biológicos associados a características físicas e fisiológicas.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#SexualOrientation -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#SexualOrientation">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isClassifiedAs"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#ProtectedCharacteristic_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isClassifiedAs"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#SensitivePersonalData_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Patterson, C., &amp; D&apos;Augelli, A. R. (Eds.). (2013). Handbook of psychology and sexual orientation. Oxford University Press.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">SexualOrientation</rdfs:label>
        <skos:altLabel xml:lang="pt">Orientação Sexual</skos:altLabel>
        <skos:definition xml:lang="en">An attribute that refers to an individual&apos;s pattern of emotional, romantic, or sexual attraction to people of a particular gender, as an aspect of identity</skos:definition>
        <skos:definition xml:lang="pt">Um atributo que se refere ao padrão de atração emocional, romântica ou sexual de um indivíduo por pessoas de um determinado gênero, como um aspecto da identidade.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#Similarity -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#Similarity">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#FairnessCriterion"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#criterionBelongsToApproach"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Geometric_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <probabilistic_definition>d_Y(f(x),f(x&apos;)) ≤ L · d_X(x,x&apos;)</probabilistic_definition>
        <rdfs:isDefinedBy xml:lang="en">C. Dwork, M. Hardt, T. Pitassi, O. Reingold, and R. Zemel, ‘‘Fairness through awareness,’’ in 3rd Innovations in Theoretical Computer Sci. Conf., pp. 214–226, 2012.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Similarity</rdfs:label>
        <skos:altLabel xml:lang="pt">Similaridade</skos:altLabel>
        <skos:definition xml:lang="pt">Critério de fairness baseado em preservação de similaridade entre indivíduos.</skos:definition>
        <skos:definition xml:lang="en">Geometric criterion imposing a smoothness constraint on the decision function via the Lipschitz continuity condition, requiring that similar individuals in input space receive similar outputs in decision space.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#SimilarityBased -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#SimilarityBased">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#MetricOperationalization"/>
        <rdfs:isDefinedBy xml:lang="en">C. Dwork, M. Hardt, T. Pitassi, O. Reingold, and R. Zemel, ‘‘Fairness through awareness,’’ in 3rd Innovations in Theoretical Computer Sci. Conf., pp. 214–226, 2012.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">SimilarityBased</rdfs:label>
        <skos:altLabel xml:lang="pt">Baseado em Similaridade</skos:altLabel>
        <skos:definition xml:lang="pt">Operacionalização que quantifica fairness através da preservação de distância entre indivíduos.</skos:definition>
        <skos:definition xml:lang="en">Operationalization that quantifies fairness through pairwise distance preservation between individuals, measuring distortion of local neighborhoods between input and decision spaces.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#SocioTechnicalScope -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#SocioTechnicalScope">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Bias-Discovery and Mitigation Solutions</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">SocioTechnicalScope</rdfs:label>
        <skos:altLabel xml:lang="pt">Escopo Sociotécnico</skos:altLabel>
        <skos:definition xml:lang="pt">Especifica o escopo social no qual uma noção de fairness opera.</skos:definition>
        <skos:definition xml:lang="en">Specifies the social scope at which a fairness notion operates, clarifying who is being protected and at what level inequity is evaluated.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#SocioTechnicalSolution -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#SocioTechnicalSolution">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#addressesTask"/>
                <owl:someValuesFrom rdf:resource="http://www.usp.br/fmlo#MLTask"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasDatasetUsed"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasCodeAvailable"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasPublicationYear"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Bias-Discovery and Mitigation Solutions</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">SocioTechnicalSolution</rdfs:label>
        <skos:altLabel xml:lang="pt">Solução Sociotécnica</skos:altLabel>
        <skos:definition xml:lang="pt">Classe raiz representando todas as soluções propostas para medir, descobrir, mitigar ou resolver viés em sistemas de ML.</skos:definition>
        <skos:definition xml:lang="en">Root class representing all solutions proposed to measure, discover, mitigate, or solve bias in ML systems. Termed sociotechnical as fairness in ML inherently involves both social principles and technical components.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#Stability -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#Stability">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#FairnessCriterion"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#criterionBelongsToApproach"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Causal_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <probabilistic_definition xml:lang="en">Pr(Ŷ(A←a)(x) ≠ Ŷ(A←a&apos;)(x)) ≈ 0, ∀a,a&apos;</probabilistic_definition>
        <rdfs:isDefinedBy xml:lang="en">C. Agarwal, H. Lakkaraju, and M. Zitnik, ‘‘Towards a unified framework for fair and stable graph representation learning,’’ in Uncertainty in artificial intelligence, pp. 2114–2124, PMLR, 2021.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Stability</rdfs:label>
        <skos:altLabel xml:lang="pt">Estabilidade</skos:altLabel>
        <skos:definition xml:lang="en">Causal criterion operating as a stochastic relaxation of Invariance, quantifying the probability or frequency with which the prediction is altered when the sensitive attribute is perturbed.</skos:definition>
        <skos:definition xml:lang="pt">Critério causal que opera como um relaxamento estocástico da invariância, quantificando a probabilidade ou frequência com que a previsão é alterada quando o atributo sensível é perturbado.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#Statistical -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#Statistical">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#MethodologicalApproach"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#approachHasLocus"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Extrinsic_i"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#approachHasLocus"/>
                        <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Intrinsic_i"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#approachHasCriterion"/>
                <owl:allValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isStatisticalCriterionOf"/>
                        <owl:someValuesFrom rdf:resource="http://www.usp.br/fmlo#StatisticalFamily"/>
                    </owl:Restriction>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">S. Barocas, M. Hardt, and A. Narayanan, Fairness and Machine Learning: Limitations and Opportunities. The MIT Press, 2023.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Statistical</rdfs:label>
        <skos:altLabel xml:lang="pt">Estatístico</skos:altLabel>
        <skos:definition xml:lang="pt">Abordagem metodológica baseada em testes e medidas estatísticas.</skos:definition>
        <skos:definition xml:lang="en">Methodological approach grounded in observable distributions and conditional independence relationships between predictions, outcomes, and sensitive attributes, typically enforcing parity constraints across groups.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#StatisticalFamily -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#StatisticalFamily">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isFamilyOf"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.usp.br/fmlo#EvaluationLocus"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Bias-Discovery and Mitigation Solutions</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">StatisticalFamily</rdfs:label>
        <skos:altLabel xml:lang="pt">Família Estatística</skos:altLabel>
        <skos:definition xml:lang="pt">Específica da abordagem metodológica Estatística, fornece uma decomposição granular das noções de fairness.</skos:definition>
        <skos:definition xml:lang="en">Specific to the Statistical methodological approach that provides a granular decomposition of fairness notions due to the proliferation of existing metrics. Organizes statistical notions into conceptual subtypes based on what they primarily measure.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#StatisticalParity -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#StatisticalParity">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#belongsToFamily"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#BaseRate_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasCausalAnalogue"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#CounterfactualFairness_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasEthicalDimension"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#DistributiveJustice_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasEvaluationLocus"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Extrinsic_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasMethodologicalApproach"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Causal_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasMethodologicalApproach"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Statistical_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasNormativePrinciple"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#DisparateImpact_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasSocioTechnicalScope"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Group_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasTradeOffWith"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#PerformanceOriented_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isIncompatibleWith"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Calibration_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#isIncompatibleWith"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#EqualizedOdds_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#satisfiesCriterion"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Independence_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasAcronym"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Causal formulation by &quot;S. Corbett-Davies, J. D. Gaebler, H. Nilforoshan, R. Shroff, and S. Goel,‘‘The measure and mismeasure of fairness,’’ Journal of Machine Learning
Research, vol. 24, no. 312, pp. 1–117, 2023.&quot;</rdfs:comment>
        <rdfs:isDefinedBy>Calders, T., Kamiran, F., &amp; Pechenizkiy, M. (2009, December). Building classifiers with independency constraints. In 2009 IEEE international conference on data mining workshops (pp. 13-18). IEEE.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">StatisticalParity</rdfs:label>
        <skos:altLabel xml:lang="pt">Paridade Estatística</skos:altLabel>
        <skos:definition xml:lang="en">Fairness notion requiring the probability of receiving a favorable prediction to be invariant with respect to protected group membership</skos:definition>
        <skos:definition xml:lang="pt">Noção de fairness que requer probabilidades iguais de resultado positivo entre grupos.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#StatisticalTestBased -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#StatisticalTestBased">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#MetricOperationalization"/>
        <rdfs:isDefinedBy xml:lang="en">Ontology for Biomedical Investigations</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">StatisticalTestBased</rdfs:label>
        <skos:altLabel xml:lang="pt">Baseado em Teste Estatístico</skos:altLabel>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/OBI_0000673"/>
        <skos:definition xml:lang="pt">Operacionalização que quantifica viés através de teste de hipóteses ou procedimentos baseados em permutação.</skos:definition>
        <skos:definition xml:lang="en">Operationalization that quantifies bias through hypothesis testing or permutation-based procedures.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#StereotypicalAssociation -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#StereotypicalAssociation">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#FairnessNotion"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#belongsToFamily"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#AssociationBased_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasEthicalDimension"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#DistributiveJustice_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasEvaluationLocus"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Intrinsic_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasMethodologicalApproach"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Statistical_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasSocioTechnicalScope"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Group_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#satisfiesCriterion"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Independence_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">I. Dominguez-Catena, D. Paternain, and M. Galar, ‘‘Metrics for dataset demographic bias: A case study on facial expression recognition,’’ IEEE Transactions on Pattern Analysis and Machine Int., vol. 46, no. 8, pp. 5209–5226, 2024.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">StereotypicalAssociation</rdfs:label>
        <skos:altLabel xml:lang="pt">Associação Estereotípica</skos:altLabel>
        <skos:definition xml:lang="en">Fairness notion concerned with systematic statistical dependencies between protected attributes and semantic variables in data.</skos:definition>
        <skos:definition xml:lang="pt">Noção de fairness preocupada com dependências estatísticas sistemáticas entre atributos protegidos e variáveis semânticas.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#StructuralMethodologicalContributions -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#StructuralMethodologicalContributions">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#SocioTechnicalSolution"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#systematizes"/>
                <owl:someValuesFrom rdf:resource="http://www.usp.br/fmlo#BiasSource"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Bias-Discovery and Mitigation Solutions</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">StructuralMethodologicalContributions</rdfs:label>
        <skos:altLabel xml:lang="pt">Contribuições Estruturais e Metodológicas</skos:altLabel>
        <skos:definition xml:lang="en">Solutions that operate at a higher level of abstraction, aiming to organize the field, provide new reasoning frameworks, critique foundational assumptions, or deliver enabling tools for fairness research and practice.</skos:definition>
        <skos:definition xml:lang="pt">Soluções que operam em um nível mais alto de abstração, visando organizar o campo e fornecer frameworks.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#Sufficiency -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#Sufficiency">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#FairnessCriterion"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#criterionBelongsToApproach"/>
                <owl:hasValue rdf:resource="http://www.usp.br/fmlo#Statistical_i"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <probabilistic_definition>Y ⊥ A | R</probabilistic_definition>
        <rdfs:isDefinedBy xml:lang="en">Barocas, S., Hardt, M., &amp; Narayanan, A. (2019). Fairness and machine learning: Limitations and opportunities. fairmlbook. org.</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Sufficiency</rdfs:label>
        <skos:altLabel xml:lang="pt">Suficiência</skos:altLabel>
        <skos:definition xml:lang="en">Criterion requiring the true outcome to be independent of group membership given the prediction (Y ⊥ A | R), ensuring that predicted scores carry the same semantic meaning across groups.</skos:definition>
        <skos:definition xml:lang="pt">Critério de fairness que requer que o resultado verdadeiro seja independente do atributo protegido dado a predição.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#Taxonomy -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#Taxonomy">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#StructuralMethodologicalContributions"/>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Bias-Discovery and Mitigation Solutions</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Taxonomy</rdfs:label>
        <skos:altLabel xml:lang="pt">Taxonomia</skos:altLabel>
        <skos:definition xml:lang="pt">Contribuições estruturais que organizam a literatura fragmentada de fairness em dimensões estruturadas.</skos:definition>
        <skos:definition xml:lang="en">Structural contributions that organize the fragmented fairness literature into structured dimensions, offering shared vocabularies and reference maps for comparison and synthesis.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#TechnicalArea -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#TechnicalArea">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.usp.br/fmlo#hasTask"/>
                <owl:someValuesFrom rdf:resource="http://www.usp.br/fmlo#MLTask"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Bias-Discovery and Mitigation Solutions</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">TechnicalArea</rdfs:label>
        <skos:altLabel xml:lang="pt">Área técnica</skos:altLabel>
        <skos:definition xml:lang="en">A broad field of artificial intelligence research that encompasses multiple related tasks and methodologies.</skos:definition>
        <skos:definition xml:lang="pt">Um campo amplo de pesquisa em inteligência artificial que abrange múltiplas tarefas e metodologias relacionadas.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#Toolkit -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#Toolkit">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#StructuralMethodologicalContributions"/>
        <rdfs:isDefinedBy xml:lang="en">Fairness at Risk: Bias-Discovery and Mitigation Solutions</rdfs:isDefinedBy>
        <rdfs:label xml:lang="en">Toolkit</rdfs:label>
        <skos:altLabel xml:lang="pt">Ferramentário</skos:altLabel>
        <skos:definition xml:lang="pt">Contribuições estruturais que traduzem avanços conceituais em bibliotecas de software e benchmarks.</skos:definition>
        <skos:definition xml:lang="en">Structural contributions that translate conceptual advances into software libraries, benchmarks, and evaluation suites for standardized and reproducible fairness research.</skos:definition>
    </owl:Class>
    


    <!-- http://www.usp.br/fmlo#VeteranStatus -->

    <owl:Class rdf:about="http://www.usp.br/fmlo#VeteranStatus">
        <rdfs:subClassOf rdf:resource="http://www.usp.br/fmlo#SensitiveAttribute"/>
